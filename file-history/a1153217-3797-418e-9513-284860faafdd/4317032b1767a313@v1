function getNavigatorInfo(): {
  hardwareConcurrency: number;
  deviceMemory?: number;
} {
  if (typeof navigator === "undefined") {
    return { hardwareConcurrency: 8 };
  }
  const nav = navigator as Navigator & { deviceMemory?: number };
  return {
    hardwareConcurrency: nav.hardwareConcurrency ?? 8,
    deviceMemory: nav.deviceMemory,
  };
}

function prefersReducedMotion(): boolean {
  if (
    typeof window === "undefined" ||
    typeof window.matchMedia !== "function"
  ) {
    return false;
  }
  return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
}

function getViewportInfo(): {
  width: number;
  height: number;
  dpr: number;
  isCompact: boolean;
} {
  if (typeof window === "undefined") {
    return { width: 1440, height: 900, dpr: 1, isCompact: false };
  }
  const width = window.innerWidth ?? 1440;
  const height = window.innerHeight ?? 900;
  return {
    width,
    height,
    dpr: window.devicePixelRatio ?? 1,
    isCompact: width <= 1024 || height <= 768,
  };
}

function resolveTierFromEnvironment(
  environment: ResponsiveEnvironmentInput,
): PerformanceTier {
  const nav = {
    hardwareConcurrency: environment.hardwareConcurrency,
    deviceMemory: environment.deviceMemory,
  };
  const view = {
    width: environment.viewportWidth,
    height: environment.viewportHeight,
    dpr: environment.devicePixelRatio,
    isCompact:
      environment.viewportWidth <= 1024 || environment.viewportHeight <= 768,
  };
  const reducedMotion = environment.reducedMotion;

  let score = 0;

  if (reducedMotion) score += 4;
  if (nav.hardwareConcurrency <= 4) score += 2;
  else if (nav.hardwareConcurrency <= 6) score += 1;

  const memory = nav.deviceMemory;
  if (typeof memory === "number" && memory <= 4) score += 2;
  else if (typeof memory === "number" && memory <= 8) score += 1;

  if (view.isCompact) score += 1;
  if (view.dpr >= 2.5) score += 1;

  if (score >= 5) return "low";
  if (score >= 2) return "mid";
  return "high";
}

function getDefaultEnvironment(): ResponsiveEnvironmentInput {
  const nav = getNavigatorInfo();
  const view = getViewportInfo();
  return {
    viewportWidth: view.width,
    viewportHeight: view.height,
    devicePixelRatio: view.dpr,
    isMobile: view.width <= 1024,
    reducedMotion: prefersReducedMotion(),
    hardwareConcurrency: nav.hardwareConcurrency,
    deviceMemory: nav.deviceMemory,
  };
}

export class PerformanceProfile {
  static getMainProfile(
    environment?: ResponsiveEnvironmentInput,
  ): MainPerformanceProfile {
    const tier = resolveTierFromEnvironment(
      environment ?? getDefaultEnvironment(),
    );
    const profile =
      tier === "low"
        ? LOW_PROFILE
        : tier === "mid"
          ? MID_PROFILE
          : HIGH_PROFILE;

    return {
      ...profile,
      bloom: { ...profile.bloom },
    };
  }
}
