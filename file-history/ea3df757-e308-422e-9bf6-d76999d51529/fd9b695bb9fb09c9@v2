// Masking text reveal — attribute-based state machine.
// State lives on `data-reveal` (masking-text) and `data-mask` (mask-target wrapper),
// never on classes, so content-layer class usage cannot accidentally drive animation.
export const MASKING = {
  enabled: true,
  selector: ".masking-text",
  lineClass: "line",
  wrapTargetClass: "mask-target",
  revealAttr: "data-reveal",
  maskAttr: "data-mask",
  revealDatasetKey: "reveal",
  maskDatasetKey: "mask",
  revealState: {
    inview: "inview",
    down: "down",
    hidden: "hidden",
  },
  maskState: {
    ready: "ready",
  },
} as const;

// Block-level generic hidden state — NOT part of masking-text reveal.
// Used by BlockReveal, AppManager, ContactWizard for visibility toggles on
// non-masking elements. Kept class-based because the same token is shared by
// generic UI (works-canvas grid/canvas, intro overlay) and migrating it would
// ripple across unrelated features.
export const BLOCK_HIDDEN_CLASS = "is-hidden";

export const STATE_CLASSES = {
  open: "is-open",
  barbaLeaving: "is-barba-leaving",
  animatingIn: "is-animating-in",
} as const;

