@use "../abstract" as *;

// =============================================================================
// Masking text — base structure only.
// State transitions (data-reveal, data-mask) live in state/_reveal-state.scss
// so TS-driven dynamic state is isolated in a dedicated cascade layer.
// =============================================================================

@mixin text-reveal-line-hidden {
  transform: translate3d(0, var(--text-reveal-offset-y), 0);
  opacity: 0;
  filter: blur(var(--text-reveal-blur));
}

@mixin text-reveal-line-visible {
  transform: translate3d(0, 0, 0);
  opacity: 1;
  filter: blur(0);
}

@mixin text-reveal-line-down {
  transform: translate3d(0, var(--text-reveal-down-offset-y), 0);
  opacity: 0;
  filter: blur(var(--text-reveal-down-blur));
}

// Base: mask-target is hidden until TS sets data-mask="ready".
.mask-target {
  opacity: 0;
  visibility: hidden;
}

// Global opt-out on <html> — pins everything to the hidden state, no transitions.
.is-text-reveal-disabled {
  .mask-target {
    opacity: 0;
    visibility: hidden;
  }

  .masking-text {
    opacity: 0;
    visibility: hidden;

    .masking-text__line,
    .line {
      @include text-reveal-line-hidden();
      transition: none;
    }
  }
}

.masking-text {
  display: block;
  overflow: hidden;
  opacity: 1;
  visibility: visible;
  transition:
    opacity var(--transition-base),
    visibility var(--transition-base);

  .masking-text__line,
  .line {
    display: block;
    position: relative;
    text-align: start;
    @include text-reveal-line-hidden();
    transition:
      transform var(--transition-slow),
      opacity var(--transition-slow),
      filter var(--transition-slow);
    will-change: transform, opacity, filter;
  }
}

// Multi-line stagger — structural, not state-specific.

.masking-text + .masking-text {
  .masking-text__line,
  .line {
    transition-delay: var(--duration-stagger);
  }
}

.masking-text + .masking-text + .masking-text {
  .masking-text__line,
  .line {
    transition-delay: calc(var(--duration-stagger) * 2);
  }
}

.masking-text + .masking-text + .masking-text + .masking-text {
  .masking-text__line,
  .line {
    transition-delay: calc(var(--duration-stagger) * 3);
  }
}

.masking-text + .masking-text + .masking-text + .masking-text + .masking-text {
  .masking-text__line,
  .line {
    transition-delay: calc(var(--duration-stagger) * 4);
  }
}
