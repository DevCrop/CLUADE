import { CONTACT_WIZARD } from "../config/component.config.js";
import {
  CONTACT_THEATRE_SUCCESS_DEFAULT_MESSAGE,
  CONTACT_THEATRE_SUCCESS_FLOW_REQUEST_EVENT,
} from "../pages/contact/theatre/ContactTheatreConfig.js";
import { BlockReveal } from "../animation/BlockReveal.js";
import { INIT_DOM_CLASSES, MASKING } from "../config/dom.config.js";
import { Debounce } from "../utils/Debounce.js";
import { Logger } from "../utils/Logger.js";
import type {
  ContactWizardChipData,
  ContactWizardInitOptions,
} from "../types/component.types.js";
import type {
  ContactSubmitResponse,
  ContactSuccessFlowRequestDetail,
} from "../types/contact.types.js";

export class ContactWizard {
  private static readonly _CLASS = "ContactWizard";
  private readonly _root: HTMLElement;
  private readonly _form: HTMLFormElement | null;
  private readonly _viewport: HTMLElement | null;
  private readonly _steps: HTMLElement[];
  private readonly _overviewList: HTMLOListElement | null;
  private readonly _prevButtons: HTMLButtonElement[];
  private readonly _primaryActionButtons: HTMLButtonElement[];
  private readonly _projectOtherToggle: HTMLInputElement | null;
  private readonly _projectOtherPanel: HTMLElement | null;
  private readonly _projectOtherInput: HTMLInputElement | null;
  private readonly _sidebarSyncDebounce: Debounce;
  private readonly _chipLeaveTimers = new WeakMap<HTMLElement, number>();
  private readonly _chipMoveAnimations = new WeakMap<HTMLElement, Animation>();
  private readonly _previousActionHideTimers = new WeakMap<HTMLElement, number>();
  private readonly _activeTimers = new Set<number>();
  private readonly _activeAnimations = new Set<Animation>();
  private readonly _onClickBound: (event: Event) => void;
  private readonly _onChangeBound: () => void;
  private readonly _onInputBound: (event: Event) => void;
  private readonly _onSubmitBound: (event: Event) => void;
  private readonly _onFormKeydownBound: (event: KeyboardEvent) => void;
  private _mounted = false;
  private _disposed = false;
  private _navItems: HTMLElement[] = [];
  private _stepValues: HTMLElement[] = [];
  private _current = 0;
  private _busy = false;
  private _submitting = false;
  private _lastOverviewScrollIndex = -1;

  private static _instances = new Set<ContactWizard>();

  static init(options: ContactWizardInitOptions = {}): void {
    const scope = options.root ?? document;
    scope
      .querySelectorAll<HTMLElement>(CONTACT_WIZARD.selector)
      .forEach((element) => {
        const instance = new ContactWizard(element);
        ContactWizard._instances.add(instance);
        instance.mount();
      });
  }

  static dispose(): void {
    ContactWizard._instances.forEach((instance) => instance.dispose());
    ContactWizard._instances.clear();
  }

  constructor(root: HTMLElement) {
    this._root = root;
    this._form = root.closest("form");
    this._viewport = root.querySelector<HTMLElement>("[data-wizard-viewport]");
    this._steps = Array.from(
      root.querySelectorAll<HTMLElement>("[data-wizard-step]"),
    );
    this._overviewList = root.querySelector<HTMLOListElement>(
      "[data-wizard-overview-list]",
    );
    this._prevButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-wizard-prev]"),
    );
    this._primaryActionButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-wizard-primary-action]"),
    );
    this._projectOtherToggle = root.querySelector<HTMLInputElement>(
      "[data-project-other-toggle]",
    );
    this._projectOtherPanel = root.querySelector<HTMLElement>(
      "[data-project-other-panel]",
    );
    this._projectOtherInput = root.querySelector<HTMLInputElement>(
      "[data-project-other-input]",
    );
    this._sidebarSyncDebounce = new Debounce(
      CONTACT_WIZARD.summaryInputDebounceMs,
    );
    this._onClickBound = (event) => this._onClick(event as MouseEvent);
    this._onChangeBound = () => {
      this._sidebarSyncDebounce.offCancel();
      this._syncProjectOtherField();
      this._syncSidebar();
    };
    this._onInputBound = (event) => {
      this._syncProjectOtherField();
      if (this._shouldDebounceSidebarSync(event.target)) {
        this._sidebarSyncDebounce.runDebounce(() => this._syncSidebar());
        return;
      }
      this._syncSidebar();
    };
    this._onSubmitBound = (event) => this._onSubmit(event as SubmitEvent);
    this._onFormKeydownBound = (event) => this._onFormKeydown(event);
  }

  dispose(): void {
    if (this._disposed) return;
    this._disposed = true;
    if (this._mounted) {
      this._root.removeEventListener("click", this._onClickBound);
      this._root.removeEventListener("change", this._onChangeBound);
      this._root.removeEventListener("input", this._onInputBound);
      this._form?.removeEventListener("submit", this._onSubmitBound);
      this._form?.removeEventListener("keydown", this._onFormKeydownBound, true);
      this._mounted = false;
    }
    this._sidebarSyncDebounce.offCancel();
    this._activeTimers.forEach((id) => window.clearTimeout(id));
    this._activeTimers.clear();
    this._activeAnimations.forEach((animation) => animation.cancel());
    this._activeAnimations.clear();
    ContactWizard._instances.delete(this);
  }

  private _trackedTimeout(callback: () => void, delay: number): number {
    const id = window.setTimeout(() => {
      this._activeTimers.delete(id);
      if (this._disposed) return;
      callback();
    }, delay);
    this._activeTimers.add(id);
    return id;
  }

  private _trackAnimation(animation: Animation): Animation {
    this._activeAnimations.add(animation);
    const cleanup = () => this._activeAnimations.delete(animation);
    animation.addEventListener("finish", cleanup, { once: true });
    animation.addEventListener("cancel", cleanup, { once: true });
    return animation;
  }

  private mount(): void {
    if (!this._viewport || this._steps.length === 0) return;

    const totalElement =
      this._root.querySelector<HTMLElement>("[data-wizard-total]");
    if (totalElement) {
      totalElement.textContent = String(this._steps.length).padStart(2, "0");
    }

    this._renderOverview();
    this._root.addEventListener("click", this._onClickBound);
    this._root.addEventListener("change", this._onChangeBound);
    this._root.addEventListener("input", this._onInputBound);
    this._form?.addEventListener("submit", this._onSubmitBound);
    this._form?.addEventListener("keydown", this._onFormKeydownBound, true);
    this._mounted = true;

    this._steps.forEach((step, index) => {
      step.classList.toggle("is-active", index === 0);
      step.classList.remove("is-prev");
    });

    this._syncIndicator(true);
    this._syncProjectOtherField();
    this._syncSidebar();
  }

  private _renderOverview(): void {
    if (!this._overviewList) return;

    const fragment = document.createDocumentFragment();
    this._steps.forEach((step, index) => {
      const item = document.createElement("li");
      item.className = "no-wizard-overview__item";
      item.dataset.wizardNavItem = "";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "no-wizard-overview__button";
      button.dataset.wizardJump = String(index);

      const corner = this._createOverviewCorner();

      const head = document.createElement("span");
      head.className = "no-wizard-overview__head";

      const rect = this._createOverviewRect();

      const indexNode = document.createElement("span");
      indexNode.className = "no-wizard-overview__index f-body-3 --regular";
      indexNode.textContent = this._resolveNavLabel(index);

      const body = document.createElement("span");
      body.className = "no-wizard-overview__body";

      const value = document.createElement("span");
      value.className = "no-wizard-overview__value f-body-3 --regular";
      value.dataset.wizardStepValue = String(index);

      head.append(rect, indexNode);
      body.append(value);
      button.append(corner, head, body);
      item.append(button);
      fragment.append(item);
    });

    this._overviewList.replaceChildren(fragment);
    this._navItems = Array.from(
      this._root.querySelectorAll<HTMLElement>("[data-wizard-nav-item]"),
    );
    this._stepValues = Array.from(
      this._root.querySelectorAll<HTMLElement>("[data-wizard-step-value]"),
    );
  }

  private _onClick(event: Event): void {
    if (this._submitting) return;
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const jumpButton = target.closest<HTMLElement>("[data-wizard-jump]");
    if (jumpButton) {
      event.preventDefault();
      const nextIndex = Number(jumpButton.dataset.wizardJump);
      if (Number.isNaN(nextIndex) || nextIndex > this._resolveFurthestAccessibleStep()) return;
      this._jump(nextIndex);
      return;
    }

    if (target.closest("[data-wizard-next]")) {
      event.preventDefault();
      this._next();
      return;
    }

    if (target.closest("[data-wizard-prev]")) {
      event.preventDefault();
      this._prev();
    }
  }

  private _onSubmit(event: Event): void {
    if (this._submitting) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }
    if (!this._isSubmitAllowed()) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }

    const currentStep = this._steps[this._current];
    if (!currentStep) return;
    if (!this._triggerValidationAndCheck(currentStep)) {
      event.preventDefault();
      event.stopPropagation();
      return;
    }

    event.preventDefault();
    event.stopPropagation();
    void this._submit();
  }

  private _onFormKeydown(event: KeyboardEvent): void {
    if (this._submitting) {
      event.preventDefault();
      return;
    }
    if (event.key !== "Enter") return;
    if (this._isSubmitAllowed()) return;

    const target = event.target;
    if (target instanceof HTMLTextAreaElement) return;
    if (target instanceof HTMLButtonElement) return;

    event.preventDefault();
  }

  private _next(): void {
    if (this._busy || this._submitting || this._current >= this._steps.length - 1) return;
    const currentStep = this._steps[this._current];
    if (!currentStep) return;
    if (!this._triggerValidationAndCheck(currentStep)) return;
    this._go(this._current + 1, "next");
  }

  private _prev(): void {
    if (this._busy || this._submitting || this._current <= 0) return;
    this._go(this._current - 1, "prev");
  }

  private _jump(nextIndex: number): void {
    if (this._busy || this._submitting) return;
    if (nextIndex < 0 || nextIndex >= this._steps.length) return;
    if (nextIndex === this._current) return;
    this._go(nextIndex, nextIndex > this._current ? "next" : "prev");
  }

  private _go(nextIndex: number, direction: string): void {
    const currentStep = this._steps[this._current];
    const nextStep = this._steps[nextIndex];
    if (!currentStep || !nextStep) return;

    this._busy = true;

    requestAnimationFrame(() => {
      currentStep.classList.remove("is-active");
      currentStep.classList.toggle("is-prev", direction === "next");

      requestAnimationFrame(() => {
        nextStep.classList.remove("is-prev");
        nextStep.classList.add("is-active");
        nextStep.scrollTop = 0;

        this._current = nextIndex;
        this._syncIndicator();
        this._syncSidebar();

        this._trackedTimeout(() => {
          currentStep.classList.remove("is-prev");
          this._busy = false;
        }, CONTACT_WIZARD.transitionMs + CONTACT_WIZARD.transitionBufferMs);
      });
    });
  }

  private _syncIndicator(immediate = false): void {
    const currentElement =
      this._root.querySelector<HTMLElement>("[data-wizard-current]");
    const barElement = this._root.querySelector<HTMLElement>("[data-wizard-bar]");

    if (currentElement) {
      currentElement.textContent = String(this._current + 1).padStart(2, "0");
    }

    if (barElement) {
      const scale = (this._current + 1) / this._steps.length;
      barElement.style.transform = `scaleX(${scale})`;
    }

    this._syncActionState(immediate);
    this._syncSubmitAvailability();
  }

  private _syncActionState(immediate = false): void {
    const isFirstStep = this._current === 0;
    const isLastStep = this._current === this._steps.length - 1;

    this._prevButtons.forEach((button) => {
      this._syncPreviousAction(button, isFirstStep, immediate);
    });

    this._primaryActionButtons.forEach((button) => {
      this._syncPrimaryAction(button, isLastStep);
    });
  }

  private _syncPreviousAction(
    button: HTMLButtonElement,
    isFirstStep: boolean,
    immediate = false,
  ): void {
    const target = this._resolvePreviousActionTarget(button);
    this._clearPreviousActionHideTimer(target);

    if (isFirstStep) {
      button.disabled = true;
      button.setAttribute("aria-disabled", "true");
      target.setAttribute("aria-hidden", "true");
      target.toggleAttribute("inert", true);

      if (
        immediate ||
        target.hidden ||
        target.classList.contains(INIT_DOM_CLASSES.boxHidden)
      ) {
        this._hidePreviousActionImmediately(target);
        return;
      }

      this._hidePreviousActionWithTransition(target);
      return;
    }

    this._showPreviousActionTarget(target, immediate);
    button.disabled = this._submitting;
    button.setAttribute(
      "aria-disabled",
      this._submitting ? "true" : "false",
    );
  }

  private _syncPrimaryAction(
    button: HTMLButtonElement,
    isSubmitMode: boolean,
  ): void {
    button.type = isSubmitMode ? "submit" : "button";
    button.disabled = this._submitting;
    button.classList.toggle("no-wizard-action--next", !isSubmitMode);
    button.classList.toggle("no-wizard-action--submit", isSubmitMode);
    button.setAttribute("aria-hidden", "false");
    button.setAttribute("aria-disabled", this._submitting ? "true" : "false");

    if (isSubmitMode) {
      button.removeAttribute("data-wizard-next");
    } else {
      button.dataset.wizardNext = "";
    }

    const text = button.querySelector<HTMLElement>(".no-corner-btn__text");
    if (text) {
      const nextLabel = isSubmitMode ? "Submit" : "Next";
      if (text.textContent !== nextLabel) {
        text.textContent = nextLabel;
      }
    }
  }

  private _syncSidebar(): void {
    this._syncStepSummaries();
    this._syncNavigationState();
  }

  private _syncNavigationState(): void {
    const furthestAccessibleStep = this._resolveFurthestAccessibleStep();

    this._navItems.forEach((item, index) => {
      const isCurrent = index === this._current;
      const isComplete = this._isStepSatisfied(this._steps[index]);
      const button = item.querySelector<HTMLButtonElement>(
        ".no-wizard-overview__button",
      );

      item.classList.toggle("is-current", isCurrent);
      item.classList.toggle("is-complete", isComplete);
      item.classList.toggle("is-available", index <= furthestAccessibleStep);

      if (!button) return;
      button.classList.toggle("is-framed", isCurrent);
      button.disabled = this._submitting || index > furthestAccessibleStep;
      button.setAttribute(
        "aria-label",
        `${this._resolveNavLabel(index)} ${this._resolveStepLabel(index)}`,
      );
      if (isCurrent) {
        button.setAttribute("aria-current", "step");
        return;
      }
      button.removeAttribute("aria-current");
    });

    this._syncOverviewScroll();
  }

  private _syncOverviewScroll(): void {
    if (!this._overviewList) return;
    if (this._lastOverviewScrollIndex === this._current) return;

    const currentItem = this._navItems[this._current];
    if (!currentItem) return;

    this._lastOverviewScrollIndex = this._current;

    requestAnimationFrame(() => {
      const container = this._overviewList;
      if (!container) return;

      const containerRect = container.getBoundingClientRect();
      const itemRect = currentItem.getBoundingClientRect();
      const padding = CONTACT_WIZARD.overviewScrollPadding;
      const offsetTop = itemRect.top - containerRect.top;
      const offsetBottom = itemRect.bottom - containerRect.bottom;

      if (offsetTop < padding) {
        container.scrollTo({
          top: container.scrollTop + offsetTop - padding,
          behavior: "smooth",
        });
        return;
      }

      if (offsetBottom > -padding) {
        container.scrollTo({
          top: container.scrollTop + offsetBottom + padding,
          behavior: "smooth",
        });
      }
    });
  }

  private _syncStepSummaries(): void {
    this._stepValues.forEach((node) => {
      const stepIndex = Number(node.dataset.wizardStepValue);
      if (Number.isNaN(stepIndex)) return;
      this._renderStepValue(node, stepIndex);
    });
  }

  private _renderStepValue(node: HTMLElement, stepIndex: number): void {
    if (stepIndex === 4) {
      this._renderDetailStepValue(node);
      return;
    }

    const chipValues = this._resolveStepChipValues(stepIndex);
    const chipData = chipValues.map((value) => ({
      key: value,
      label: value,
    }));
    node.classList.toggle("is-chip-list", chipData.length > 0);

    if (chipData.length > 0) {
      this._syncChipList(node, chipData);
      return;
    }

    node.replaceChildren();
    node.textContent = "";
  }

  private _renderDetailStepValue(node: HTMLElement): void {
    const detail = this._truncate(
      this._resolveInputValue("detail"),
      CONTACT_WIZARD.detailPreviewLength,
    );
    const attachment = this._resolveAttachmentName();
    const chipListSelector = ".no-wizard-overview__chip-list";
    const currentChipList = node.querySelector<HTMLElement>(chipListSelector);
    const chipData: ContactWizardChipData[] = [];

    if (detail !== "") {
      chipData.push({
        key: "detail",
        label: detail,
      });
    }

    if (attachment !== "") {
      chipData.push({
        key: "attachment",
        label: attachment,
        iconClass: this._resolveAttachmentIconClass(attachment),
      });
    }

    node.classList.add("is-chip-list");

    if (chipData.length === 0) {
      currentChipList?.remove();
      node.textContent = "";
      return;
    }

    const chipList = currentChipList ?? document.createElement("span");
    chipList.className = "no-wizard-overview__chip-list is-chip-list";
    if (!chipList.parentElement) {
      node.append(chipList);
    }
    this._syncChipList(chipList, chipData);
  }

  private _syncChipList(
    node: HTMLElement,
    chipValues: ContactWizardChipData[],
  ): void {
    const previousPositions = this._captureChipPositions(node);
    const chipSet = new Set(chipValues.map((chip) => chip.key));
    const existingChips = new Map(
      Array.from(
        node.querySelectorAll<HTMLElement>(".no-wizard-overview__chip:not(.is-ghost)"),
      ).map((chip) => [chip.dataset.wizardChipKey ?? "", chip]),
    );
    let layoutChanged = false;

    chipValues.forEach((value, index) => {
      const existingChip = existingChips.get(value.key);
      const chip = existingChip ?? this._createChip(value, index);
      this._cancelChipLeave(chip);
      this._syncChipContent(chip, value);
      chip.style.animationDelay = `${index * CONTACT_WIZARD.chipStaggerMs}ms`;

      if (!existingChip) {
        node.append(chip);
        layoutChanged = true;
      }
    });

    existingChips.forEach((chip, value) => {
      if (chipSet.has(value)) return;
      this._detachChipWithGhost(node, chip);
      layoutChanged = true;
    });

    if (!layoutChanged) return;
    this._animateChipReflow(node, previousPositions);
  }

  private _createChip(value: ContactWizardChipData, index: number): HTMLElement {
    const chip = document.createElement("span");
    chip.className = "no-wizard-overview__chip is-entering";
    chip.dataset.wizardChipKey = value.key;
    chip.dataset.wizardChipValue = value.label;
    this._syncChipContent(chip, value);
    chip.style.animationDelay = `${index * CONTACT_WIZARD.chipStaggerMs}ms`;
    chip.addEventListener(
      "animationend",
      () => {
        chip.classList.remove("is-entering");
      },
      { once: true },
    );
    return chip;
  }

  private _syncChipContent(
    chip: HTMLElement,
    value: ContactWizardChipData,
  ): void {
    chip.dataset.wizardChipKey = value.key;
    chip.dataset.wizardChipValue = value.label;
    chip.classList.toggle(
      "no-wizard-overview__chip--with-icon",
      value.iconClass !== undefined,
    );

    const currentLabel = chip.querySelector<HTMLElement>(
      ".no-wizard-overview__chip-label",
    );
    const currentIcon = chip.querySelector<HTMLElement>(
      ".no-wizard-overview__chip-icon",
    );

    if (value.iconClass !== undefined) {
      const icon = currentIcon ?? document.createElement("i");
      icon.className = `no-wizard-overview__chip-icon ${value.iconClass}`;
      icon.setAttribute("aria-hidden", "true");
      this._syncAttachmentChipIcon(icon, value.iconClass);
      if (!icon.parentElement) {
        chip.prepend(icon);
      }
    } else {
      currentIcon?.remove();
    }

    const label = currentLabel ?? document.createElement("span");
    label.className = "no-wizard-overview__chip-label";
    if (label.textContent !== value.label) {
      label.textContent = value.label;
    }
    if (!label.parentElement) {
      chip.append(label);
    }
  }

  private _syncFileChipIcon(icon: HTMLElement): void {
    this._syncAttachmentChipIcon(
      icon,
      CONTACT_WIZARD.attachmentIconClass.file,
    );
  }

  private _resolveAttachmentIconClass(attachmentName: string): string {
    const extension = this._resolveAttachmentExtension(attachmentName);
    if (this._matchesAttachmentExtension(extension, CONTACT_WIZARD.attachmentImageExtensions)) {
      return CONTACT_WIZARD.attachmentIconClass.image;
    }
    if (this._matchesAttachmentExtension(extension, CONTACT_WIZARD.attachmentPdfExtensions)) {
      return CONTACT_WIZARD.attachmentIconClass.pdf;
    }
    if (this._matchesAttachmentExtension(extension, CONTACT_WIZARD.attachmentExcelExtensions)) {
      return CONTACT_WIZARD.attachmentIconClass.excel;
    }
    return CONTACT_WIZARD.attachmentIconClass.file;
  }

  private _resolveAttachmentExtension(attachmentName: string): string {
    const segments = attachmentName.toLowerCase().split(".");
    return segments.length > 1 ? segments[segments.length - 1] ?? "" : "";
  }

  private _matchesAttachmentExtension(
    extension: string,
    extensions: readonly string[],
  ): boolean {
    return extensions.some((candidate) => candidate === extension);
  }

  private _syncAttachmentChipIcon(
    icon: HTMLElement,
    iconClass: string,
  ): void {
    icon.replaceChildren(this._createAttachmentIconSvg(iconClass));
  }

  private _createAttachmentIconSvg(iconClass: string): SVGSVGElement {
    if (iconClass === CONTACT_WIZARD.attachmentIconClass.image) {
      return this._createImageIconSvg();
    }
    if (iconClass === CONTACT_WIZARD.attachmentIconClass.pdf) {
      return this._createPdfIconSvg();
    }
    if (iconClass === CONTACT_WIZARD.attachmentIconClass.excel) {
      return this._createExcelIconSvg();
    }
    return this._createFileIconSvg();
  }

  private _detachChipWithGhost(node: HTMLElement, chip: HTMLElement): void {
    this._cancelChipLeave(chip);

    const nodeRect = node.getBoundingClientRect();
    const chipRect = chip.getBoundingClientRect();
    const ghost = chip.cloneNode(true);
    if (!(ghost instanceof HTMLElement)) {
      chip.remove();
      return;
    }

    ghost.classList.remove("is-entering");
    ghost.classList.add("is-leaving", "is-ghost");
    ghost.style.left = `${chipRect.left - nodeRect.left}px`;
    ghost.style.top = `${chipRect.top - nodeRect.top}px`;
    ghost.style.width = `${chipRect.width}px`;
    ghost.style.height = `${chipRect.height}px`;

    node.append(ghost);
    chip.remove();

    const timer = this._trackedTimeout(() => {
      this._chipLeaveTimers.delete(ghost);
      ghost.remove();
    }, CONTACT_WIZARD.chipLeaveMs);

    this._chipLeaveTimers.set(ghost, timer);
  }

  private _cancelChipLeave(chip: HTMLElement): void {
    const timer = this._chipLeaveTimers.get(chip);
    if (timer !== undefined) {
      window.clearTimeout(timer);
      this._chipLeaveTimers.delete(chip);
    }
    chip.classList.remove("is-leaving");
  }

  private _captureChipPositions(node: HTMLElement): Map<HTMLElement, DOMRect> {
    return new Map(
      Array.from(
        node.querySelectorAll<HTMLElement>(".no-wizard-overview__chip:not(.is-ghost)"),
      ).map((chip) => [chip, chip.getBoundingClientRect()]),
    );
  }

  private _animateChipReflow(
    node: HTMLElement,
    previousPositions: Map<HTMLElement, DOMRect>,
  ): void {
    requestAnimationFrame(() => {
      node
        .querySelectorAll<HTMLElement>(".no-wizard-overview__chip:not(.is-ghost)")
        .forEach((chip) => {
          if (chip.classList.contains("is-entering")) return;

          const previousRect = previousPositions.get(chip);
          if (!previousRect) return;

          const currentRect = chip.getBoundingClientRect();
          const deltaX = previousRect.left - currentRect.left;
          const deltaY = previousRect.top - currentRect.top;

          if (Math.abs(deltaX) < 1 && Math.abs(deltaY) < 1) return;

          this._chipMoveAnimations.get(chip)?.cancel();
          const animation = this._trackAnimation(
            chip.animate(
              [
                { transform: `translate(${deltaX}px, ${deltaY}px)` },
                { transform: "translate(0, 0)" },
              ],
              {
                duration: CONTACT_WIZARD.chipMoveMs,
                easing: CONTACT_WIZARD.chipMoveEase,
                fill: "both",
              },
            ),
          );

          this._chipMoveAnimations.set(chip, animation);
          animation.addEventListener(
            "finish",
            () => {
              this._chipMoveAnimations.delete(chip);
            },
            { once: true },
          );
        });
    });
  }

  private _resolveStepChipValues(stepIndex: number): string[] {
    if (stepIndex === 0) {
      return this._resolveProjectChipValues();
    }

    if (stepIndex === 1) {
      return this._resolveSingleValueChip('input[name="budget"]:checked');
    }

    if (stepIndex === 2) {
      return this._resolveSingleValueChip('input[name="period"]:checked');
    }

    if (stepIndex === 3) {
      return this._resolveContactInfoChipValues();
    }

    return [];
  }

  private _resolveSingleValueChip(selector: string): string[] {
    const value = this._resolveChoiceLabel(selector);
    return value === "" ? [] : [value];
  }

  private _resolveProjectChipValues(): string[] {
    return Array.from(
      this._root.querySelectorAll<HTMLInputElement>('input[name="project[]"]'),
    )
      .filter((input) => input.checked)
      .flatMap((input) => {
        const label = this._resolveLabelText(input);
        if (label === "") return [];
        if (!input.hasAttribute("data-project-other-toggle")) return [label];

        const otherValue = this._projectOtherInput?.value.trim() ?? "";
        return otherValue === "" ? [label] : [`${label}: ${otherValue}`];
      });
  }

  private _resolveContactInfoChipValues(): string[] {
    return ["company", "name", "position", "phone", "email", "homepage"]
      .map((name) => this._resolveInputValue(name))
      .filter((value) => value !== "");
  }


  private _resolveStepLabel(stepIndex: number): string {
    return this._steps[stepIndex]?.dataset.wizardLabel?.trim() ?? "";
  }

  private _resolveNavLabel(stepIndex: number): string {
    return (
      this._steps[stepIndex]?.dataset.wizardNavLabel?.trim() ??
      this._resolveStepLabel(stepIndex)
    );
  }

