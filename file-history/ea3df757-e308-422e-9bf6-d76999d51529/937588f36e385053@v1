  private _resolveCornerPaths(position: "tl" | "tr" | "bl" | "br"): [string, string] {
    if (position === "tl") return ["M 0 0 L 14 0", "M 0 0 L 0 14"];
    if (position === "tr") return ["M 26 0 L 12 0", "M 26 0 L 26 14"];
    if (position === "bl") return ["M 0 26 L 14 26", "M 0 26 L 0 12"];
    return ["M 26 26 L 12 26", "M 26 26 L 26 12"];
  }

  private _resolveCheckedLabels(selector: string): string[] {
    return Array.from(this._root.querySelectorAll<HTMLInputElement>(selector))
      .filter((input) => input.checked)
      .flatMap((input) => {
        const text = this._resolveLabelText(input);
        return text === "" ? [] : [text];
      });
  }

  private _resolveChoiceLabel(selector: string): string {
    const input = this._root.querySelector<HTMLInputElement>(selector);
    if (!input) return "";

    return this._resolveLabelText(input);
  }

  private _resolveLabelText(input: HTMLInputElement): string {
    const label = this._root.querySelector<HTMLLabelElement>(
      `label[for="${input.id}"]`,
    );
    return label?.textContent?.trim() ?? "";
  }

  private _resolveInputValue(name: string): string {
    const field = this._root.querySelector<HTMLInputElement | HTMLTextAreaElement>(
      `[name="${name}"]`,
    );
    return field?.value.trim() ?? "";
  }

  private _resolveAttachmentName(): string {
    const input = this._root.querySelector<HTMLInputElement>(
      'input[name="attachment"]',
    );
    return input?.files?.[0]?.name ?? "";
  }

  private _resolveFurthestAccessibleStep(): number {
    let furthestAccessibleStep = 0;

    this._steps.forEach((step, index) => {
      if (index > furthestAccessibleStep) return;
      if (!this._isStepSatisfied(step)) return;
      furthestAccessibleStep = Math.min(index + 1, this._steps.length - 1);
    });

    return furthestAccessibleStep;
  }

  private _truncate(value: string, limit: number): string {
    if (value.length <= limit) return value;
    return `${value.slice(0, limit).trimEnd()}...`;
  }

  private _isSubmitAllowed(): boolean {
    return this._current === this._steps.length - 1;
  }

  private _syncSubmitAvailability(): void {
    if (this._form) {
      this._form.dataset.loadingOnSubmit = CONTACT_WIZARD.loadingOff;
    }
  }

  private _triggerValidationAndCheck(stepElement: HTMLElement): boolean {
    this._dispatchValidationEvents(stepElement);

    const invalidField = this._resolveFirstInvalidField(stepElement);
    if (!invalidField) return true;

    invalidField.focus();
    invalidField.scrollIntoView({ behavior: "smooth", block: "center" });
    return false;
  }

  private _dispatchValidationEvents(stepElement: HTMLElement): void {
    const seenNames = new Set<string>();

    stepElement
      .querySelectorAll<HTMLInputElement>('input[type="checkbox"], input[type="radio"]')
      .forEach((input) => {
        if (seenNames.has(input.name)) return;
        seenNames.add(input.name);
        input.dispatchEvent(new Event("change", { bubbles: true }));
      });

    this._resolveFieldCandidates(stepElement).forEach((field) => {
      field.dispatchEvent(new FocusEvent("focusout", { bubbles: true }));
    });
  }

  private _resolveFirstInvalidField(
    stepElement: HTMLElement,
  ): HTMLInputElement | HTMLTextAreaElement | null {
    const invalidSelectionGroup = this._resolveSelectionGroups(stepElement).find(
      (inputs) => !inputs.some((input) => input.checked),
    );
    if (invalidSelectionGroup?.[0]) return invalidSelectionGroup[0];

    return (
      this._resolveFieldCandidates(stepElement).find(
        (field) => !this._isValidField(field),
      ) ?? null
    );
  }

  private _isStepSatisfied(stepElement: HTMLElement): boolean {
    return this._resolveFirstInvalidField(stepElement) === null;
  }

  private _resolveSelectionGroups(stepElement: HTMLElement): HTMLInputElement[][] {
    const groups = new Map<string, HTMLInputElement[]>();

    stepElement
      .querySelectorAll<HTMLInputElement>('input[type="checkbox"], input[type="radio"]')
      .forEach((input) => {
        const currentGroup = groups.get(input.name);
        if (currentGroup) {
          currentGroup.push(input);
          return;
        }
        groups.set(input.name, [input]);
      });

    return Array.from(groups.values());
  }

  private _resolveFieldCandidates(
    stepElement: HTMLElement,
  ): Array<HTMLInputElement | HTMLTextAreaElement> {
    return Array.from(
      stepElement.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input:not([type="checkbox"]):not([type="radio"]):not([type="file"]):not(:disabled), textarea:not(:disabled)',
      ),
    );
  }

  private _isValidField(field: HTMLInputElement | HTMLTextAreaElement): boolean {
    if (field.disabled) return true;
    const value = field.value.trim();
    if (field.hasAttribute("required") && value === "") return false;
    if (value === "") return true;
    if (field instanceof HTMLInputElement) {
      return field.validity.valid;
    }
    return true;
  }

  private _shouldDebounceSidebarSync(target: EventTarget | null): boolean {
    if (!(target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement)) {
      return false;
    }

    if (target instanceof HTMLTextAreaElement) return true;
    return !["checkbox", "radio", "file"].includes(target.type);
  }

  private async _submit(): Promise<void> {
    if (!this._form || this._submitting) return;
    this._setSubmittingState(true);
    this._clearSubmitFeedback();

    try {
      const response = await this._sendSubmitRequest();
      if (!response.success) {
        this._showSubmitFeedback(response.message);
        return;
      }
      await this._requestSuccessFlow(response);
    } catch (error) {
      this._showSubmitFeedback(this._resolveSubmitErrorMessage(error));
    } finally {
      this._setSubmittingState(false);
    }
  }

  private async _sendSubmitRequest(): Promise<ContactSubmitResponse> {
    const form = this._form;
    if (!form) {
      throw new Error("Missing contact form.");
    }

    const action = form.action.trim() === "" ? window.location.pathname : form.action;
    const response = await fetch(action, {
      method: (form.method || "POST").toUpperCase(),
      body: new FormData(form),
      headers: {
        Accept: "application/json",
        "X-Requested-With": "XMLHttpRequest",
      },
    });
    const payload = await this._readSubmitResponse(response);
    if (response.ok && payload.success) {
      return payload;
    }
    throw new Error(payload.message);
  }

  private async _readSubmitResponse(
    response: Response,
  ): Promise<ContactSubmitResponse> {
    let parsed: unknown = null;
    try {
      parsed = await response.json();
    } catch (_error) {
      parsed = null;
    }

    if (this._isSubmitResponse(parsed)) {
      return parsed;
    }

    return {
      success: false,
      message: "문의 접수 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.",
    };
  }

  private _isSubmitResponse(value: unknown): value is ContactSubmitResponse {
    if (value == null || typeof value !== "object" || Array.isArray(value)) {
      return false;
    }
    const response = value as Record<string, unknown>;
    return (
      typeof response.success === "boolean" &&
      typeof response.message === "string"
    );
  }

  private async _requestSuccessFlow(
    response: ContactSubmitResponse,
  ): Promise<void> {
    const message =
      response.message.trim() === ""
        ? CONTACT_THEATRE_SUCCESS_DEFAULT_MESSAGE
        : response.message;

    await new Promise<void>((resolve, reject) => {
      const detail: ContactSuccessFlowRequestDetail = {
        handled: false,
        message,
        resolve,
        reject,
      };
      window.dispatchEvent(
        new CustomEvent<ContactSuccessFlowRequestDetail>(
          CONTACT_THEATRE_SUCCESS_FLOW_REQUEST_EVENT,
          { detail },
        ),
      );
      Logger.info(ContactWizard._CLASS, "_requestSuccessFlow", "Success flow dispatched.", {
        handled: detail.handled,
      });
      if (detail.handled) return;
      resolve();
    });
  }

  private _setSubmittingState(isSubmitting: boolean): void {
    this._submitting = isSubmitting;
    this._root.classList.toggle("is-submitting", isSubmitting);
    this._root.setAttribute("aria-busy", isSubmitting ? "true" : "false");
    this._syncActionState();
    this._syncNavigationState();
  }

  private _resolveSubmitFeedbackNode(): HTMLElement | null {
    return this._form?.querySelector<HTMLElement>("[data-contact-submit-feedback]") ?? null;
  }

  private _clearSubmitFeedback(): void {
    const feedback = this._resolveSubmitFeedbackNode();
    if (!feedback) return;
    feedback.hidden = true;
    feedback.textContent = "";
  }

  private _showSubmitFeedback(message: string): void {
    const feedback = this._resolveSubmitFeedbackNode();
    if (!feedback) return;
    feedback.hidden = false;
    feedback.textContent =
      message.trim() === ""
        ? "문의 접수 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요."
        : message;
  }

  private _resolveSubmitErrorMessage(error: unknown): string {
    if (error instanceof Error && error.message.trim() !== "") {
      return error.message;
    }
    return "문의 접수 중 문제가 발생했습니다. 잠시 후 다시 시도해 주세요.";
  }

  private _syncProjectOtherField(): void {
    const toggle = this._projectOtherToggle;
    const panel = this._projectOtherPanel;
    const input = this._projectOtherInput;
    if (!toggle || !panel || !input) return;

    const isActive = toggle.checked;
    panel.classList.toggle("is-active", isActive);
    panel.setAttribute("aria-hidden", isActive ? "false" : "true");
    input.disabled = !isActive;
    input.toggleAttribute("required", isActive);
  }

  private _resolvePreviousActionTarget(button: HTMLButtonElement): HTMLElement {
    return (
      button.closest<HTMLElement>(CONTACT_WIZARD.previousActionWrapperSelector) ??
      button
    );
  }

  private _showPreviousActionTarget(
    target: HTMLElement,
    immediate = false,
  ): void {
    target.classList.add(INIT_DOM_CLASSES.blockBase);
    target.hidden = false;
    target.style.removeProperty("display");
    target.setAttribute("aria-hidden", "false");
    target.toggleAttribute("inert", false);
    target.classList.remove(MASKING.hiddenClass, INIT_DOM_CLASSES.boxHidden);
    target.classList.remove("is-block-reveal-down");

    if (immediate) {
      target.classList.add(INIT_DOM_CLASSES.blockUp);
      return;
    }

    if (target.classList.contains(INIT_DOM_CLASSES.blockUp)) return;

    void target.getBoundingClientRect();
    BlockReveal.reveal(target);
  }

  private _hidePreviousActionImmediately(target: HTMLElement): void {
    target.hidden = true;
    target.style.display = "none";
    target.classList.remove(INIT_DOM_CLASSES.blockUp, "is-block-reveal-down");
    target.classList.add(INIT_DOM_CLASSES.blockBase, INIT_DOM_CLASSES.boxHidden);
  }

  private _hidePreviousActionWithTransition(target: HTMLElement): void {
    target.classList.add(INIT_DOM_CLASSES.blockBase);
    target.hidden = false;
    target.style.removeProperty("display");
    target.classList.remove(MASKING.hiddenClass, INIT_DOM_CLASSES.boxHidden);
    target.classList.remove(INIT_DOM_CLASSES.blockUp);
    void target.getBoundingClientRect();
    target.classList.add("is-block-reveal-down");

    const timerId = this._trackedTimeout(() => {
      this._previousActionHideTimers.delete(target);
      this._hidePreviousActionImmediately(target);
    }, this._resolveRevealTransitionMs(target));

    this._previousActionHideTimers.set(target, timerId);
  }

  private _clearPreviousActionHideTimer(target: HTMLElement): void {
    const timerId = this._previousActionHideTimers.get(target);
    if (timerId == null) return;
    window.clearTimeout(timerId);
    this._previousActionHideTimers.delete(target);
  }

  private _resolveRevealTransitionMs(target: HTMLElement): number {
    const computedStyle = window.getComputedStyle(target);
    const durations = this._parseCssTimeList(computedStyle.transitionDuration);
    const delays = this._parseCssTimeList(computedStyle.transitionDelay);
    const entries = Math.max(durations.length, delays.length, 1);
    let maxMs = 0;

    for (let index = 0; index < entries; index += 1) {
      const duration = durations[index] ?? durations[durations.length - 1] ?? 0;
      const delay = delays[index] ?? delays[delays.length - 1] ?? 0;
      maxMs = Math.max(maxMs, duration + delay);
    }

    return Math.max(maxMs, CONTACT_WIZARD.transitionMs) + CONTACT_WIZARD.transitionBufferMs;
  }

  private _parseCssTimeList(value: string): number[] {
    return value
      .split(",")
      .map((entry) => entry.trim())
      .filter((entry) => entry !== "")
      .map((entry) => {
        if (entry.endsWith("ms")) {
          return Number.parseFloat(entry);
        }
        if (entry.endsWith("s")) {
          return Number.parseFloat(entry) * 1000;
        }
        return 0;
      })
      .filter((entry) => Number.isFinite(entry));
  }
