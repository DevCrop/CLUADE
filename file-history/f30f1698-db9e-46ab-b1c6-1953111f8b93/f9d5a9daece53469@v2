import * as THREE from "three";
import {
  aboutLights as aboutLightsId,
  earth as earthId,
  gravityBalls as gravityBallsId,
} from "../../../core/setup.js";
import type { Engine } from "../../../core/Engine.js";
import type { SceneFromState } from "../../../types/core.types.js";
import type {
  ContactCameraTheatreValue,
  ContactLightsPort,
  ContactSceneState,
  ContactTransformState,
} from "../../../types/contact.types.js";
import { Helpers } from "../../../utils/Helpers.js";
import { CONTACT_DEFAULT_SCENE_STATE } from "../scene/contact.scene.js";

export class ContactSceneRig {
  createDefaultValue(): ContactSceneState {
    return {
      camera: {
        position: { ...CONTACT_DEFAULT_SCENE_STATE.camera.position },
        target: { ...CONTACT_DEFAULT_SCENE_STATE.camera.target },
        fov: CONTACT_DEFAULT_SCENE_STATE.camera.fov,
      },
      light: {
        ...CONTACT_DEFAULT_SCENE_STATE.light,
        rig: {
          position: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.position },
          rotation: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.rotation },
          scale: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.scale },
          visible: CONTACT_DEFAULT_SCENE_STATE.light.rig.visible,
        },
      },
      earth: {
        position: { ...CONTACT_DEFAULT_SCENE_STATE.earth.position },
        rotation: { ...CONTACT_DEFAULT_SCENE_STATE.earth.rotation },
        scale: { ...CONTACT_DEFAULT_SCENE_STATE.earth.scale },
        visible: CONTACT_DEFAULT_SCENE_STATE.earth.visible,
      },
      gravityBalls: {
        position: { ...CONTACT_DEFAULT_SCENE_STATE.gravityBalls.position },
        rotation: { ...CONTACT_DEFAULT_SCENE_STATE.gravityBalls.rotation },
        scale: { ...CONTACT_DEFAULT_SCENE_STATE.gravityBalls.scale },
        visible: CONTACT_DEFAULT_SCENE_STATE.gravityBalls.visible,
      },
    };
  }

  compose(state: ContactSceneState): SceneFromState {
    return {
      camera: {
        position: { ...state.camera.position },
        fov: state.camera.fov,
      },
      cameraTarget: {
        position: { ...state.camera.target },
      },
      [earthId]: state.earth,
      [gravityBallsId]: {
        position: { ...state.gravityBalls.position },
        rotation: { ...state.gravityBalls.rotation },
        scale: { ...state.gravityBalls.scale },
        visible: state.gravityBalls.visible,
      },
    } as unknown as SceneFromState;
  }

  apply(engine: Engine, state: ContactSceneState): void {
    engine.setState(this.compose(state));
    engine.getCamera().lookAt(engine.getCameraTarget().position);
    this._applyLight(engine, state.light);
  }

  read(engine: Engine): ContactSceneState {
    const camera = engine.getCamera();
    const target = engine.getCameraTarget();
    const defaults = CONTACT_DEFAULT_SCENE_STATE;
    return {
      camera: {
        position: {
          x: this._toFinite(camera.position.x, defaults.camera.position.x),
          y: this._toFinite(camera.position.y, defaults.camera.position.y),
          z: this._toFinite(camera.position.z, defaults.camera.position.z),
        },
        target: {
          x: this._toFinite(target.position.x, defaults.camera.target.x),
          y: this._toFinite(target.position.y, defaults.camera.target.y),
          z: this._toFinite(target.position.z, defaults.camera.target.z),
        },
        fov: this._toFinite(camera.fov, defaults.camera.fov),
      },
      light: this._readLight(engine),
      earth: this._readTransform(engine, earthId, defaults.earth),
      gravityBalls: this._readTransform(
        engine,
        gravityBallsId,
        defaults.gravityBalls,
      ),
    };
  }

  readCamera(engine: Engine): ContactCameraTheatreValue {
    return {
      camera: this.read(engine).camera,
    };
  }

  readObjectValue(value: ContactSceneState): ContactSceneState {
    return {
      camera: {
        position: { ...value.camera.position },
        target: { ...value.camera.target },
        fov: value.camera.fov,
      },
      light: {
        ...value.light,
        rig: {
          position: { ...value.light.rig.position },
          rotation: { ...value.light.rig.rotation },
          scale: { ...value.light.rig.scale },
          visible: value.light.rig.visible,
        },
      },
      earth: {
        position: { ...value.earth.position },
        rotation: { ...value.earth.rotation },
        scale: { ...value.earth.scale },
        visible: value.earth.visible,
      },
      gravityBalls: {
        position: { ...value.gravityBalls.position },
        rotation: { ...value.gravityBalls.rotation },
        scale: { ...value.gravityBalls.scale },
        visible: value.gravityBalls.visible,
      },
    };
  }

  private _applyLight(
    engine: Engine,
    state: ContactSceneState["light"],
  ): void {
    const light = engine.getSceneObjectById(
      aboutLightsId,
    ) as ContactLightsPort | null;
    if (!light) return;
    light.setState(state);
  }

  private _readLight(engine: Engine): ContactSceneState["light"] {
    const light = engine.getSceneObjectById(
      aboutLightsId,
    ) as ContactLightsPort | null;
    if (!light) {
      return {
        ...CONTACT_DEFAULT_SCENE_STATE.light,
        rig: {
          position: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.position },
          rotation: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.rotation },
          scale: { ...CONTACT_DEFAULT_SCENE_STATE.light.rig.scale },
          visible: CONTACT_DEFAULT_SCENE_STATE.light.rig.visible,
        },
      };
    }
    return light.getState();
  }

  private _readTransform(
    engine: Engine,
    id: string,
    fallback: ContactTransformState,
  ): ContactTransformState {
    const target = engine.getObjectById(id) as THREE.Object3D | null;
    const rotation = Helpers.readRotationDeg(target);
    return {
      position: {
        x: this._toFinite(target?.position.x, fallback.position.x),
        y: this._toFinite(target?.position.y, fallback.position.y),
        z: this._toFinite(target?.position.z, fallback.position.z),
      },
      rotation: {
        x: this._toFinite(rotation.x, fallback.rotation.x),
        y: this._toFinite(rotation.y, fallback.rotation.y),
        z: this._toFinite(rotation.z, fallback.rotation.z),
      },
      scale: {
        x: this._toFinite(target?.scale.x, fallback.scale.x),
        y: this._toFinite(target?.scale.y, fallback.scale.y),
        z: this._toFinite(target?.scale.z, fallback.scale.z),
      },
      visible: target?.visible ?? fallback.visible,
    };
  }

  private _toFinite(value: unknown, fallback: number): number {
    if (typeof value !== "number") return fallback;
    if (!Number.isFinite(value)) return fallback;
    return value;
  }
}
