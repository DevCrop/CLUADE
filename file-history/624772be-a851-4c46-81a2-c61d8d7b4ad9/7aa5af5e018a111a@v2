import { describe, it, expect } from "vitest";
import { Helpers } from "../utils/Helpers.js";

describe("Helpers.clamp", () => {
  it("returns value within range", () => {
    expect(Helpers.clamp(5, 0, 10)).toBe(5);
  });
  it("clamps to min", () => {
    expect(Helpers.clamp(-1, 0, 10)).toBe(0);
  });
  it("clamps to max", () => {
    expect(Helpers.clamp(11, 0, 10)).toBe(10);
  });
});

describe("Helpers.clamp01", () => {
  it("returns 0 for any non-finite value (NaN, Infinity, -Infinity)", () => {
    expect(Helpers.clamp01(NaN)).toBe(0);
    expect(Helpers.clamp01(Infinity)).toBe(0);
    expect(Helpers.clamp01(-Infinity)).toBe(0);
  });
  it("clamps to [0, 1]", () => {
    expect(Helpers.clamp01(-0.5)).toBe(0);
    expect(Helpers.clamp01(1.5)).toBe(1);
    expect(Helpers.clamp01(0.5)).toBe(0.5);
  });
});

describe("Helpers.lerp", () => {
  it("returns start at t=0", () => {
    expect(Helpers.lerp(0, 10, 0)).toBe(0);
  });
  it("returns end at t=1", () => {
    expect(Helpers.lerp(0, 10, 1)).toBe(10);
  });
  it("interpolates correctly", () => {
    expect(Helpers.lerp(0, 10, 0.5)).toBe(5);
  });
});

describe("Helpers.remap01", () => {
  it("returns 0 for value at start", () => {
    expect(Helpers.remap01(0, 0, 10)).toBe(0);
  });
  it("returns 1 for value at end", () => {
    expect(Helpers.remap01(10, 0, 10)).toBe(1);
  });
  it("maps midpoint to 0.5", () => {
    expect(Helpers.remap01(5, 0, 10)).toBe(0.5);
  });
  it("returns 0 for non-finite value", () => {
    expect(Helpers.remap01(NaN, 0, 10)).toBe(0);
  });
});

describe("Helpers.degToRad / radToDeg", () => {
  it("converts 180 degrees to PI", () => {
    expect(Helpers.degToRad(180)).toBeCloseTo(Math.PI);
  });
  it("converts PI radians to 180 degrees", () => {
    expect(Helpers.radToDeg(Math.PI)).toBeCloseTo(180);
  });
  it("round-trips correctly", () => {
    expect(Helpers.radToDeg(Helpers.degToRad(45))).toBeCloseTo(45);
  });
});

describe("Helpers.hexToRgba", () => {
  it("converts hex to rgba string", () => {
    expect(Helpers.hexToRgba("#ff0000")).toBe("rgba(255,0,0,1)");
  });
  it("respects custom alpha", () => {
    expect(Helpers.hexToRgba("#ffffff", 0.5)).toBe("rgba(255,255,255,0.5)");
  });
});

describe("Helpers.hexToVec3", () => {
  it("converts white to [1,1,1]", () => {
    const [r, g, b] = Helpers.hexToVec3("#ffffff");
    expect(r).toBeCloseTo(1);
    expect(g).toBeCloseTo(1);
    expect(b).toBeCloseTo(1);
  });
  it("converts black to [0,0,0]", () => {
    const [r, g, b] = Helpers.hexToVec3("#000000");
    expect(r).toBe(0);
    expect(g).toBe(0);
    expect(b).toBe(0);
  });
});
