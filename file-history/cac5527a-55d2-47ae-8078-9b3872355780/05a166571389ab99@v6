function getAboutHeroSloganElement(): HTMLElement | null {
  if (aboutHeroSloganElement?.isConnected) {
    return aboutHeroSloganElement;
  }
  aboutHeroSloganElement = document.querySelector<HTMLElement>(
    ABOUT_HERO_SLOGAN_SELECTOR,
  );
  return aboutHeroSloganElement;
}

function getAboutJourneySurfaceElement(): HTMLElement | null {
  if (aboutJourneySurfaceElement?.isConnected) {
    return aboutJourneySurfaceElement;
  }
  aboutJourneySurfaceElement = document.querySelector<HTMLElement>(
    ABOUT_JOURNEY_SURFACE_SELECTOR,
  );
  return aboutJourneySurfaceElement;
}

function setAboutHeroSloganSurfaceAlpha(progress: number): void {
  const element = getAboutHeroSloganElement();
  if (!element) return;
  const clampedProgress = Math.max(0, Math.min(1, progress));
  const alpha =
    ABOUT_HERO_SLOGAN_ALPHA_MIN +
    ABOUT_HERO_SLOGAN_ALPHA_SPAN * clampedProgress;
  element.style.setProperty(ABOUT_HERO_SLOGAN_ALPHA_PROPERTY, alpha.toFixed(4));
}

function resetAboutHeroSloganSurfaceAlpha(): void {
  const element = getAboutHeroSloganElement();
  if (!element) return;
  element.style.setProperty(
    ABOUT_HERO_SLOGAN_ALPHA_PROPERTY,
    String(ABOUT_HERO_SLOGAN_ALPHA_MIN),
  );
}

function setAboutJourneySurfaceAlpha(alpha: number): void {
  const element = getAboutJourneySurfaceElement();
  if (!element) return;
  element.style.setProperty(ABOUT_JOURNEY_SURFACE_ALPHA_PROPERTY, alpha.toFixed(4));
}

function syncAboutMissionVisionSurfaceAlpha(progress: number): void {
  const clampedProgress = Math.max(0, Math.min(1, progress));
  const alpha =
    ABOUT_JOURNEY_SURFACE_ALPHA_MIN +
    ABOUT_JOURNEY_SURFACE_SEGMENT_SPAN * clampedProgress;
  setAboutJourneySurfaceAlpha(alpha);
}

function syncAboutServicesSurfaceAlpha(progress: number): void {
  const clampedProgress = Math.max(0, Math.min(1, progress));
  const alpha =
    ABOUT_JOURNEY_SURFACE_ALPHA_MIN +
    ABOUT_JOURNEY_SURFACE_SEGMENT_SPAN +
    ABOUT_JOURNEY_SURFACE_SEGMENT_SPAN * clampedProgress;
  setAboutJourneySurfaceAlpha(alpha);
}

function syncAboutAwardsSurfaceAlpha(progress: number): void {
  const clampedProgress = Math.max(0, Math.min(1, progress));
  const alpha =
    ABOUT_JOURNEY_SURFACE_ALPHA_MIN +
    ABOUT_JOURNEY_SURFACE_SEGMENT_SPAN * 2 +
    ABOUT_JOURNEY_SURFACE_SEGMENT_SPAN * clampedProgress;
  setAboutJourneySurfaceAlpha(alpha);
}

function resetAboutJourneySurfaceAlpha(): void {
  setAboutJourneySurfaceAlpha(ABOUT_JOURNEY_SURFACE_ALPHA_MIN);
}

function clearTimers(timerIds: number[]): number[] {
  timerIds.forEach((timerId) => {
    window.clearTimeout(timerId);
  });
  return [];
}

function syncSectionTextReveal(
  selector: string,
  domState: { visible: boolean; timers: number[] },
  progress: number,
): void {
  const shouldShow = progress >= SECTION_TEXT_REVEAL_THRESHOLD;
  const shouldHide = !shouldShow && progress < SECTION_TEXT_HIDE_THRESHOLD;
  if (!shouldShow && !shouldHide) return;
  if (domState.visible === shouldShow) return;
  domState.visible = shouldShow;
  domState.timers = clearTimers(domState.timers);
  const elements = Array.from(document.querySelectorAll<HTMLElement>(selector));
  elements.forEach((el, i) => {
    const id = window.setTimeout(() => {
      el.classList.toggle("is-block-reveal-up", shouldShow);
    }, i * SECTION_TEXT_STAGGER_MS);
    domState.timers.push(id);
  });
}

function syncRevealBounded(
  selector: string,
  domState: { visible: boolean; timers: number[] },
  shouldShow: boolean,
  shouldHide: boolean,
  enterDelayMs = 0,
): void {
  if (!shouldShow && !shouldHide) return;
  if (domState.visible === shouldShow) return;
  domState.visible = shouldShow;
  domState.timers = clearTimers(domState.timers);
  const baseDelay = shouldShow ? enterDelayMs : 0;
  const elements = Array.from(document.querySelectorAll<HTMLElement>(selector));
  elements.forEach((el, i) => {
    const id = window.setTimeout(() => {
      el.classList.toggle("is-block-reveal-up", shouldShow);
    }, baseDelay + i * SECTION_TEXT_STAGGER_MS);
    domState.timers.push(id);
  });
}

function disposeSectionTextReveal(
  selector: string,
  domState: { visible: boolean; timers: number[] },
): void {
  domState.timers = clearTimers(domState.timers);
  domState.visible = false;
  document
    .querySelectorAll<HTMLElement>(selector)
    .forEach((el) => el.classList.remove("is-block-reveal-up"));
}

