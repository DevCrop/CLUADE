export const scenes = {
  heroIntro: {},
  heroSlogan: {
    onProgress: (progress: number): void => {
      setAboutHeroSloganSurfaceAlpha(progress);
    },
    onDispose: (): void => {
      resetAboutHeroSloganSurfaceAlpha();
    },
  },
  gallery: {
    onProgress: (progress: number): void => {
      syncSectionTextReveal(GALLERY_TEXT_SELECTOR, aboutGalleryDomState, progress);
      _galleryProgressCallback?.(progress);
    },
    onDispose: (): void => {
      disposeSectionTextReveal(GALLERY_TEXT_SELECTOR, aboutGalleryDomState);
      _galleryProgressCallback?.(0);
    },
  },
  proof: {
    onProgress: (progress: number): void => {
      const hShow = progress >= SECTION_TEXT_REVEAL_THRESHOLD && progress < PROOF_STAGE_SPLIT;
      const hHide = !hShow && (progress < SECTION_TEXT_HIDE_THRESHOLD || progress >= PROOF_STAGE_SPLIT);
      syncRevealBounded(PROOF_HEADLINE_SELECTOR, aboutProofHeadlineDomState, hShow, hHide);
      const sShow = progress >= PROOF_SUB_SHOW;
      const sHide = !sShow && progress < PROOF_SUB_SHOW - 0.06;
      syncRevealBounded(PROOF_SUB_SELECTOR, aboutProofSubDomState, sShow, sHide, 900);
      _proofProgressCallback?.(progress);
    },
    onDispose: (): void => {
      disposeSectionTextReveal(PROOF_HEADLINE_SELECTOR, aboutProofHeadlineDomState);
      disposeSectionTextReveal(PROOF_SUB_SELECTOR, aboutProofSubDomState);
      _proofProgressCallback?.(0);
    },
  },
  missionVision: {
    onProgress: (progress: number): void => {
      syncAboutMissionVisionSurfaceAlpha(progress);
    },
    onDispose: (): void => {
      resetAboutJourneySurfaceAlpha();
    },
  },
  services: {
    onProgress: (progress: number): void => {
      syncAboutServicesSurfaceAlpha(progress);
    },
    onDispose: (): void => {
      resetAboutJourneySurfaceAlpha();
    },
  },
  awards: {
    onProgress: (progress: number): void => {
      syncAboutAwardsSurfaceAlpha(progress);
    },
    onDispose: (): void => {
      resetAboutJourneySurfaceAlpha();
    },
  },
  client: {},
  contact: {
    onProgress: (progress: number): void => {
      syncAboutContactHead(progress);
    },
    onDispose: (): void => {
      disposeAboutContactHead();
    },
  },
} as const;

