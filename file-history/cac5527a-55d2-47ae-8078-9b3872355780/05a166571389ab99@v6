function syncAboutContactHead(progress: number): void {
  const section = document.querySelector<HTMLElement>(ABOUT_CONTACT_SECTION_SELECTOR);
  const head = document.querySelector<HTMLElement>(ABOUT_CONTACT_HEAD_SELECTOR);
  const actions = document.querySelector<HTMLElement>(ABOUT_CONTACT_ACTIONS_SELECTOR);
  if (!section || !head || !actions) return;

  const textItems = Array.from(head.querySelectorAll<HTMLElement>(".mask-target"));
  const shouldShow = progress >= CONTACT_HEAD_TRANSITION.revealStart;

  if (aboutSceneDomState.isContactHeadVisible === shouldShow) return;
  aboutSceneDomState.isContactHeadVisible = shouldShow;
  aboutSceneDomState.contactHeadTimers = clearTimers(
    aboutSceneDomState.contactHeadTimers,
  );

  if (shouldShow) {
    section.dataset.active = "true";
    head.dataset.active = "true";
    actions.dataset.active = "true";
    TextReveal.setVisibleOff(textItems);
    textItems.forEach((item, index) => {
      const timerId = window.setTimeout(() => {
        TextReveal.setVisibleOn(item);
      }, index * CONTACT_HEAD_TRANSITION.revealStagger * 1000);
      aboutSceneDomState.contactHeadTimers.push(timerId);
    });
    return;
  }

  textItems.forEach((item) => {
    TextReveal.setVisibleOff(item);
  });
  section.dataset.active = "false";
  head.dataset.active = "false";
  actions.dataset.active = "false";
}

function disposeAboutContactHead(): void {
  const section = document.querySelector<HTMLElement>(ABOUT_CONTACT_SECTION_SELECTOR);
  const head = document.querySelector<HTMLElement>(ABOUT_CONTACT_HEAD_SELECTOR);
  const actions = document.querySelector<HTMLElement>(ABOUT_CONTACT_ACTIONS_SELECTOR);
  if (!section || !head || !actions) return;

  aboutSceneDomState.isContactHeadVisible = false;
  aboutSceneDomState.contactHeadTimers = clearTimers(
    aboutSceneDomState.contactHeadTimers,
  );
  section.dataset.active = "false";
  head.dataset.active = "false";
  actions.dataset.active = "false";

  const textItems = Array.from(head.querySelectorAll<HTMLElement>(".mask-target"));
  textItems.forEach((item) => TextReveal.setVisibleOff(item));
}

function createAboutInitialState(
  sceneState: typeof ABOUT_DEFAULT_SCENE_STATE,
): AboutInitialState {
  return {
    camera: {
      position: { ...sceneState.camera.position },
      fov: sceneState.camera.fov,
    },
    cameraTarget: {
      position: { ...sceneState.camera.target },
    },
    aboutLights: { ...sceneState.light },
    terrian: { ...sceneState.terrian },
  };
}

function createAboutObjectRegistry<TObjectId extends string>(
  ids: readonly TObjectId[],
): Record<TObjectId, true> {
  return ids.reduce<Record<TObjectId, true>>(
    (registry, id) => {
      registry[id] = true;
      return registry;
    },
    {} as Record<TObjectId, true>,
  );
}

