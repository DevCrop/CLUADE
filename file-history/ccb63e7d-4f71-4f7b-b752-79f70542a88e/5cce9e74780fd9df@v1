@use "../abstract" as *;

.no-work-modal {
  $root: &;
  position: fixed;
  inset: 0;
  z-index: var(--z-index-modal);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--modal-viewport-offset);
  pointer-events: none;

  &__top {
    padding: var(--gutter-xl);
  }

  &__backdrop {
    border: 0;
    cursor: pointer;
    z-index: 0;
  }

  &__shell {
    position: relative;
    z-index: 1;
    width: min(100%, fluid(544, 1024));
  }

  &__panel {
    position: relative;
    z-index: 1;
    width: 100%;
    background: var(--clr-surface-default);
    background-image:
      repeating-linear-gradient(
        to right,
        color-mix(in srgb, var(--clr-white-08) 50%, transparent) 0 1px,
        transparent 1px fluid(20, 28)
      ),
      repeating-linear-gradient(
        to bottom,
        color-mix(in srgb, var(--clr-white-08) 50%, transparent) 0 1px,
        transparent 1px fluid(20, 28)
      );
    border: 1px solid var(--clr-border-default);

    opacity: 0;
    filter: blur(12px);
    max-height: 76vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    transform: translate3d(0, fluid(48, 72), 0) scale(0.985);
    transition:
      transform calc(var(--duration-default) + 0.04s) var(--modal-enter-ease),
      opacity calc(var(--duration-default) + 0.04s) var(--modal-enter-ease),
      filter calc(var(--duration-default) + 0.04s) var(--modal-enter-ease);
    will-change: transform, opacity, filter;
  }

  &__thumbnail {
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;

    video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  &__content-wrap {
    overflow: hidden;
    position: relative;
    isolation: isolate;

    > * {
      position: relative;
      z-index: 1;
    }
  }

  &__header {
    min-width: 0;
    display: grid;
    gap: var(--gutter-xs);
  }

  &__title {
    color: var(--clr-text-title);
    @include font("f-heading-1");
    font-weight: 700;
  }

  &__content {
    &-title {
      color: var(--clr-text-title);
      @include font("f-heading-2");
      font-weight: 400;
    }

    &__overview {
      padding: var(--gutter-xl);
      display: flex;
      gap: var(--gutter-sm);
      flex-direction: column;
    }

    &-description {
      color: var(--clr-text-body);
      @include font("f-body-3");
    }

    &__image {
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }
  }

  &__award {
    display: inline-flex;
    align-items: center;
    gap: var(--gutter-xs);
    color: var(--clr-text-body);
    @include font("f-body-2");

    img {
      width: fluid(20, 36);
      height: fluid(20, 36);
      object-fit: contain;
      flex-shrink: 0;
    }

    span {
      @include font("f-body-3");
      font-family: var(--family-en-title);
    }
  }

  &__close {
    position: absolute;
    top: fluid(16, 24);
    right: fluid(16, 24);
    z-index: 2;
    width: fluid(36, 40);
    height: fluid(36, 40);
    --corner-bracket-size: var(--modal-close-corner-size);
  }

  &__button {
    min-width: fluid(152, 188);
  }

  &__info {
    margin-top: var(--gutter-2xl);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

    &-list {
      display: grid;
      gap: var(--gutter-xs);
    }

    &-item {
      display: grid;
      grid-template-columns: fluid(84, 120) 1fr;
      gap: var(--gutter-sm);
      align-items: start;
    }

    &-label {
      color: var(--clr-text-body);
      @include font("f-body-3");
      font-family: var(--family-ui);
      width: fluid(84, 120);
      flex-shrink: 0;
      display: block;
    }

    &-sub-list {
      display: flex;
      flex-wrap: wrap;
      gap: fluid(6, 10);
    }

    &-sub-text,
    &-client,
    &-time {
      color: var(--clr-text-title);
      @include font("f-body-1");
    }
  }

  &.is-open {
    pointer-events: auto;

    #{$root}__backdrop {
      opacity: 1;
      visibility: visible;
    }

    #{$root}__panel {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  &.is-closing {
    pointer-events: none;

    #{$root}__panel {
      opacity: 0;
      filter: blur(10px);
      transform: translate3d(0, fluid(56, 84), 0) scale(0.985);
    }

    #{$root}__backdrop {
      opacity: 0;
      visibility: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{$root}__backdrop,
    #{$root}__panel {
      transition: none;
    }
  }

  @include mq(md) {
    &__panel {
      max-height: 88vh;
    }

    &__info {
      flex-direction: column;
      gap: var(--gutter-md);
    }

    &__button {
      min-width: 0;
      width: 100%;
    }
  }

  @include mq(sm) {
    &__top {
      padding: var(--gutter-md);
    }

    &__content {
      &__overview {
        padding: var(--gutter-md);
      }
    }
  }
}
