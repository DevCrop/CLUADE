@use "sass:map";
@use "sass:math";
@use "sass:meta";
@use "sass:string";

@use "./variables" as var;

@use "./functions" as func;

@use "./headings" as heading;

@mixin mq($key-or-size, $direction: "max") {
  @if (meta.type-of($key-or-size) == "string") {
    $size: map.get(var.$containers, $key-or-size);

    @media (#{$direction}-width: #{$size}px) {
      @content;
    }
  } @else if (meta.type-of($key-or-size) == "number") {
    @media (#{$direction}-width: #{$key-or-size}px) {
      @content;
    }
  } @else {
    @error "No found breakpoint: #{$key-or-size}";
  }
}

@mixin pos-full() {
  position: absolute;

  top: 0;

  left: 0;

  width: 100%;

  height: 100%;
}

@mixin pos-center() {
  position: absolute;

  top: 50%;

  left: 50%;

  transform: translate(-50%, -50%);

  width: 100%;

  height: 100%;
}

@mixin set-fluid($map) {
  @each $key, $val in $map {
    $min: map.get($val, "min");
    $max: map.get($val, "max");

    #{$key}: #{func.fluid($min, $max)};
  }
}

@mixin section-fluid-by-map($map) {
  $min: map.get($map, "min");

  $max: map.get($map, "max");

  $max-w: map.get($map, "max-width");

  $min-w: map.get($map, "min-width");

  padding-bottom: #{func.fluid($min, $max, $min-w, $max-w)};

  padding-top: #{func.fluid($min, $max, $min-w, $max-w)};
}

@mixin fs-static-by-map($map) {
  $base: map.get($map, "base");

  $fw: map.get($map, "fw");

  $lh: map.get($map, "lh");

  $ls: map.get($map, "ls");

  $ff: map.get($map, "ff");

  @if ($base != null) {
    font-size: func.pxToRem($base);
  }

  @if ($fw != null) {
    font-weight: $fw;
  }

  @if ($lh != null) {
    line-height: $lh;
  }
  @if ($ff != null) {
    font-family: $ff;
  }

  @if ($ls != null) {
    letter-spacing: func.pxToRem($ls);
  }

  @each $con-key, $con-val in var.$containers {
    $breakpoint: map.get($map, $con-key);

    @if ($breakpoint != null) {
      @include mq($con-key) {
        font-size: func.pxToRem($breakpoint);
      }
    }
  }
}

@mixin fs-fluid-by-map($map) {
  $min: map.get($map, "min");

  $max: map.get($map, "max");

  $max-w: map.get($map, "max-width");

  $min-w: map.get($map, "min-width");

  $lh: map.get($map, "lh");

  $fw: map.get($map, "fw");

  $ls: map.get($map, "ls");

  $ff: map.get($map, "ff");

  font-size: #{func.fluid($min, $max, $min-w, $max-w)};

  @if ($lh != null) {
    line-height: $lh;
  }

  @if ($fw != null) {
    font-weight: $fw;
  }

  @if ($ls != null) {
    letter-spacing: func.pxToRem($ls);
  }

  @if ($ff != null) {
    font-family: $ff;
  }
}

@mixin fs-fluid($min, $max, $min-width: null, $max-width: null) {
  font-size: #{func.fluid($min, $max, $min-width, $max-width)};
}

@mixin fs-static($fs, $key: "null") {
  @if ($key == "null") {
    font-size: $fs;
  } @else {
    @include mq($key) {
      font-size: $fs;
    }
  }
}

@mixin mq-max($key-or-size) {
  @include mq($key-or-size, "max") {
    @content;
  }
}

@mixin mq-min($key-or-size) {
  @include mq($key-or-size, "min") {
    @content;
  }
}

@mixin flex-center() {
  display: flex;

  align-items: center;

  justify-content: center;
}

@mixin blind() {
  position: absolute;

  clip: rect(0 0 0 0);

  width: 1px;

  height: 1px;

  margin: -1px;

  overflow: hidden;
}

@mixin line-clamp($line) {
  overflow: hidden;

  text-overflow: ellipsis;

  -webkit-box-orient: vertical;

  display: -webkit-box;

  -webkit-line-clamp: $line;
}

@mixin img-cover() {
  width: 100%;

  height: 100%;

  object-fit: cover;
}

@mixin img-auto-cover($percent: 56.25%) {
  position: relative;

  overflow: hidden;

  height: 0;

  padding-bottom: $percent;

  img {
    @include pos-full();

    object-fit: cover;
  }
}

@mixin backdrop($opacity: 0.45) {
  @include pos-full();

  background: rgba(0, 0, 0, $opacity);
}

/// @deprecated 코너는 실 요소(components/corner-bracket partial + .no-corner-bracket)로 통일. 마그네틱 코너와 동일 8-path SVG 형식 사용.
@mixin corner-bracket(
  $inset: -2px,
  $padding: 2px,
  $border-color: var(--clr-border-strong),
  $cut-size: 10px
) {
  content: "";
  position: absolute;
  box-sizing: border-box;
  inset: $inset;
  padding: $padding;
  border: 2px solid $border-color;
  background: transparent content-box;
  mask:
    conic-gradient(#000 0 0) content-box,
    conic-gradient(at #{$cut-size} #{$cut-size}, #0000 75%, #000 0) 0 0 /
      calc(100% - #{$cut-size}) calc(100% - #{$cut-size});
  -webkit-mask:
    conic-gradient(#000 0 0) content-box,
    conic-gradient(at #{$cut-size} #{$cut-size}, #0000 75%, #000 0) 0 0 /
      calc(100% - #{$cut-size}) calc(100% - #{$cut-size});
  mask-composite: exclude;
  -webkit-mask-composite: xor;
  backface-visibility: hidden;
  pointer-events: none;
}

/// @deprecated 실 요소 코너 사용 시 transition은 해당 컴포넌트 SCSS에서 지정.
@mixin corner-bracket-motion() {
  transition:
    inset var(--transition-default),
    padding var(--transition-default),
    border-color var(--transition-default);
  will-change: inset, padding;
}

/// @deprecated 실 요소 코너 사용 시 hover/focus 스타일은 해당 컴포넌트 SCSS에서 .no-corner-bracket 등으로 지정.
@mixin corner-bracket-hover(
  $inset: -8px,
  $padding: 8px,
  $border-color: var(--clr-trigger-default)
) {
  inset: $inset;
  padding: $padding;
  border-color: $border-color;
}

@mixin font($name) {
  $without-prefix: string.slice($name, 3);
  $last-dash-idx: 0;

  @for $i from 1 through string.length($without-prefix) {
    @if string.slice($without-prefix, $i, $i) == "-" {
      $last-dash-idx: $i;
    }
  }

  $category: string.slice($without-prefix, 1, $last-dash-idx - 1);
  $key: string.slice($without-prefix, $last-dash-idx + 1);

  $type-map: map.get(heading.$fluid-typography, $category);

  @if ($type-map == null) {
    @error "Unknown font category '#{$category}' in '#{$name}'";
  }

  $val: map.get($type-map, $key);

  @if ($val == null) {
    @error "Unknown font key '#{$key}' in category '#{$category}'";
  }

  @include fs-fluid-by-map($val);
}

@mixin tag-rect() {
  display: flex;
  align-items: center;
  gap: fluid(6, 8);

  &::before {
    content: "";
    flex-shrink: 0;
    width: fluid(3, 4);
    height: fluid(3, 4);
    background: currentColor;
    opacity: 0.6;
  }
}
