@use "../abstract" as *;

// ==============================================
// 공통 상세 페이지 레이아웃 (단일 컬럼, 확장용)
// ==============================================

.no-detail-view-wrap {
  padding-top: fluid(24, 48);
  padding-bottom: fluid(48, 80);
}

.no-detail-view {
  width: 100%;
  max-width: 100%;
  padding-left: var(--gutter-md);
  padding-right: var(--gutter-md);

  &__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: fluid(12, 16);
    margin-bottom: fluid(16, 24);
  }

  &__meta {
    display: flex;
    align-items: center;
    gap: fluid(12, 20);
    flex-wrap: wrap;
  }

  &__tag {
    display: inline-block;
    padding: 0.2em 0.6em;
    font-size: fluid(12, 14);
    font-family: var(--font-button-link);
    border: 1px solid var(--clr-ui-body);
    color: var(--clr-ui-body);
  }

  &__share {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--clr-ui-body);
    text-decoration: none;
    font-size: fluid(14, 16);

    &:hover {
      text-decoration: underline;
    }

    &:focus-visible {
      outline: 2px solid var(--clr-ui-body);
      outline-offset: 2px;
    }
  }

  &__title {
    width: 100%;
    margin-top: 0;
    margin-bottom: fluid(8, 12);
    color: var(--clr-ui-body);
    line-height: 1.25;
  }

  &__date {
    width: 100%;
    margin: 0;
    color: var(--clr-gray-500);
    font-size: fluid(14, 16);
  }

  &__separator {
    height: 1px;
    width: 100%;
    background: var(--clr-gray-200);
    margin: fluid(24, 40) 0;
  }

  &__hero {
    width: 100%;
    margin-bottom: fluid(24, 40);
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
      vertical-align: middle;
    }
  }

  &__body {
    width: 100%;
    color: var(--clr-ui-body);
    font-size: fluid(14, 18);
    line-height: 1.7;

    p {
      margin-top: 0;
      margin-bottom: 1em;
    }

    p:last-child {
      margin-bottom: 0;
    }

    h2,
    h3 {
      margin-top: 1.5em;
      margin-bottom: 0.5em;
      font-weight: 600;
    }

    blockquote {
      margin: 1.5em 0;
      padding-left: 1em;
      border-left: 3px solid var(--clr-gray-400);
      color: var(--clr-gray-600);
    }
  }
}
