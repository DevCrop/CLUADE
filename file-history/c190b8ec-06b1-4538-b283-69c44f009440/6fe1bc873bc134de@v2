export function resolveWorksAuthorMode(): boolean {
  return EnvSetup.hasQueryFlag(WORKS_THEATRE_QUERY_KEY, "1");
}

function hasWorksTheatreSheetState(value: unknown): boolean {
  if (value == null || typeof value !== "object" || Array.isArray(value)) {
    return false;
  }
  const state = value as Record<string, unknown>;
  const sheetsById = state.sheetsById;
  if (sheetsById == null || typeof sheetsById !== "object" || Array.isArray(sheetsById)) {
    return false;
  }
  return Object.prototype.hasOwnProperty.call(sheetsById, "works");
}

export function readWorksTheatreConfigSource(): WorksIntroTheatreConfig {
  const configState = worksIntroState as unknown as WorksIntroTheatreConfig;
  if (Array.isArray(configState.steps) && configState.steps.length > 0) {
    return {
      steps: configState.steps.map((step) => ({
        sheetId: "works",
        progressStart: step.progressStart,
        progressEnd: step.progressEnd,
        durationMs: Math.max(step.durationMs, WORKS_INTRO_DEFAULT_DURATION_MS),
      })),
    };
  }
  if (hasWorksTheatreSheetState(worksIntroState)) {
    return {
      steps: [
        {
          sheetId: "works",
          progressStart: 0,
          progressEnd: 1,
          durationMs: WORKS_INTRO_DEFAULT_DURATION_MS,
        },
      ],
    };
  }
  return { steps: [] };
}
