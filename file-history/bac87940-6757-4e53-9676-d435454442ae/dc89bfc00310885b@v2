    head.querySelectorAll<HTMLElement>(".mask-target"),
  );
  textItems.forEach((item) => TextReveal.setVisibleOff(item));
}

const MAIN_PORTFOLIO_FALLBACK_VIDEO = "/resource/video/why_video_1.mp4";

const _portfolioHoverCleanups: Array<() => void> = [];

(function initPortfolioHover(): void {
  const items = document.querySelectorAll<HTMLLIElement>(
    ".no-main-portfolio__item[data-video]",
  );
  items.forEach((li) => {
    const videoUrl = li.dataset.video || MAIN_PORTFOLIO_FALLBACK_VIDEO;
    const figure = li.querySelector<HTMLElement>(".no-sub-gallery-item__img");
    const video = li.querySelector<HTMLVideoElement>("video");
    if (!figure || !video) return;

    let isHovered = false;
    let pendingPlay: Promise<void> | null = null;

    const show = (): void => {
      if (isHovered) figure.classList.add("is-video-active");
    };
    const hideNow = (): void => {
      figure.classList.remove("is-video-active");
    };
    const safePause = (): void => {
      video.pause();
      video.currentTime = 0;
    };
    const drainAndPause = (): void => {
      const p = pendingPlay;
      pendingPlay = null;
      if (p !== null) {
        void p.then(() => {
          if (!isHovered) safePause();
        });
      } else {
        safePause();
      }
    };

    const onEnter = (): void => {
      isHovered = true;
      if (!video.src) {
        video.src = videoUrl;
        video.load();
      }
      pendingPlay = video.play().catch(() => undefined);
      if (video.readyState >= 3) {
        show();
      } else {
        video.addEventListener("canplay", show, { once: true });
      }
    };
    const onLeave = (): void => {
      isHovered = false;
      video.removeEventListener("canplay", show);
      hideNow();
      drainAndPause();
    };

    li.addEventListener("pointerenter", onEnter);
    li.addEventListener("pointerleave", onLeave);
    _portfolioHoverCleanups.push(() => {
      isHovered = false;
      video.removeEventListener("canplay", show);
      figure.classList.remove("is-video-active");
      drainAndPause();
      li.removeEventListener("pointerenter", onEnter);
      li.removeEventListener("pointerleave", onLeave);
    });
  });
})();

function syncClientItems(progress: number): void {
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(CLIENT_ITEM_SELECTOR),
  );
  if (items.length === 0) return;

  const shouldShow =
    progress >= CLIENT_REVEAL_START && progress < CLIENT_REVEAL_END;
  if (mainSceneDomState.isClientItemsVisible === shouldShow) return;
  mainSceneDomState.isClientItemsVisible = shouldShow;
  mainSceneDomState.clientItemTimers = clearTimers(
    mainSceneDomState.clientItemTimers,
  );

  const queue = shouldShow ? items : items.slice().reverse();
  queue.forEach((item, index) => {
    const timerId = window.setTimeout(
      () => {
        item.classList.add(INIT_DOM_CLASSES.blockBase);
        item.classList.remove(INIT_DOM_CLASSES.boxHidden);
        item.classList.remove("is-block-reveal-down");
        if (shouldShow) {
          BlockReveal.reveal(item);
          return;
        }
        item.classList.remove(INIT_DOM_CLASSES.blockUp);
        item.classList.add("is-block-reveal-down");
      },
      index * CLIENT_REVEAL_STAGGER_SECONDS * 1000,
    );
    mainSceneDomState.clientItemTimers.push(timerId);
  });
}

function disposeClientItems(): void {
  mainSceneDomState.isClientItemsVisible = false;
  mainSceneDomState.clientItemTimers = clearTimers(
    mainSceneDomState.clientItemTimers,
  );
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(CLIENT_ITEM_SELECTOR),
  );
  items.forEach((item) => {
    item.classList.add(INIT_DOM_CLASSES.blockBase);
    item.classList.remove(INIT_DOM_CLASSES.blockUp, "is-block-reveal-down");
    item.classList.add(INIT_DOM_CLASSES.boxHidden);
  });
}

function syncContactHead(progress: number): void {
  const section = document.querySelector<HTMLElement>(CONTACT_SECTION_SELECTOR);
  const head = document.querySelector<HTMLElement>(CONTACT_HEAD_SELECTOR);
  const actions = document.querySelector<HTMLElement>(CONTACT_ACTIONS_SELECTOR);
  if (!section || !head || !actions) return;
  const textItems = Array.from(
    head.querySelectorAll<HTMLElement>(".mask-target"),
  );
  const actionItems = Array.from(
    document.querySelectorAll<HTMLElement>(CONTACT_ACTION_ITEM_SELECTOR),
  );
  // Keep the contact panel visible through the footer zone and hide it only
  // when the scene is left or rewound before the reveal threshold.
  const shouldShow = progress >= CONTACT_HEAD_TRANSITION.revealStart;

  if (mainSceneDomState.isContactActionsVisible !== shouldShow) {
    mainSceneDomState.isContactActionsVisible = shouldShow;
    mainSceneDomState.contactActionTimers = clearTimers(
      mainSceneDomState.contactActionTimers,
    );
    const queue = shouldShow ? actionItems : actionItems.slice().reverse();
    const delayStep = shouldShow
      ? CONTACT_HEAD_TRANSITION.revealStagger
      : CONTACT_HEAD_TRANSITION.hideStagger;
    queue.forEach((item, index) => {
      const timerId = window.setTimeout(
        () => {
          item.classList.add(INIT_DOM_CLASSES.blockBase);
          item.classList.remove(INIT_DOM_CLASSES.boxHidden);
          if (shouldShow) {
            item.classList.remove("is-block-reveal-down");
            BlockReveal.reveal(item);
            return;
          }
          item.classList.remove(INIT_DOM_CLASSES.blockUp);
          item.classList.add("is-block-reveal-down");
        },
        index * delayStep * 1000,
      );
      mainSceneDomState.contactActionTimers.push(timerId);
    });
  }

  if (mainSceneDomState.isContactHeadVisible === shouldShow) return;
  mainSceneDomState.isContactHeadVisible = shouldShow;
  mainSceneDomState.contactHeadTimers = clearTimers(
    mainSceneDomState.contactHeadTimers,
  );

  if (shouldShow) {
    section.dataset.active = "true";
    head.dataset.active = "true";
    actions.dataset.active = "true";
    TextReveal.setVisibleOff(textItems);
    textItems.forEach((item, index) => {
      const timerId = window.setTimeout(
        () => {
          TextReveal.setVisibleOn(item);
        },
        index * CONTACT_HEAD_TRANSITION.revealStagger * 1000,
      );
      mainSceneDomState.contactHeadTimers.push(timerId);
    });
    return;
  }

  textItems
    .slice()
    .reverse()
    .forEach((item, index) => {
      const timerId = window.setTimeout(
        () => {
          TextReveal.setVisibleOff(item);
        },
        index * CONTACT_HEAD_TRANSITION.hideStagger * 1000,
      );
      mainSceneDomState.contactHeadTimers.push(timerId);
    });

  const hideTimerId = window.setTimeout(
    () => {
      section.dataset.active = "false";
      head.dataset.active = "false";
      actions.dataset.active = "false";
    },
    (Math.max(textItems.length - 1, 0) *
      CONTACT_HEAD_TRANSITION.hideStagger +
      CONTACT_HEAD_TRANSITION.hideSettleDuration) *
      1000,
  );
  mainSceneDomState.contactHeadTimers.push(hideTimerId);
}

function disposeContactHead(): void {
  mainSceneDomState.isContactHeadVisible = false;
  mainSceneDomState.contactHeadTimers = clearTimers(
    mainSceneDomState.contactHeadTimers,
  );
  mainSceneDomState.isContactActionsVisible = false;
  mainSceneDomState.contactActionTimers = clearTimers(
    mainSceneDomState.contactActionTimers,
  );
  const section = document.querySelector<HTMLElement>(CONTACT_SECTION_SELECTOR);
  const head = document.querySelector<HTMLElement>(CONTACT_HEAD_SELECTOR);
  const actions = document.querySelector<HTMLElement>(CONTACT_ACTIONS_SELECTOR);
  if (!section || !head || !actions) return;
  section.dataset.active = "false";
  head.dataset.active = "false";
  actions.dataset.active = "false";
  const textItems = Array.from(
    head.querySelectorAll<HTMLElement>(".mask-target"),
  );
  textItems.forEach((item) => TextReveal.setVisibleOff(item));
  const actionItems = Array.from(
    document.querySelectorAll<HTMLElement>(CONTACT_ACTION_ITEM_SELECTOR),
  );
  actionItems.forEach((item) => {
    item.classList.add(INIT_DOM_CLASSES.blockBase);
    item.classList.remove(INIT_DOM_CLASSES.blockUp, "is-block-reveal-down");
    item.classList.add(INIT_DOM_CLASSES.boxHidden);
  });
}

