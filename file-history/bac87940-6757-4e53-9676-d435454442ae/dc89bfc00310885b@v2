function clearTimers(timerIds: number[]): number[] {
  timerIds.forEach((timerId) => {
    window.clearTimeout(timerId);
  });
  return [];
}

const STORY_STAT_SELECTOR = "[data-count-to]";
const STORY_COUNT_TRIGGER = 0.12;
const STORY_STAT_DURATION = 1800;
const STORY_STAT_STAGGER = 150;

function triggerStoryStats(): void {
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(STORY_STAT_SELECTOR),
  );
  if (!items.length) return;

  items.forEach((el, i) => {
    const target = Number(el.dataset.countTo ?? 0);
    let startTime: number | null = null;

    function tick(ts: number): void {
      if (startTime === null) startTime = ts;
      const t = Math.min((ts - startTime) / STORY_STAT_DURATION, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(eased * target).toString();
      if (t < 1) requestAnimationFrame(tick);
    }

    window.setTimeout(() => requestAnimationFrame(tick), i * STORY_STAT_STAGGER);
  });
}

function syncWhoScene(progress: number): void {
  const textItems = Array.from(
    document.querySelectorAll<HTMLElement>(WHO_TEXT_SELECTOR),
  );
  if (textItems.length === 0) return;

  const shouldShow = progress >= WHO_REVEAL_START && progress < WHO_REVEAL_END;
  if (mainSceneDomState.isWhoTextVisible === shouldShow) return;
  mainSceneDomState.isWhoTextVisible = shouldShow;
  mainSceneDomState.whoTextTimers = clearTimers(
    mainSceneDomState.whoTextTimers,
  );

  const items = shouldShow ? textItems : textItems.slice().reverse();
  items.forEach((item, index) => {
    const timerId = window.setTimeout(
      () => {
        if (shouldShow) {
          TextReveal.setVisibleOn(item);
          return;
        }
        TextReveal.setVisibleOff(item);
      },
      index * WHO_REVEAL_STAGGER_SECONDS * 1000,
    );
    mainSceneDomState.whoTextTimers.push(timerId);
  });
}

function disposeWhoScene(): void {
  mainSceneDomState.isWhoTextVisible = false;
  mainSceneDomState.whoTextTimers = clearTimers(
    mainSceneDomState.whoTextTimers,
  );
  const textItems = Array.from(
    document.querySelectorAll<HTMLElement>(WHO_TEXT_SELECTOR),
  );
  textItems.forEach((item) => TextReveal.setVisibleOff(item));
}



function syncWorksDetailHead(progress: number): void {
  const head = document.querySelector<HTMLElement>(WORKS_DETAIL_HEAD_SELECTOR);
  if (!head) return;
  const textItems = Array.from(
    head.querySelectorAll<HTMLElement>(".mask-target"),
  );
  const shouldShow =
    progress >= WORKS_DETAIL_HEAD_TRANSITION.revealStart &&
    progress < WORKS_DETAIL_HEAD_TRANSITION.hideStart;

  if (mainSceneDomState.isWorksDetailHeadVisible === shouldShow) return;
  mainSceneDomState.isWorksDetailHeadVisible = shouldShow;
  mainSceneDomState.worksDetailHeadTimers = clearTimers(
    mainSceneDomState.worksDetailHeadTimers,
  );

  if (shouldShow) {
    head.dataset.active = "true";
    TextReveal.setVisibleOff(textItems);
    textItems.forEach((item, index) => {
      const timerId = window.setTimeout(
        () => {
          TextReveal.setVisibleOn(item);
        },
        index * WORKS_DETAIL_HEAD_TRANSITION.revealStagger * 1000,
      );
      mainSceneDomState.worksDetailHeadTimers.push(timerId);
    });
    return;
  }

  textItems
    .slice()
    .reverse()
    .forEach((item, index) => {
      const timerId = window.setTimeout(
        () => {
          TextReveal.setVisibleOff(item);
        },
        index * WORKS_DETAIL_HEAD_TRANSITION.hideStagger * 1000,
      );
      mainSceneDomState.worksDetailHeadTimers.push(timerId);
    });
  const hideTimerId = window.setTimeout(
    () => {
      head.dataset.active = "false";
    },
    (Math.max(textItems.length - 1, 0) *
      WORKS_DETAIL_HEAD_TRANSITION.hideStagger +
      WORKS_DETAIL_HEAD_TRANSITION.hideSettleDuration) *
      1000,
  );
  mainSceneDomState.worksDetailHeadTimers.push(hideTimerId);
}

function disposeWorksDetailHead(): void {
  mainSceneDomState.isWorksDetailHeadVisible = false;
  mainSceneDomState.worksDetailHeadTimers = clearTimers(
    mainSceneDomState.worksDetailHeadTimers,
  );
  const head = document.querySelector<HTMLElement>(WORKS_DETAIL_HEAD_SELECTOR);
