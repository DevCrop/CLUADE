      target: {
        x: state?.camera?.target?.x ?? defaults.camera.target.x,
        y: state?.camera?.target?.y ?? defaults.camera.target.y,
        z: state?.camera?.target?.z ?? defaults.camera.target.z,
      },
      fov: state?.camera?.fov ?? defaults.camera.fov,
    },
    light: {
      visible: state?.light?.visible ?? defaults.light.visible,
      rig: {
        position: {
          x: state?.light?.rig?.position?.x ?? defaults.light.rig.position.x,
          y: state?.light?.rig?.position?.y ?? defaults.light.rig.position.y,
          z: state?.light?.rig?.position?.z ?? defaults.light.rig.position.z,
