export function cloneAboutSceneState(state: AboutSceneState): AboutSceneState {
  return {
    camera: {
      position: { ...state.camera.position },
      target: { ...state.camera.target },
      fov: state.camera.fov,
    },
    light: {
      visible: state.light.visible,
      rig: {
        position: { ...state.light.rig.position },
        rotation: { ...state.light.rig.rotation },
        scale: { ...state.light.rig.scale },
        visible: state.light.rig.visible,
      },
      travelProgress: state.light.travelProgress,
      intensity: state.light.intensity,
      ambientLight: state.light.ambientLight,
      keyLight: state.light.keyLight,
      fillLight: state.light.fillLight,
      rimLight: state.light.rimLight,
    },
    background: {
      position: { ...state.background.position },
      rotation: { ...state.background.rotation },
      scale: { ...state.background.scale },
      visible: state.background.visible,
      exposure: state.background.exposure,
      look: { ...state.background.look },
    },
    earth: {
      position: { ...state.earth.position },
      rotation: { ...state.earth.rotation },
      scale: { ...state.earth.scale },
      visible: state.earth.visible,
    },
    rocket: cloneRocketState(state.rocket),
    jetEngine: cloneJetEngineState(state.jetEngine),
    astronaut: {
      position: { ...state.astronaut.position },
      rotation: { ...state.astronaut.rotation },
      scale: { ...state.astronaut.scale },
      visible: state.astronaut.visible,
    },
    terrian: {
      position: { ...state.terrian.position },
      rotation: { ...state.terrian.rotation },
      scale: { ...state.terrian.scale },
      visible: state.terrian.visible,
    },
    gravityBalls: {
      position: { ...state.gravityBalls.position },
      rotation: { ...state.gravityBalls.rotation },
      scale: { ...state.gravityBalls.scale },
      visible: state.gravityBalls.visible,
    },
  };
}

