function blendAboutRocketFlameState(
  from: MainRocketFlameState,
  to: MainRocketFlameState,
  alpha: number,
): MainRocketFlameState {
  const mix = clampBlendAlpha(alpha);
  return {
    visible: mix < 0.5 ? from.visible : to.visible,
    offset: blendAboutVec3State(from.offset, to.offset, mix),
    rotation: blendAboutVec3State(from.rotation, to.rotation, mix),
    scale: blendAboutVec3State(from.scale, to.scale, mix),
    opacity: blendAboutNumber(from.opacity, to.opacity, mix),
    renderOrder: mix < 0.5 ? from.renderOrder : to.renderOrder,
    speed: blendAboutNumber(from.speed, to.speed, mix),
    wave: blendAboutNumber(from.wave, to.wave, mix),
  };
}

function blendAboutRocketState(
  from: MainRocketState,
  to: MainRocketState,
  alpha: number,
): MainRocketState {
  const mix = clampBlendAlpha(alpha);
  return {
    position: blendAboutVec3State(from.position, to.position, mix),
    rotation: blendAboutVec3State(from.rotation, to.rotation, mix),
    scale: blendAboutVec3State(from.scale, to.scale, mix),
    visible: mix < 0.5 ? from.visible : to.visible,
    flame: blendAboutRocketFlameState(from.flame, to.flame, mix),
  };
}

function blendAboutJetEngineState(
  from: MainJetEngineState,
  to: MainJetEngineState,
  alpha: number,
): MainJetEngineState {
  const mix = clampBlendAlpha(alpha);
  return {
    position: blendAboutVec3State(from.position, to.position, mix),
    rotation: blendAboutVec3State(from.rotation, to.rotation, mix),
    scale: blendAboutVec3State(from.scale, to.scale, mix),
    visible: mix < 0.5 ? from.visible : to.visible,
    intensity: blendAboutNumber(from.intensity, to.intensity, mix),
    length: blendAboutNumber(from.length, to.length, mix),
    nozzleRadius: blendAboutNumber(from.nozzleRadius, to.nozzleRadius, mix),
    nozzleGap: blendAboutNumber(from.nozzleGap, to.nozzleGap, mix),
    noise: blendAboutNumber(from.noise, to.noise, mix),
    bloom: blendAboutNumber(from.bloom, to.bloom, mix),
  };
}

export function blendAboutSceneState(
  from: AboutSceneState,
  to: AboutSceneState,
  alpha: number,
): AboutSceneState {
  const mix = clampBlendAlpha(alpha);
  return {
    camera: {
      position: blendAboutVec3State(from.camera.position, to.camera.position, mix),
      target: blendAboutVec3State(from.camera.target, to.camera.target, mix),
      fov: blendAboutNumber(from.camera.fov, to.camera.fov, mix),
    },
    light: {
      visible: mix < 0.5 ? from.light.visible : to.light.visible,
      rig: blendAboutTransformState(from.light.rig, to.light.rig, mix),
      travelProgress: blendAboutNumber(
        from.light.travelProgress,
        to.light.travelProgress,
        mix,
      ),
      intensity: blendAboutNumber(from.light.intensity, to.light.intensity, mix),
      ambientLight: blendAboutNumber(
        from.light.ambientLight,
        to.light.ambientLight,
        mix,
      ),
      keyLight: blendAboutNumber(from.light.keyLight, to.light.keyLight, mix),
      fillLight: blendAboutNumber(from.light.fillLight, to.light.fillLight, mix),
      rimLight: blendAboutNumber(from.light.rimLight, to.light.rimLight, mix),
    },
    background: {
      position: blendAboutVec3State(
        from.background.position,
        to.background.position,
        mix,
      ),
      rotation: blendAboutVec3State(
        from.background.rotation,
        to.background.rotation,
        mix,
      ),
      scale: blendAboutVec3State(from.background.scale, to.background.scale, mix),
      visible: mix < 0.5 ? from.background.visible : to.background.visible,
      exposure: blendAboutNumber(
        from.background.exposure,
        to.background.exposure,
        mix,
      ),
      look: {
        topColor: blendAboutNumber(
          from.background.look.topColor,
          to.background.look.topColor,
          mix,
        ),
        bottomColor: blendAboutNumber(
          from.background.look.bottomColor,
          to.background.look.bottomColor,
          mix,
        ),
        accentColor: blendAboutNumber(
          from.background.look.accentColor,
          to.background.look.accentColor,
          mix,
        ),
        starIntensity: blendAboutNumber(
          from.background.look.starIntensity,
          to.background.look.starIntensity,
          mix,
        ),
        starDensity: blendAboutNumber(
          from.background.look.starDensity,
          to.background.look.starDensity,
          mix,
        ),
        nebulaStrength: blendAboutNumber(
          from.background.look.nebulaStrength,
          to.background.look.nebulaStrength,
          mix,
        ),
        motionStrength: blendAboutNumber(
          from.background.look.motionStrength,
          to.background.look.motionStrength,
          mix,
        ),
        legacyMix: blendAboutNumber(
          from.background.look.legacyMix,
          to.background.look.legacyMix,
          mix,
        ),
      },
    },
    earth: blendAboutTransformState(from.earth, to.earth, mix),
    rocket: blendAboutRocketState(from.rocket, to.rocket, mix),
    jetEngine: blendAboutJetEngineState(from.jetEngine, to.jetEngine, mix),
    astronaut: blendAboutTransformState(from.astronaut, to.astronaut, mix),
    terrian: blendAboutTransformState(from.terrian, to.terrian, mix),
    gravityBalls: blendAboutTransformState(
      from.gravityBalls,
      to.gravityBalls,
      mix,
    ),
  };
}

export function pickAboutTheatreValue(
  state: AboutSceneState,
): AboutTheatreValue {
  return {
    camera: {
      position: { ...state.camera.position },
      target: { ...state.camera.target },
      fov: state.camera.fov,
    },
    light: {
      visible: state.light.visible,
      rig: {
        position: { ...state.light.rig.position },
        rotation: { ...state.light.rig.rotation },
        scale: { ...state.light.rig.scale },
        visible: state.light.rig.visible,
      },
      travelProgress: state.light.travelProgress,
      intensity: state.light.intensity,
      ambientLight: state.light.ambientLight,
      keyLight: state.light.keyLight,
      fillLight: state.light.fillLight,
      rimLight: state.light.rimLight,
    },
    earth: mergeAboutTransformState(state.earth, state.earth),
    rocket: cloneRocketState(state.rocket),
    jetEngine: cloneJetEngineState(state.jetEngine),
    astronaut: mergeAboutTransformState(state.astronaut, state.astronaut),
    terrian: mergeAboutTransformState(state.terrian, state.terrian),
  };
}

export function mergeAboutTheatreValue(
  value?: Partial<AboutTheatreValue> | null,
): AboutSceneState {
  const defaults = ABOUT_DEFAULT_SCENE_STATE;
  return mergeAboutSceneState({
    camera: value?.camera,
    light: value?.light
      ? {
          ...defaults.light,
          ...value.light,
          rig: value.light.rig
            ? mergeAboutTransformState(value.light.rig, defaults.light.rig)
            : defaults.light.rig,
        }
      : undefined,
    earth: value?.earth,
    rocket: value?.rocket,
    jetEngine: value?.jetEngine,
    astronaut: value?.astronaut,
    terrian: value?.terrian,
  });
}

function mergeAboutTransformState(
  state: Partial<AboutSceneState["earth"]> | null | undefined,
  defaults: AboutSceneState["earth"],
): AboutSceneState["earth"] {
  return {
    position: {
      x: state?.position?.x ?? defaults.position.x,
      y: state?.position?.y ?? defaults.position.y,
      z: state?.position?.z ?? defaults.position.z,
    },
    rotation: {
      x: state?.rotation?.x ?? defaults.rotation.x,
      y: state?.rotation?.y ?? defaults.rotation.y,
      z: state?.rotation?.z ?? defaults.rotation.z,
    },
    scale: {
      x: state?.scale?.x ?? defaults.scale.x,
      y: state?.scale?.y ?? defaults.scale.y,
      z: state?.scale?.z ?? defaults.scale.z,
    },
    visible: state?.visible ?? defaults.visible,
  };
}

function blendAboutTransformState(
  from: AboutSceneState["earth"],
  to: AboutSceneState["earth"],
  alpha: number,
): AboutSceneState["earth"] {
  return {
    position: blendAboutVec3State(from.position, to.position, alpha),
    rotation: blendAboutVec3State(from.rotation, to.rotation, alpha),
    scale: blendAboutVec3State(from.scale, to.scale, alpha),
    visible: alpha < 0.5 ? from.visible : to.visible,
  };
}

function blendAboutVec3State(
  from: AboutSceneState["camera"]["position"],
  to: AboutSceneState["camera"]["position"],
  alpha: number,
): AboutSceneState["camera"]["position"] {
  return {
    x: blendAboutNumber(from.x, to.x, alpha),
    y: blendAboutNumber(from.y, to.y, alpha),
    z: blendAboutNumber(from.z, to.z, alpha),
  };
}

function blendAboutNumber(from: number, to: number, alpha: number): number {
  const mix = clampBlendAlpha(alpha);
  return from + (to - from) * mix;
}

function clampBlendAlpha(alpha: number): number {
  if (!Number.isFinite(alpha)) return 0;
  if (alpha <= 0) return 0;
  if (alpha >= 1) return 1;
  return alpha;
}
