          x: state?.light?.rig?.scale?.x ?? defaults.light.rig.scale.x,
          y: state?.light?.rig?.scale?.y ?? defaults.light.rig.scale.y,
          z: state?.light?.rig?.scale?.z ?? defaults.light.rig.scale.z,
        },
        visible: state?.light?.rig?.visible ?? defaults.light.rig.visible,
      },
      travelProgress:
        state?.light?.travelProgress ?? defaults.light.travelProgress,
      intensity: state?.light?.intensity ?? defaults.light.intensity,
      ambientLight: state?.light?.ambientLight ?? defaults.light.ambientLight,
      keyLight: state?.light?.keyLight ?? defaults.light.keyLight,
