}

export type RGB = [number, number, number];

export interface JetEngineObjectOptions extends BaseObjectOptions {
  /** Scene object id to parent under (e.g. `"rocket"`). Uses animation root. */
  attachTo?: string;
  offset?: Vector3Optional;
  /** Nozzle radius; affects mesh layout (rebuild). */
  nozzleRadius?: number;
  /** Grid spacing multiplier (same on X/Z). */
  nozzleGap?: number;
  /** Core plume length; outer shell scales from this (fixed ratio). */
  length?: number;
  /** Overall brightness / idle level for the combustion sim. */
  intensity?: number;
  /** Single dial: scales inner/parent noise + turbulence in shaders. */
  noise?: number;
  /** Core flame tint; tip is derived darker in shader prepass. */
  innerColor?: RGB;
  /** Outer plume tint. */
  outerColor?: RGB;
  /** Bloom multiplier (inner + outer glow). */
  bloom?: number;
}

export type JetEngineTweenProps = ObjectTweenProps<
