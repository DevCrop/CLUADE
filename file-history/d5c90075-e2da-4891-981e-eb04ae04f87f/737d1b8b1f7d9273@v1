/* =======================================================
 * WORKS
 * ======================================================= */
$router->group(['prefix' => '/works'], function ($r) use (
    $loadWorksApi,
    $resolveWorksView,
    $resolvePositiveInt,
    $renderWorksDetailPage
) {
    $r->get('', function (Request $req) use ($loadWorksApi, $resolveWorksView, $resolvePositiveInt) {
        $loadWorksApi();

        $view = $resolveWorksView($req);
        $category = resolve_works_category($req->query('category'));
        $perPage = 12;
        $page = $resolvePositiveInt($req->query('page', 1), 1);

        return render('pages.works.index', [
            'pageType' => 'works',
            'pageNamespace' => 'works-index',
            'worksState' => [
                'view' => $view,
                'category' => $category,
                'page' => $page,
                'limit' => $perPage,
            ],
            'worksCategories' => get_works_categories(),
        ]);
    })->name('works.index');
    $r->get('/list', function (Request $req) use ($loadWorksApi, $resolvePositiveInt) {
        $loadWorksApi();

        $offsetRaw = $req->query('offset', 0);
        $limitRaw = $req->query('limit', 8);
        $category = resolve_works_category($req->query('category'));
        $offsetValidated = filter_var($offsetRaw, FILTER_VALIDATE_INT);
        $limitValidated = filter_var($limitRaw, FILTER_VALIDATE_INT);
        if ($offsetValidated === false || $limitValidated === false) {
            return (new Response())->json([
                'error' => 'Invalid pagination parameters',
                'code' => 'INVALID_QUERY',
            ], 400);
        }

        $offset = max(0, (int) $offsetValidated);
        $limit = $resolvePositiveInt($limitValidated, 8, 1, 24);
        $data = get_works_list($offset, $limit, $category);

        return (new Response())->json([
            'items' => $data['items'],
            'nextOffset' => $data['nextOffset'],
            'hasMore' => $data['hasMore'],
        ], 200);
    })->name('works.list');
    $r->get('/view/{no}', function (Request $req, Response $res, string $no) use ($renderWorksDetailPage) {
        return $renderWorksDetailPage('pages.works.view', $no, 'works-view', 'works-view');
    })->name('works.view');
    $r->get('/modal/{no}', function (Request $req, Response $res, string $no) use ($renderWorksDetailPage) {
        return $renderWorksDetailPage('pages.works.modal', $no, 'works-modal', 'works-modal');
    })->name('works.modal');
    $r->get('/modal-component/{no}', function (Request $req, Response $res, string $no) use ($loadWorksApi) {
        $loadWorksApi();

        $work = get_work_detail($no);
        if ($work === null) {
            return response(
                '<div class="no-work-modal__empty">Work data not found.</div>',
                404,
                ['Content-Type' => 'text/html; charset=UTF-8']
            );
        }

        return response(
            include_view('components.work-modal', ['work' => $work]),
            200,
            ['Content-Type' => 'text/html; charset=UTF-8']
        );
    })->name('works.modal.component');
});

