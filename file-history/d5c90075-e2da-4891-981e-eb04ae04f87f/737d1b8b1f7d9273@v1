/* =======================================================
 * INSIDE
 * ======================================================= */
$insideListHandler = static function (
        Request $req,
        int $boardNo,
        string $viewName,
        string $listRouteName
    ) use ($resolvePositiveInt): string {
        $page = $resolvePositiveInt($req->query('page', 1), 1);
        $categoryRaw = $req->query('category');
        $categoryNo = null;
        if ($categoryRaw !== null && $categoryRaw !== '') {
            $cv = filter_var($categoryRaw, FILTER_VALIDATE_INT);
            if ($cv !== false && (int) $cv > 0) {
                $categoryNo = (int) $cv;
            }
        }
        $q = trim((string) $req->query('q', ''));
        $list = inside_board_list(
            $boardNo,
            $page,
            $categoryNo,
            $q !== '' ? $q : null
        );

        $listUrl = route($listRouteName, [], false);
        $mergeQuery = static function (array $extra) use ($q): array {
            $p = $extra;
            if ($q !== '') {
                $p['q'] = $q;
            }

            return array_filter(
                $p,
                static fn ($v) => $v !== null && $v !== ''
            );
        };

        $categoryItems = [];
        $manage = inside_board_manage($boardNo);
        $catEnabled = ($manage['category_yn'] ?? 'N') === 'Y';
        $allQuery = $mergeQuery([]);
        $categoryItems[] = [
            'label' => 'ALL',
            'href' => $listUrl . ($allQuery !== [] ? '?' . http_build_query($allQuery) : ''),
            'active' => $categoryNo === null,
        ];
        if ($catEnabled) {
            foreach (inside_board_categories($boardNo) as $row) {
                $cn = (int) ($row['no'] ?? 0);
                if ($cn < 1) {
                    continue;
                }
                $cq = $mergeQuery(['category' => $cn]);
                $categoryItems[] = [
                    'label' => (string) ($row['name'] ?? ''),
                    'href' => $listUrl . '?' . http_build_query($cq),
                    'active' => $categoryNo === $cn,
                ];
            }
        }

        $paginationQuery = $mergeQuery([]);

        return render($viewName, [
            'pageType' => 'inside',
            'boardNo' => $boardNo,
            'posts' => $list['rows'],
            'paginationTotal' => $list['totalPages'],
            'paginationCurrent' => $list['page'],
            'paginationQueryParams' => $paginationQuery,
            'categoryItems' => $categoryItems,
            'searchQuery' => $q,
            'listRouteName' => $listRouteName,
            'activeCategoryNo' => $categoryNo,
        ]);
};

$insideViewHandler = static function (string $no, int $boardNo, string $viewName, string $listRouteName, string $viewRouteName) {
        $postNo = filter_var($no, FILTER_VALIDATE_INT);
        if ($postNo === false || $postNo < 1) {
            return response(render('errors.404'), 404);
        }

        $post = inside_board_find((int) $postNo, $boardNo);
        if ($post === null) {
            return response(render('errors.404'), 404);
        }

        $neighbors = inside_board_neighbors((int) $postNo, $boardNo);
        $listUrl = route($listRouteName, [], false);

        $prevUrl = null;
        $prevTitle = '';
        if ($neighbors['prev'] !== null) {
            $prevUrl = route($viewRouteName, ['no' => (string) ($neighbors['prev']['no'] ?? '')], false);
            $prevTitle = (string) ($neighbors['prev']['title'] ?? '');
        }

        $nextUrl = null;
        $nextTitle = '';
        if ($neighbors['next'] !== null) {
            $nextUrl = route($viewRouteName, ['no' => (string) ($neighbors['next']['no'] ?? '')], false);
            $nextTitle = (string) ($neighbors['next']['title'] ?? '');
        }

        return render($viewName, [
            'pageType' => 'inside',
            'boardNo' => $boardNo,
            'post' => $post,
            'listUrl' => $listUrl,
            'prevUrl' => $prevUrl,
            'prevTitle' => $prevTitle,
            'nextUrl' => $nextUrl,
            'nextTitle' => $nextTitle,
        ]);
};

