class WorksPageDomRuntime {
  private readonly _root: ParentNode;

  constructor(root: ParentNode) {
    this._root = root;
  }

  resolve(): WorksPageElements {
    return {
      root: this._queryElement<HTMLElement>(WORK_PAGE_DOM.rootSelector),
      canvas: this._queryCanvasElement(WORK_CANVAS_CONFIG.canvasId),
      grid: this._queryElement<HTMLElement>(WORK_PAGE_DOM.gridSelector),
      gridList: this._queryElement<HTMLUListElement>(
        WORK_PAGE_DOM.gridListSelector,
      ),
      gridPagination: this._queryElement<HTMLElement>(
        WORK_PAGE_DOM.gridPaginationSelector,
      ),
      controls: this._queryElement<HTMLElement>(WORK_PAGE_DOM.controlsSelector),
      toggle: this._queryElement<HTMLElement>(WORK_PAGE_DOM.toggleSelector),
      filterWrap: this._queryElement<HTMLElement>(
        WORK_PAGE_DOM.filterWrapSelector,
      ),
      filterButton: this._queryElement<HTMLButtonElement>(
        WORK_PAGE_DOM.filterButtonSelector,
      ),
      filterPanel: this._queryElement<HTMLElement>(
        WORK_PAGE_DOM.filterPanelSelector,
      ),
      dragHint: this._queryElement<HTMLElement>(WORK_PAGE_DOM.dragHintSelector),
    };
  }

  readState(elements: WorksPageElements): WorksPageState {
    const root = elements.root;
    const viewRaw = root?.dataset.view;
    const view: WorksViewMode =
      viewRaw === "grid" || viewRaw === "scatter"
        ? viewRaw
        : WORK_PAGE_STATE_DEFAULT.view;
    const categoryRaw = root?.dataset.category?.trim() ?? "";
    const pageRaw = Number.parseInt(root?.dataset.page ?? "", 10);
    const limitRaw = Number.parseInt(root?.dataset.limit ?? "", 10);

    return {
      view,
      category: categoryRaw.length > 0 ? categoryRaw : null,
      page:
        Number.isFinite(pageRaw) && pageRaw > 0
          ? pageRaw
          : WORK_PAGE_STATE_DEFAULT.page,
      limit:
        Number.isFinite(limitRaw) && limitRaw > 0
          ? limitRaw
          : WORK_PAGE_STATE_DEFAULT.limit,
    };
  }

  private _queryElement<TElement extends HTMLElement>(
    selector: string,
  ): TElement | null {
    return this._root.querySelector<TElement>(selector);
  }

  private _queryCanvasElement(canvasId: string): HTMLCanvasElement | null {
    return this._root.querySelector<HTMLCanvasElement>(`#${canvasId}`);
  }
}

class WorksProjectsLoader {
  private _fetchAbortController: AbortController | null = null;

  async load(state: WorksPageState): Promise<WorkProjectItem[]> {
    this._fetchAbortController?.abort();
    this._fetchAbortController = new AbortController();
    const signal = this._fetchAbortController.signal;
    const projects: WorkProjectItem[] = [];
    let offset = 0;
    let hasMore = true;

    while (hasMore && projects.length < WORK_CANVAS_CONFIG.totalCards) {
      const remaining = WORK_CANVAS_CONFIG.totalCards - projects.length;
      const response = await fetchWorksList(
        offset,
        Math.min(WORKS_LIST_API_MAX_LIMIT, remaining),
        state.category,
        signal,
      );
      response.items.forEach((item, index) => {
        projects.push(createWorkProjectItem(item, projects.length + index));
      });
      hasMore = response.hasMore;
      offset = response.nextOffset ?? offset + response.items.length;
      if (response.items.length === 0) {
        hasMore = false;
      }
    }

    this._fetchAbortController = null;
    return projects;
  }

  isAbortedError(error: unknown): boolean {
    return error instanceof DOMException && error.name === "AbortError";
  }

  dispose(): void {
    this._fetchAbortController?.abort();
    this._fetchAbortController = null;
  }
}

class WorksPageUiRuntime {
  private readonly _elements: WorksPageElements;
  private _gridEnterRafId: number | null = null;
  private _toggleRevealRafId: number | null = null;
  private _toggleRevealTimeoutId: number | null = null;
  private _dragHintTimeoutId: number | null = null;
  private _dragHintDeactivateTimeoutId: number | null = null;
  private _dragHintExitTimeoutId: number | null = null;

  constructor(elements: WorksPageElements) {
    this._elements = elements;
  }

  applyInitialState(state: WorksPageState): void {
    this.hideViewToggle();
    this.hideDragHint();
    if (state.view === "grid") {
      this.showGrid();
      return;
    }
    this.hideGrid();
  }

  hideIntroIfReady(): void {
    if (!WORK_INTRO_CONFIG.hideWhenReady) return;
    IntroOverlay.hide();
  }

  enterGrid(): void {
    this.hideIntroIfReady();
    this.showGrid();
    this.showViewToggle();
    const grid = this._elements.grid;
    if (!grid) return;
    grid.classList.remove(WORK_PAGE_DOM.gridEnterClass);
    this._gridEnterRafId = FrameScheduler.request(() => {
      this._elements.grid?.classList.add(WORK_PAGE_DOM.gridEnterClass);
      this._gridEnterRafId = null;
    });
  }

  scheduleViewToggleReveal(delayMs: number): void {
    if (this._toggleRevealTimeoutId !== null) {
      window.clearTimeout(this._toggleRevealTimeoutId);
      this._toggleRevealTimeoutId = null;
    }
    if (this._toggleRevealRafId !== null) {
      FrameScheduler.cancel(this._toggleRevealRafId);
      this._toggleRevealRafId = null;
    }
    this._toggleRevealTimeoutId = window.setTimeout(
      () => {
        this._toggleRevealTimeoutId = null;
        this._toggleRevealRafId = FrameScheduler.request(() => {
          this.showViewToggle();
          this._toggleRevealRafId = null;
        });
      },
      Math.max(0, delayMs),
    );
  }

  showViewToggle(): void {
    const controls = this._elements.controls;
    if (!controls) return;
    this._elements.root?.setAttribute("data-ui-ready", "true");
    controls.hidden = false;
    controls.dataset.ready = "true";
    controls.removeAttribute("inert");
    Aria.setHidden(controls, false);
  }

  hideViewToggle(): void {
    const controls = this._elements.controls;
    if (!controls) return;
    this._elements.root?.setAttribute("data-ui-ready", "false");
    controls.hidden = true;
    controls.dataset.ready = "false";
    controls.setAttribute("inert", "");
    Aria.setHidden(controls, true);
  }

  showGrid(): void {
    this._syncViewAttributes("grid");
    const grid = this._elements.grid;
    if (!grid) return;
    grid.hidden = false;
    grid.classList.remove("is-hidden");
    Aria.setHidden(grid, false);
  }

  hideGrid(): void {
    this._syncViewAttributes("scatter");
    const grid = this._elements.grid;
    if (!grid) return;
    grid.hidden = true;
    grid.classList.add("is-hidden");
    Aria.setHidden(grid, true);
  }

  hideCanvas(): void {
    const canvas = this._elements.canvas;
    if (!canvas) return;
    canvas.classList.add("is-hidden");
    Aria.setHidden(canvas, true);
  }

  showCanvas(): void {
    const canvas = this._elements.canvas;
    if (!canvas) return;
    canvas.classList.remove("is-hidden");
    Aria.setHidden(canvas, false);
  }

  syncFilterSelection(
    category: string | null,
    options?: { animateLabel?: boolean },
  ): void {
    const filterButton = this._elements.filterButton;
    const filterPanel = this._elements.filterPanel;
    if (!filterButton || !filterPanel) return;
    const optionNodes = filterPanel.querySelectorAll<HTMLElement>(
      WORK_PAGE_DOM.filterOptionSelector,
    );
    let activeLabel = "전체";
    optionNodes.forEach((option) => {
      const optionCategory = option.dataset.category?.trim() ?? "";
      const isActive =
        (category === null && optionCategory.length === 0) ||
        optionCategory === (category ?? "");
      option.classList.toggle("is-active", isActive);
      option.setAttribute("aria-pressed", isActive ? "true" : "false");
      if (!isActive) return;
      activeLabel =
        option.dataset.label?.trim() || option.textContent?.trim() || "전체";
    });
    const labelElement = filterButton.querySelector<HTMLElement>(
      ".no-works-canvas__filter-button-label",
    );
    if (!labelElement) return;
    const previousLabel = labelElement.textContent ?? "";
    const shouldAnimate =
      options?.animateLabel === true && previousLabel !== activeLabel;

    if (!shouldAnimate) {
      labelElement.textContent = activeLabel;
      return;
    }

    filterButton.classList.remove("is-filter-label-entering");
    filterButton.classList.add("is-filter-label-leaving");
    window.setTimeout(() => {
      labelElement.textContent = activeLabel;
      filterButton.classList.remove("is-filter-label-leaving");
      filterButton.classList.add("is-filter-label-entering");
      window.setTimeout(() => {
        filterButton.classList.remove("is-filter-label-entering");
      }, WORKS_FILTER_TRANSITION_MS);
    }, WORKS_FILTER_TRANSITION_MS);
  }

  syncViewLinks(category: string | null): void {
    const toggle = this._elements.toggle;
    if (!toggle) return;
    const links = toggle.querySelectorAll<HTMLAnchorElement>("a[href]");
    links.forEach((link) => {
      const url = new URL(link.href, window.location.origin);
      const view = url.searchParams.get("view") ?? "scatter";
      url.searchParams.set("view", view);
      if (category) {
        url.searchParams.set("category", category);
      } else {
        url.searchParams.delete("category");
      }
      link.href = `${url.pathname}${url.search}${url.hash}`;
    });
  }

  showDragHint(): void {
    if (!WORK_HINT_CONFIG.enabled) return;
    this._clearDragHintTimers();
    const dragHint = this._elements.dragHint;
    if (!dragHint) return;
    dragHint.hidden = false;
    dragHint.classList.remove(WORK_PAGE_DOM.dragHintHidingClass);
    dragHint.classList.add(WORK_PAGE_DOM.dragHintVisibleClass);
    dragHint.removeAttribute("inert");
    Aria.setHidden(dragHint, false);
    this._dragHintTimeoutId = window.setTimeout(() => {
      this.hideDragHint();
    }, WORK_HINT_CONFIG.autoHideMs);
  }

  showDragHintIfNeeded(state: WorksPageState): void {
    if (!WORK_HINT_CONFIG.enabled) return;
    if (state.view !== "scatter") return;
    this.showDragHint();
  }

  hideDragHint(): void {
    this._clearDragHintTimers();
    const dragHint = this._elements.dragHint;
    if (!dragHint) return;
    dragHint.hidden = false;
    this._dragHintDeactivateTimeoutId = window.setTimeout(() => {
      dragHint.classList.remove(WORK_PAGE_DOM.dragHintVisibleClass);
      dragHint.classList.add(WORK_PAGE_DOM.dragHintHidingClass);
      this._dragHintDeactivateTimeoutId = null;
      this._dragHintExitTimeoutId = window.setTimeout(() => {
        dragHint.setAttribute("inert", "");
        Aria.setHidden(dragHint, true);
        dragHint.classList.remove(WORK_PAGE_DOM.dragHintHidingClass);
        this._dragHintExitTimeoutId = null;
      }, WORK_HINT_CONFIG.exitDurationMs);
    }, WORK_HINT_CONFIG.hideStartDelayMs);
  }

  dispose(): void {
    if (this._gridEnterRafId !== null) {
      FrameScheduler.cancel(this._gridEnterRafId);
      this._gridEnterRafId = null;
    }
    if (this._toggleRevealRafId !== null) {
      FrameScheduler.cancel(this._toggleRevealRafId);
      this._toggleRevealRafId = null;
    }
    if (this._toggleRevealTimeoutId !== null) {
      window.clearTimeout(this._toggleRevealTimeoutId);
      this._toggleRevealTimeoutId = null;
    }
    this._clearDragHintTimers();
    this._resetDragHint();
    this._elements.grid?.classList.remove(WORK_PAGE_DOM.gridEnterClass);
  }

  private _syncViewAttributes(view: WorksViewMode): void {
    this._elements.root?.setAttribute("data-view", view);
    this._elements.toggle?.setAttribute("data-view", view);
  }

  private _clearDragHintTimers(): void {
    if (this._dragHintTimeoutId !== null) {
      window.clearTimeout(this._dragHintTimeoutId);
      this._dragHintTimeoutId = null;
    }
    if (this._dragHintExitTimeoutId !== null) {
      window.clearTimeout(this._dragHintExitTimeoutId);
      this._dragHintExitTimeoutId = null;
    }
    if (this._dragHintDeactivateTimeoutId !== null) {
      window.clearTimeout(this._dragHintDeactivateTimeoutId);
      this._dragHintDeactivateTimeoutId = null;
    }
  }

  private _resetDragHint(): void {
    const dragHint = this._elements.dragHint;
    if (!dragHint) return;
    dragHint.hidden = true;
    dragHint.setAttribute("inert", "");
    dragHint.classList.remove(
      WORK_PAGE_DOM.dragHintVisibleClass,
      WORK_PAGE_DOM.dragHintHidingClass,
    );
    Aria.setHidden(dragHint, true);
  }
}

class WorksGridFeedRuntime {
  private readonly _state: WorksPageState;
  private readonly _elements: WorksPageElements;
  private _feedState: WorksGridFeedState = {
    nextOffset: null,
    hasMore: false,
  };
  private _abortController: AbortController | null = null;
  private _loading = false;
  private _thresholdArmed = true;
  private _bound = false;
  private readonly _videoHoverCleanups: Array<() => void> = [];
  private _category: string | null;
  private _sentinel: HTMLDivElement | null = null;
  private _sentinelObserver: IntersectionObserver | null = null;
  private _filterModal: HTMLDivElement | null = null;
  private readonly _filterModalCleanups: Array<() => void> = [];

  constructor(state: WorksPageState, elements: WorksPageElements) {
    this._state = state;
    this._elements = elements;
    this._category = state.category;
  }

  async init(): Promise<void> {
    const list = this._elements.gridList;
    if (!list) return;
    this._clearList();
    this._feedState = {
      nextOffset: null,
      hasMore: false,
    };
    this._syncRootState();
    this._abortController?.abort();
    this._abortController = new AbortController();
    const grid = this._elements.grid;
    if (grid) grid.dataset.loading = "true";
    try {
      const response = await this._fetchItems(this._resolveInitialOffset());
      this._appendItems(response.items);
      this._feedState = {
        nextOffset: response.nextOffset,
        hasMore: response.hasMore,
      };
      this._syncRootState();
      this._syncPaginationVisibility();
      this._attachSentinel();
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      throw error;
    } finally {
      this._abortController = null;
      if (grid) delete grid.dataset.loading;
    }
  }

  bind(): void {
    if (this._bound) return;
    window.addEventListener("scroll", this._handleScroll, { passive: true });
    this._bound = true;
    this._bindFilterModal();
  }

  dispose(): void {
    if (this._bound) {
      window.removeEventListener("scroll", this._handleScroll);
      this._bound = false;
    }
    this._abortController?.abort();
    this._abortController = null;
    this._loading = false;
    this._thresholdArmed = true;
    this._runVideoHoverCleanups();
    this._detachSentinel();
    this._removeFilterModal();
  }

  async changeCategory(category: string | null): Promise<void> {
    this._category = category;
    this._elements.root?.setAttribute("data-category", category ?? "");
    await this.init();
    this._syncFilterModalSelection(category);
  }

  private readonly _handleScroll = (): void => {
    if (!this._feedState.hasMore) return;
    if (this._loading) return;
    const list = this._elements.gridList;
    if (!list) return;
    const thresholdReached = this._isThresholdReached(list);
    if (!thresholdReached) {
      this._thresholdArmed = true;
      return;
    }
    if (!this._thresholdArmed) return;
    this._thresholdArmed = false;
    void this._loadMore();
  };

  private _isThresholdReached(list: HTMLElement): boolean {
    const rect = list.getBoundingClientRect();
    return (
      rect.bottom - window.innerHeight <= WORK_GRID_INFINITE_CONFIG.thresholdPx
    );
  }

  private _attachSentinel(): void {
    this._detachSentinel();
    if (!this._feedState.hasMore) return;
    const list = this._elements.gridList;
    if (!list) return;
    const sentinel = document.createElement("div");
    sentinel.style.height = "1px";
    sentinel.setAttribute("aria-hidden", "true");
    list.after(sentinel);
    this._sentinel = sentinel;
    this._sentinelObserver = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) void this._loadMore();
      },
      { rootMargin: `${WORK_GRID_INFINITE_CONFIG.thresholdPx}px` },
    );
    this._sentinelObserver.observe(sentinel);
  }

  private _detachSentinel(): void {
    this._sentinelObserver?.disconnect();
    this._sentinelObserver = null;
    this._sentinel?.remove();
    this._sentinel = null;
  }

  private _bindFilterModal(): void {
    const filterPanel = this._elements.filterPanel;
    if (!filterPanel) return;
    const trigger = this._elements.root?.querySelector<HTMLButtonElement>(
      ".js-grid-filter-trigger",
    );
    if (!trigger) return;

    const categories: Array<{ slug: string; label: string }> = [];
    filterPanel
      .querySelectorAll<HTMLElement>("[data-works-filter-option]")
      .forEach((el) => {
        categories.push({
          slug: el.dataset.category ?? "",
          label: el.dataset.label ?? el.textContent?.trim() ?? "",
        });
      });
    if (categories.length === 0) return;

    const modal = document.createElement("div");
    modal.className = "no-grid-filter-modal";
    modal.setAttribute("aria-hidden", "true");
    modal.setAttribute("role", "dialog");
    modal.setAttribute("aria-label", "카테고리 필터");

    const backdrop = document.createElement("div");
    backdrop.className = "no-grid-filter-modal__backdrop";

    const sheet = document.createElement("div");
    sheet.className = "no-grid-filter-modal__sheet";

    const header = document.createElement("div");
    header.className = "no-grid-filter-modal__header";
    const headerTitle = document.createElement("span");
    headerTitle.textContent = "Category";
    const closeBtn = document.createElement("button");
    closeBtn.type = "button";
    closeBtn.className = "no-grid-filter-modal__close";
    closeBtn.setAttribute("aria-label", "닫기");
    closeBtn.textContent = "✕";
    header.append(headerTitle, closeBtn);

    const list = document.createElement("ul");
    list.className = "no-grid-filter-modal__list";
    categories.forEach(({ slug, label }) => {
      const li = document.createElement("li");
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "no-grid-filter-modal__option";
      btn.dataset.category = slug;
      btn.textContent = label;
      li.append(btn);
      list.append(li);
    });

    sheet.append(header, list);
    modal.append(backdrop, sheet);
    document.body.append(modal);
    this._filterModal = modal;
    this._syncFilterModalSelection(this._category);

    const openModal = (): void => {
      modal.setAttribute("aria-hidden", "false");
      modal.classList.add("is-open");
      document.body.classList.add("no-scroll");
    };
    const closeModal = (): void => {
      modal.setAttribute("aria-hidden", "true");
      modal.classList.remove("is-open");
      document.body.classList.remove("no-scroll");
    };
    const onOptionClick = (event: MouseEvent): void => {
      const btn = (event.target as HTMLElement).closest<HTMLButtonElement>(
        "[data-category]",
      );
      if (!btn) return;
      const slug = btn.dataset.category ?? "";
      const category = slug === "" ? null : slug;
      closeModal();
      void this.changeCategory(category);
    };

    trigger.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);
    list.addEventListener("click", onOptionClick);

    this._filterModalCleanups.push(
      () => trigger.removeEventListener("click", openModal),
      () => closeBtn.removeEventListener("click", closeModal),
      () => backdrop.removeEventListener("click", closeModal),
      () => list.removeEventListener("click", onOptionClick),
    );
  }

  private _syncFilterModalSelection(category: string | null): void {
    if (!this._filterModal) return;
    this._filterModal.querySelectorAll<HTMLButtonElement>("[data-category]").forEach((btn) => {
      const slug = btn.dataset.category ?? "";
      const isActive = (category === null && slug === "") || slug === (category ?? "");
      btn.classList.toggle("is-active", isActive);
    });
  }

  private _removeFilterModal(): void {
    this._filterModalCleanups.forEach((fn) => fn());
    this._filterModalCleanups.length = 0;
    this._filterModal?.remove();
    this._filterModal = null;
    document.body.classList.remove("no-scroll");
  }

  private _runVideoHoverCleanups(): void {
    this._videoHoverCleanups.forEach((fn) => fn());
    this._videoHoverCleanups.length = 0;
  }

  private async _loadMore(): Promise<void> {
    if (!this._feedState.hasMore) return;
    if (this._feedState.nextOffset === null) return;
    if (this._loading) return;
    this._loading = true;
    this._abortController?.abort();
    this._abortController = new AbortController();
    try {
      const response = await this._fetchItems(this._feedState.nextOffset);
      this._appendItems(response.items);
      this._feedState = {
        nextOffset: response.nextOffset,
        hasMore: response.hasMore,
      };
      this._syncRootState();
      this._syncPaginationVisibility();
      this._attachSentinel();
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") return;
      console.warn(
        "[WorksGridFeedRuntime.loadMore] Grid feed request failed.",
        error,
      );
      this._thresholdArmed = true;
    } finally {
      this._loading = false;
      this._abortController = null;
    }
  }

  private async _fetchItems(offset: number) {
    return fetchWorksList(
      offset,
      this._state.limit,
      this._category,
      this._abortController?.signal,
    );
  }

  private _resolveInitialOffset(): number {
    return Math.max(0, (this._state.page - 1) * this._state.limit);
  }

  private _clearList(): void {
    this._runVideoHoverCleanups();
    this._detachSentinel();
    this._elements.gridList?.replaceChildren();
  }

  private _appendItems(items: ReadonlyArray<WorkApiItem>): void {
    if (items.length === 0) return;
    const list = this._elements.gridList;
    if (!list) return;
    const fragment = document.createDocumentFragment();
    items.forEach((item) => {
      fragment.append(this._createListItem(item));
    });
    list.append(fragment);
  }

  private _createListItem(item: WorkApiItem): HTMLLIElement {
    const listItem = document.createElement("li");
    listItem.className = "no-sub-works__gallery-item";
    listItem.dataset.workNo = item.no;

    const link = document.createElement("a");
    link.className = "no-sub-works__gallery-item__link";
    link.href = this._buildDetailHref(item.detailPath || "/works");

    const imageWrap = document.createElement("div");
    imageWrap.className = "no-sub-works__gallery-item__img-wrap";

    const imageInner = document.createElement("div");
    imageInner.className = "no-sub-works__gallery-item__img-inner";

    const figure = document.createElement("figure");
    figure.className = "no-sub-works__gallery-item__img";

    const media = this._createMedia(item);
    if (media) {
      figure.append(media);
    }

    if (item.thumbnailImage && item.thumbnailVideo) {
      this._attachVideoHover(listItem, item.thumbnailVideo, figure);
    }

    imageInner.append(figure);
    imageWrap.append(this._createGalleryItemCorner(), imageInner);

    const body = document.createElement("div");
    body.className = "no-sub-works__gallery-item__body";

    const title = document.createElement("h2");
    title.className = "no-sub-works__gallery-item__title";
    title.textContent = item.title ?? "";
    body.append(title);

    link.append(imageWrap, body);
    listItem.append(link, this._createModalButton(item));
    return listItem;
  }

  private _createMedia(
    item: WorkApiItem,
  ): HTMLImageElement | HTMLVideoElement | null {
    if (item.thumbnailImage) {
      const image = document.createElement("img");
      image.src = item.thumbnailImage;
      image.alt = item.title ?? "";
      return image;
    }
    if (item.thumbnailVideo) {
      const video = document.createElement("video");
      video.src = item.thumbnailVideo;
      video.autoplay = true;
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      return video;
    }
    return null;
  }

  private _attachVideoHover(
    li: HTMLLIElement,
    videoUrl: string,
    figure: HTMLElement,
  ): void {
    const video = document.createElement("video");
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.preload = "none";
    figure.append(video);

    const onEnter = (): void => {
      if (!video.src) {
        video.src = videoUrl;
        video.load();
      }
      figure.classList.add("is-video-active");
      void video.play().catch(() => undefined);
    };
    const onLeave = (): void => {
      figure.classList.remove("is-video-active");
      video.pause();
    };

    li.addEventListener("pointerenter", onEnter);
    li.addEventListener("pointerleave", onLeave);

    this._videoHoverCleanups.push(() => {
      video.pause();
      li.removeEventListener("pointerenter", onEnter);
      li.removeEventListener("pointerleave", onLeave);
    });
  }

  private _createModalButton(item: WorkApiItem): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "no-corner-btn no-works-canvas__grid-link js-work-modal-trigger";
    button.setAttribute("aria-label", `${item.title || "Work"} modal view`);
    button.append(this._createModalButtonCorner());
    const text = document.createElement("span");
    text.className = "no-corner-btn__text";
    text.textContent = "View Modal";
    button.append(text, this._createModalButtonIcon());
    return button;
  }

  private _createModalButtonCorner(): HTMLSpanElement {
    const root = document.createElement("span");
    root.className =
      "no-corner-bracket no-corner-btn__corner no-corner-bracket--shine";
    root.setAttribute("aria-hidden", "true");

    const cornerSpecs = [
      {
        className: "no-corner-bracket__corner no-corner-bracket__corner--tl",
        pathA: "M 0 0 L 14 0",
        pathB: "M 0 0 L 0 14",
      },
      {
        className: "no-corner-bracket__corner no-corner-bracket__corner--tr",
        pathA: "M 26 0 L 12 0",
        pathB: "M 26 0 L 26 14",
      },
      {
        className: "no-corner-bracket__corner no-corner-bracket__corner--bl",
        pathA: "M 0 26 L 14 26",
        pathB: "M 0 26 L 0 12",
      },
      {
        className: "no-corner-bracket__corner no-corner-bracket__corner--br",
        pathA: "M 26 26 L 12 26",
        pathB: "M 26 26 L 26 12",
      },
    ] as const;

    cornerSpecs.forEach((spec) => {
      const corner = document.createElement("span");
      corner.className = spec.className;
      corner.innerHTML = `
        <svg viewBox="0 0 26 26" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" preserveAspectRatio="xMidYMid meet">
          <path d="${spec.pathA}"></path>
          <path d="${spec.pathB}"></path>
        </svg>
      `;
      root.append(corner);
    });

    return root;
  }

  private _createGalleryItemCorner(): HTMLSpanElement {
    const corner = this._createModalButtonCorner();
    corner.className =
      "no-corner-bracket no-sub-works__gallery-item__corner no-corner-bracket--shine";
    return corner;
  }

  private _createModalButtonIcon(): HTMLSpanElement {
    const icon = document.createElement("span");
    icon.className = "no-corner-btn__icon";
    icon.setAttribute("aria-hidden", "true");
    icon.innerHTML = `
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="none">
        <path d="M566.4 297.4L589 320L566.4 342.6L406.4 502.6L383.8 525.2L338.5 479.9L466.5 351.9L63.8 351.9L63.8 287.9L466.5 287.9L338.5 159.9L383.8 114.6L406.4 137.2L566.4 297.2z" fill="currentColor"></path>
      </svg>
    `;
    return icon;
  }

  private _buildDetailHref(detailPath: string): string {
    const url = new URL(detailPath || "/works", window.location.origin);
    url.searchParams.set("view", this._state.view);
    if (this._state.category) {
      url.searchParams.set("category", this._state.category);
    } else {
      url.searchParams.delete("category");
    }
    if (this._state.page > 1) {
      url.searchParams.set("page", String(this._state.page));
    } else {
      url.searchParams.delete("page");
    }
    return `${url.pathname}${url.search}${url.hash}`;
  }

  private _syncRootState(): void {
    const root = this._elements.root;
    if (!root) return;
    root.dataset.gridHasMore = this._feedState.hasMore ? "true" : "false";
    root.dataset.gridNextOffset =
      this._feedState.nextOffset === null
        ? ""
        : String(this._feedState.nextOffset);
  }

  private _syncPaginationVisibility(): void {
    const pagination = this._elements.gridPagination;
    if (!pagination) return;
    pagination.hidden = !this._feedState.hasMore;
  }
}

class WorksBackgroundCoordinator {
  private readonly _root: ParentNode;
  private _runtime: WorksBackgroundRuntime | null = null;

  constructor(root: ParentNode) {
    this._root = root;
  }

  async ensure(): Promise<void> {
    const canvas = this._root.querySelector<HTMLCanvasElement>(
      `#${WORK_BACKGROUND_CANVAS_ID}`,
    );
    if (!(canvas instanceof HTMLCanvasElement)) return;
    this._runtime ??= new WorksBackgroundRuntime();
    await this._runtime.run(WORK_BACKGROUND_CANVAS_ID, canvas);
  }

  dispose(): void {
    this._runtime?.dispose();
    this._runtime = null;
  }
}

class WorksInteractionLock {
  private _overlay: HTMLDivElement | null = null;
  private _locked = false;
  private _releaseScrollLock: (() => void) | null = null;

  lock(): void {
    if (this._locked) return;
    this._locked = true;
    this._releaseScrollLock?.();
    this._releaseScrollLock = ScrollLock.lock({ pauseLenis: true });
    const overlay = document.createElement("div");
    overlay.setAttribute("aria-hidden", "true");
    overlay.style.position = "fixed";
    overlay.style.inset = "0";
    overlay.style.zIndex = "99999";
    overlay.style.pointerEvents = "auto";
    overlay.style.touchAction = "none";
    overlay.style.background = "transparent";
    overlay.style.cursor = "wait";
    document.body.appendChild(overlay);
    this._overlay = overlay;
  }

  unlock(): void {
    if (!this._locked) return;
    this._locked = false;
    this._overlay?.remove();
    this._overlay = null;
    this._releaseScrollLock?.();
    this._releaseScrollLock = null;
  }

  dispose(): void {
    this.unlock();
  }
}

export class WorksPageRuntime {
  private readonly root: ParentNode;
  private readonly projectsLoader: WorksProjectsLoader;
  private readonly backgroundCoordinator: WorksBackgroundCoordinator;
  private readonly authorRuntime = new WorksTheatreBridge();
  private readonly _interactionLock = new WorksInteractionLock();

  private gridFeedRuntime: WorksGridFeedRuntime | null = null;
  private scene: WorksSceneManager | null = null;
  private uiRuntime: WorksPageUiRuntime | null = null;
  private introRuntime: WorksIntroPlaybackRuntime | null = null;
  private _wheelHintBound = false;
  private _authorCanvasHintBound = false;
  private _authorCanvasDragging = false;
  private _runRevision = 0;
  private _disposed = false;
  private readonly _scatterFilterCleanup: Array<() => void> = [];
  private elements: WorksPageElements = {
    root: null,
    canvas: null,
    grid: null,
    gridList: null,
    gridPagination: null,
    controls: null,
    toggle: null,
    filterWrap: null,
    filterButton: null,
    filterPanel: null,
    dragHint: null,
  };
  private state: WorksPageState = { ...WORK_PAGE_STATE_DEFAULT };
  private readonly _handleWheel = (event: WheelEvent): void => {
    if (this.state.view !== "scatter") return;
    if (this._authorCanvasDragging) return;
    if (Math.abs(event.deltaY) < 1) return;
    this.uiRuntime?.showDragHint();
  };
  private readonly _handleAuthorCanvasPointerDown = (): void => {
    this._authorCanvasDragging = true;
    this.uiRuntime?.hideDragHint();
  };
  private readonly _handleAuthorCanvasPointerUp = (): void => {
    this._authorCanvasDragging = false;
  };
  private readonly _handleAuthorCanvasPointerCancel = (): void => {
    this._authorCanvasDragging = false;
  };

  constructor(root?: ParentNode | null) {
    this.root = root ?? document;
    this.projectsLoader = new WorksProjectsLoader();
    this.backgroundCoordinator = new WorksBackgroundCoordinator(this.root);
  }

  async init(): Promise<void> {
    this._disposed = false;
    const runRevision = ++this._runRevision;
    const domRuntime = new WorksPageDomRuntime(this.root);
    this.elements = domRuntime.resolve();
    this.state = domRuntime.readState(this.elements);
    this.uiRuntime?.dispose();
    this.gridFeedRuntime?.dispose();
    this.gridFeedRuntime = null;
    this.uiRuntime = new WorksPageUiRuntime(this.elements);
    this.uiRuntime.applyInitialState(this.state);
    this.uiRuntime.syncViewLinks(this.state.category);
    this._unbindWheelHint();
    this._unbindAuthorCanvasHint();
    if (resolveWorksAuthorMode()) {
      this._hidePanel();
      this.state = { ...this.state, view: "scatter" };
      this.uiRuntime.hideGrid();
      this.uiRuntime.showCanvas();
      this.uiRuntime.hideViewToggle();
      this.uiRuntime.hideDragHint();
      this._bindWheelHint();
      this._bindAuthorCanvasHint();
      await this.authorRuntime.run(
        WORK_CANVAS_CONFIG.canvasId,
        this.elements.canvas,
      );
      if (!this._isActiveRun(runRevision)) return;
      this.uiRuntime.hideIntroIfReady();
      return;
    }
    await this.backgroundCoordinator.ensure();
    if (!this._isActiveRun(runRevision)) return;
    if (this.state.view === "grid") {
      this._showPanel();
      this._unbindWheelHint();
      this.scene?.dispose();
      this.scene = null;
      this.gridFeedRuntime = new WorksGridFeedRuntime(
        this.state,
        this.elements,
      );
      await this.gridFeedRuntime.init();
      if (!this._isActiveRun(runRevision)) return;
      this.gridFeedRuntime.bind();
      this.uiRuntime.hideCanvas();
      this.uiRuntime.enterGrid();
      return;
    }
    this._hidePanel();
    await this.startScatter(runRevision);
  }

  dispose(): void {
    this._disposed = true;
    this._runRevision += 1;
    this._unbindScatterFilter();
    this._hidePanel();
    this._unbindWheelHint();
    this._unbindAuthorCanvasHint();
    this.projectsLoader.dispose();
    this.gridFeedRuntime?.dispose();
    this.gridFeedRuntime = null;
    this.scene?.dispose();
    this.scene = null;
    this.authorRuntime.dispose();
    this.introRuntime?.dispose();
    this.introRuntime = null;
    this.backgroundCoordinator.dispose();
    this._interactionLock.dispose();
    this.uiRuntime?.dispose();
    this.uiRuntime = null;
    this.elements = {
      root: null,
      canvas: null,
      grid: null,
      gridList: null,
      gridPagination: null,
      controls: null,
      toggle: null,
      filterWrap: null,
      filterButton: null,
      filterPanel: null,
      dragHint: null,
    };
  }

  private async startScatter(runRevision: number): Promise<void> {
    const hasWebgl = EnvSetup.checkWebGL();
    const hasCanvasHost = EnvSetup.checkCanvas(
      WORK_CANVAS_CONFIG.canvasId,
      this.root,
    );
    const canRun = hasWebgl && hasCanvasHost;
    if (!canRun) {
      this._fallbackToGridView();
      return;
    }

    const projectsPromise = this.projectsLoader.load(this.state);
    const introStatePromise = this._playScatterIntro(runRevision);
    let projects: WorkProjectItem[];
    try {
      projects = await projectsPromise;
    } catch (error) {
      if (!this._isActiveRun(runRevision)) return;
      if (this.projectsLoader.isAbortedError(error)) return;
      throw error;
    }
    if (!this._isActiveRun(runRevision)) return;
    const introState = await introStatePromise;
    if (!this._isActiveRun(runRevision)) return;

    if (projects.length === 0) {
      this._fallbackToGridView();
      return;
    }

    this.scene?.dispose();
    this.scene = new WorksSceneManager({
      root: this.root,
      config: WORK_CANVAS_CONFIG,
      layout: WORK_LAYOUT,
      projects,
      introEntryState: introState
        ? {
            camera: introState.camera,
            cameraTarget: introState.cameraTarget,
          }
        : null,
      initialCategory: this.state.category,
      onSelect: (detailPath) => this.navigateToDetail(detailPath),
      onInteractionStart: () => this.uiRuntime?.hideDragHint(),
      canvasId: WORK_CANVAS_CONFIG.canvasId,
      pixelRatioMax: WORK_PIXEL_RATIO_MAX,
      renderer: WORK_RENDERER_CONFIG,
      placeholderImage: WORK_PLACEHOLDER_IMAGE,
    });
    this.scene.init();
    this.scene.setViewMode("scatter");
    this.scene.showCanvas();
    this._hidePanel();
    this.scene.applyInitialScatterState();
    if (!this._isActiveRun(runRevision)) return;

    this.uiRuntime?.syncFilterSelection(this.state.category);
    this._bindScatterFilter(this.scene);

    this.uiRuntime?.hideIntroIfReady();
    this.uiRuntime?.hideGrid();
    this._bindWheelHint();
    this.uiRuntime?.showViewToggle();
    if (WORK_HINT_CONFIG.enabled) {
      this.uiRuntime?.showDragHintIfNeeded(this.state);
    }
  }

  private async _playScatterIntro(
    runRevision: number,
  ): Promise<SceneFromState | null> {
    if (!WORK_INTRO_CONFIG.enabled) return null;
    if (this.state.view !== "scatter") return null;
    if (!(this.elements.canvas instanceof HTMLCanvasElement)) return null;

    this._interactionLock.lock();
    this.introRuntime?.dispose();
    const introRuntime = new WorksIntroPlaybackRuntime();
    this.introRuntime = introRuntime;

    try {
      const introState = await introRuntime.run(
        WORK_CANVAS_CONFIG.canvasId,
        this.elements.canvas,
      );
      if (!this._isActiveRun(runRevision)) return null;
      return introState;
    } catch (error) {
      console.warn(
        "[WorksPageRuntime._playScatterIntro] Intro playback failed.",
        error,
      );
      return null;
    } finally {
      if (this.introRuntime === introRuntime) {
        introRuntime.dispose();
        this.introRuntime = null;
      }
      this._interactionLock.unlock();
    }
  }

  private _isActiveRun(runRevision: number): boolean {
    return !this._disposed && this._runRevision === runRevision;
  }

  private _bindWheelHint(): void {
    if (this._wheelHintBound) return;
    window.addEventListener("wheel", this._handleWheel, { passive: true });
    this._wheelHintBound = true;
  }

  private _unbindWheelHint(): void {
    if (!this._wheelHintBound) return;
    window.removeEventListener("wheel", this._handleWheel);
    this._wheelHintBound = false;
  }

  private _bindAuthorCanvasHint(): void {
    if (this._authorCanvasHintBound) return;
    const canvas = this.elements.canvas;
    if (!(canvas instanceof HTMLCanvasElement)) return;
    canvas.addEventListener("pointerdown", this._handleAuthorCanvasPointerDown);
    window.addEventListener("pointerup", this._handleAuthorCanvasPointerUp);
    window.addEventListener(
      "pointercancel",
      this._handleAuthorCanvasPointerCancel,
    );
    this._authorCanvasHintBound = true;
  }

  private _unbindAuthorCanvasHint(): void {
    if (!this._authorCanvasHintBound) return;
    const canvas = this.elements.canvas;
    if (canvas instanceof HTMLCanvasElement) {
      canvas.removeEventListener(
        "pointerdown",
        this._handleAuthorCanvasPointerDown,
      );
    }
    window.removeEventListener("pointerup", this._handleAuthorCanvasPointerUp);
    window.removeEventListener(
      "pointercancel",
      this._handleAuthorCanvasPointerCancel,
    );
    this._authorCanvasHintBound = false;
    this._authorCanvasDragging = false;
  }

  private _showPanel(): void {
    const snapshot = ResponsiveRuntime.getDefault().getSnapshot();
    if (snapshot.isMobile) return;
    this._setPanelVisible(true);
  }

  private _hidePanel(): void {
    this._setPanelVisible(false);
  }

  private _setPanelVisible(visible: boolean): void {
    const panel = Panel.getInstance();
    panel.init();
    if (visible) {
      panel.setVisibleOn();
      return;
    }
    panel.setVisibleOff();
  }

  private navigateToDetail(detailPath: string): void {
    const base = document.documentElement?.getAttribute?.("data-base") ?? "";
    const detailUrl = new URL(detailPath, window.location.origin);
    detailUrl.searchParams.set("view", this.state.view);
    if (this.state.category) {
      detailUrl.searchParams.set("category", this.state.category);
    } else {
      detailUrl.searchParams.delete("category");
    }
    if (this.state.page > 1) {
      detailUrl.searchParams.set("page", String(this.state.page));
    } else {
      detailUrl.searchParams.delete("page");
    }
    const href =
      `${base}${detailUrl.pathname}${detailUrl.search}${detailUrl.hash}`.replace(
        /\/+/g,
        "/",
      );
    window.location.assign(href);
  }

  private _fallbackToGridView(): void {
    this._showPanel();
    this.uiRuntime?.hideIntroIfReady();
    this.uiRuntime?.hideCanvas();
    this.uiRuntime?.showGrid();
    this.uiRuntime?.showViewToggle();
  }

  private _unbindScatterFilter(): void {
    this._scatterFilterCleanup.forEach((fn) => fn());
    this._scatterFilterCleanup.length = 0;
  }

  private _bindScatterFilter(scene: WorksSceneManager): void {
    this._unbindScatterFilter();
    const wrap = this.elements.filterWrap;
    const filterButton = this.elements.filterButton;
    const filterPanel = this.elements.filterPanel;
    if (!wrap || !filterButton || !filterPanel) return;

    let closeAriaTimer: number | null = null;
    const clearCloseAriaTimer = (): void => {
      if (closeAriaTimer === null) return;
      window.clearTimeout(closeAriaTimer);
      closeAriaTimer = null;
    };

    const closePanel = (): void => {
      clearCloseAriaTimer();
      filterButton.setAttribute("aria-expanded", "false");
      filterPanel.classList.remove("is-open");
      // 패널 닫힘 트랜지션 후: 포커스 정리 + aria-hidden (WORKS_FILTER_TRANSITION_MS와 동기)
      closeAriaTimer = window.setTimeout(() => {
        closeAriaTimer = null;
        const ae = document.activeElement;
        if (ae instanceof Node && filterPanel.contains(ae)) {
          filterButton.focus({ preventScroll: true });
        }
        filterPanel.setAttribute("aria-hidden", "true");
      }, WORKS_FILTER_TRANSITION_MS);
    };

    const openPanel = (): void => {
      clearCloseAriaTimer();
      filterPanel.setAttribute("aria-hidden", "false");
      filterPanel.classList.add("is-open");
      filterButton.setAttribute("aria-expanded", "true");
    };

    const togglePanel = (): void => {
      if (filterPanel.classList.contains("is-open")) {
        closePanel();
      } else {
        openPanel();
      }
    };

    const onFilterButtonClick = (event: MouseEvent): void => {
      event.stopPropagation();
      togglePanel();
    };
    filterButton.addEventListener("click", onFilterButtonClick);
    this._scatterFilterCleanup.push(() =>
      filterButton.removeEventListener("click", onFilterButtonClick),
    );

    const onPanelClick = (event: MouseEvent): void => {
      const target = event.target as HTMLElement | null;
      const option = target?.closest<HTMLElement>("[data-works-filter-option]");
      if (!option) return;
      const raw = option.dataset.category?.trim() ?? "";
      const category = raw === "" ? null : raw;
      this.state = { ...this.state, category };
      this.elements.root?.setAttribute(
        "data-category",
        category === null ? "" : category,
      );
      scene.applyCategory(category);
      this.uiRuntime?.syncFilterSelection(category, { animateLabel: true });
      this.uiRuntime?.syncViewLinks(category);
      this._syncScatterUrl(category);
      closePanel();
    };
    filterPanel.addEventListener("click", onPanelClick);
    this._scatterFilterCleanup.push(() =>
      filterPanel.removeEventListener("click", onPanelClick),
    );

    const onDocumentClick = (event: MouseEvent): void => {
      if (!wrap.contains(event.target as Node)) {
        closePanel();
      }
    };
    document.addEventListener("click", onDocumentClick);
    this._scatterFilterCleanup.push(() =>
      document.removeEventListener("click", onDocumentClick),
    );

    const onKeyDown = (event: KeyboardEvent): void => {
      if (event.key !== "Escape") return;
      closePanel();
    };
    document.addEventListener("keydown", onKeyDown);
    this._scatterFilterCleanup.push(() =>
      document.removeEventListener("keydown", onKeyDown),
    );

    this._scatterFilterCleanup.push(() => {
      clearCloseAriaTimer();
      if (!filterPanel.classList.contains("is-open")) {
        filterPanel.setAttribute("aria-hidden", "true");
      }
    });
  }

  private _syncScatterUrl(category: string | null): void {
    const url = new URL(window.location.href);
    url.searchParams.set("view", "scatter");
    if (category) {
      url.searchParams.set("category", category);
    } else {
      url.searchParams.delete("category");
    }
    if (this.state.page > 1) {
      url.searchParams.set("page", String(this.state.page));
    } else {
      url.searchParams.delete("page");
    }
    window.history.replaceState({}, "", url);
  }
}
