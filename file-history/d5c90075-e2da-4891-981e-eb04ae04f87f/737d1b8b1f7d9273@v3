$resolveWorksView = static function (Request $req): string {
    $viewRaw = strtolower(trim((string) $req->query('view', 'scatter')));
    return in_array($viewRaw, ['scatter', 'grid'], true) ? $viewRaw : 'scatter';
};

$resolvePositiveInt = static function ($value, int $default, int $min = 1, ?int $max = null): int {
    $validated = filter_var($value, FILTER_VALIDATE_INT);
    if ($validated === false) {
        return $default;
    }

    $normalized = max($min, (int) $validated);
    if ($max === null) {
        return $normalized;
    }

    return min($max, $normalized);
};

$renderWorksDetailPage = static function (
    string $viewName,
    string $no,
    string $pageType,
    string $pageNamespace
) use ($loadWorksApi) {
    $loadWorksApi();

