  Partial<Record<ContactTheatreSheetId, ContactTheatrePlaybackRange>>
> = {};

export function sanitizeContactTheatreState(
  state: Record<string, unknown> | null,
): Record<string, unknown> | null {
  if (!state) return null;
  const sheetsByIdValue = state.sheetsById;
  if (
    sheetsByIdValue == null ||
    typeof sheetsByIdValue !== "object" ||
    Array.isArray(sheetsByIdValue)
  ) {
    return state;
  }
  const sheetsById = sheetsByIdValue as Record<string, unknown>;
  const nextSheetsById: Record<string, unknown> = {};
  CONTACT_THEATRE_SHEET_IDS.forEach((sheetId) => {
    if (!Object.prototype.hasOwnProperty.call(sheetsById, sheetId)) return;
    nextSheetsById[sheetId] = sheetsById[sheetId];
  });
  return {
    ...state,
    sheetsById: nextSheetsById,
  };
}

export function resolveContactAuthorMode(): boolean {
  return EnvSetup.hasQueryFlag(
    CONTACT_THEATRE_QUERY_KEY,
    CONTACT_THEATRE_QUERY_ENABLED,
  );
}
