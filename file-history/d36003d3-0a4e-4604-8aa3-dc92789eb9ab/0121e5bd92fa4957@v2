```typescript
gallery: {
  onProgress: (progress: number): void => {
    syncSectionTextReveal(GALLERY_TEXT_SELECTOR, aboutGalleryDomState, progress);
  },
  onDispose: (): void => {
    disposeSectionTextReveal(GALLERY_TEXT_SELECTOR, aboutGalleryDomState);
  },
},
proof: {
  onProgress: (progress: number, proofRenderer?: AboutProofRenderer): void => {
    syncSectionTextReveal(PROOF_TEXT_SELECTOR, aboutProofDomState, progress);
    // proofRenderer는 AboutPageRuntime에서 주입 (아래 5번 방식으로 연동)
  },
  onDispose: (): void => {
    disposeSectionTextReveal(PROOF_TEXT_SELECTOR, aboutProofDomState);
  },
},
```

