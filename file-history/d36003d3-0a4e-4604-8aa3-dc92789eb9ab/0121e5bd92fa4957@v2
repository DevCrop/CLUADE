## 4. Scene Config (`resource/ts/pages/about/scene/about.scene.ts`)

### 4-a. DOM 상태 + reveal 헬퍼 추가

```typescript
const GALLERY_TEXT_SELECTOR = '.no-sub-about-gallery .is-block-reveal';
const PROOF_TEXT_SELECTOR = '.no-sub-about-proof .is-block-reveal';
const SECTION_TEXT_REVEAL_THRESHOLD = 0.18;
const SECTION_TEXT_HIDE_THRESHOLD = 0.08;
const SECTION_TEXT_STAGGER_MS = 150;

const aboutGalleryDomState = { visible: false, timers: [] as number[] };
const aboutProofDomState = { visible: false, timers: [] as number[] };

function syncSectionTextReveal(
  selector: string,
  domState: { visible: boolean; timers: number[] },
  progress: number,
): void {
  const shouldShow = progress >= SECTION_TEXT_REVEAL_THRESHOLD;
  const shouldHide = !shouldShow && progress < SECTION_TEXT_HIDE_THRESHOLD;
  if (!shouldShow && !shouldHide) return;
  if (domState.visible === shouldShow) return;
  domState.visible = shouldShow;
  domState.timers.forEach((id) => window.clearTimeout(id));
  domState.timers = [];

  const elements = Array.from(
    document.querySelectorAll<HTMLElement>(selector)
  );
  elements.forEach((el, i) => {
    const id = window.setTimeout(() => {
      el.classList.toggle('is-block-reveal-up', shouldShow);
    }, i * SECTION_TEXT_STAGGER_MS);
    domState.timers.push(id);
  });
}

function disposeSectionTextReveal(
  selector: string,
  domState: { visible: boolean; timers: number[] },
): void {
  domState.timers.forEach((id) => window.clearTimeout(id));
  domState.timers = [];
  domState.visible = false;
  document.querySelectorAll<HTMLElement>(selector).forEach((el) =>
    el.classList.remove('is-block-reveal-up')
  );
}
```

