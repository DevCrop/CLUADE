    &__image {
      img,
      video {
        width: 100%;
        display: block;
        object-fit: cover;
      }
    }
  }

  @include mq(lg) {
    &__info {
      grid-template-columns: 1fr;
      gap: var(--gutter-lg);
    }

    &__info-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @include mq(md) {
    &__head {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--gutter-sm);
    }

    &__content {
      &__overview {
        grid-template-columns: 1fr;
        gap: var(--gutter-md);
      }
    }
  }

  @include mq(sm) {
    &__info-list {
      grid-template-columns: 1fr;
      gap: 0;
    }
    &__info-item {
      padding: var(--gutter-sm) 0;
      border-bottom: 1px solid var(--clr-border-default);
      gap: var(--gutter-2xs);
      &:first-child {
        padding-top: 0;
      }
    }

    &__visit-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: calc(var(--z-index-header) - 80);
      display: flex;
      justify-content: center;
      padding: var(--gutter-container);
      background: color-mix(
        in srgb,
        var(--clr-surface-default) 88%,
        transparent
      );
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--clr-border-default);

      .no-corner-btn-wrap {
        display: block;
        width: 100%;
      }

      .no-sub-work-view__button {
        min-width: 0;
        width: 100%;
      }
    }
  }
}

@keyframes no-works-type {
  from {
    max-width: 0;
  }
  to {
    max-width: 11ch;
  }
}

@keyframes no-works-caret {
  0%,
  49% {
    border-right-color: var(--clr-text-desc);
  }
  50%,
  100% {
    border-right-color: transparent;
  }
}
