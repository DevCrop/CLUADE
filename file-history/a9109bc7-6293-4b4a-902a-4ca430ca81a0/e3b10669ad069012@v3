function createTransformState(): MainTransformState {
  return {
    position: cloneVec3(ZERO_VEC3),
    rotation: cloneVec3(ZERO_VEC3),
    scale: cloneVec3(UNIT_VEC3),
    visible: false,
  };
}

function createWindowStateFromConfig(): MainTransformState {
  return createTransformState();
}

function createRocketFlameStateFromConfig(): MainRocketFlameState {
  const flame = OBJECT_CONFIG.rocket?.flame;
  return {
    visible: flame?.visible ?? true,
    offset: {
      x: typeof flame?.offset?.x === "number" ? flame.offset.x : 0,
      y: typeof flame?.offset?.y === "number" ? flame.offset.y : 0,
      z: typeof flame?.offset?.z === "number" ? flame.offset.z : 0,
    },
    rotation: {
      x: typeof flame?.rotation?.x === "number" ? flame.rotation.x : 0,
      y: typeof flame?.rotation?.y === "number" ? flame.rotation.y : 0,
      z: typeof flame?.rotation?.z === "number" ? flame.rotation.z : 0,
    },
    scale: {
      x: typeof flame?.scale?.x === "number" ? flame.scale.x : 1,
      y: typeof flame?.scale?.y === "number" ? flame.scale.y : 1,
      z: typeof flame?.scale?.z === "number" ? flame.scale.z : 1,
    },
    opacity: typeof flame?.opacity === "number" ? flame.opacity : 1,
    renderOrder:
      typeof flame?.renderOrder === "number" ? flame.renderOrder : 0,
    speed: typeof flame?.speed === "number" ? flame.speed : 2,
    wave: typeof flame?.wave === "number" ? flame.wave : 1.2,
  };
}

function createGravityBallsStateFromConfig(): MainGravityBallsState {
  const gc = OBJECT_CONFIG.gravityBalls;
  const num = (v: unknown, fallback: number): number =>
    typeof v === "number" && Number.isFinite(v) ? v : fallback;
  return {
    visible: gc?.visible ?? true,
    dotsPerInterval: num(gc?.dotsPerInterval, 3),
    physicsScale: num(gc?.physicsScale, 0.006),
    maxGravityBoost: num(gc?.maxGravityBoost, 3.0),
    particleScaleMin: num(gc?.particleScaleMin, 1.2),
    particleScaleMax: num(gc?.particleScaleMax, 3.0),
  };
}

export function cloneGravityBallsState(
  state: MainGravityBallsState,
): MainGravityBallsState {
  return {
    visible: state.visible,
    dotsPerInterval: state.dotsPerInterval,
    physicsScale: state.physicsScale,
    maxGravityBoost: state.maxGravityBoost,
    particleScaleMin: state.particleScaleMin,
    particleScaleMax: state.particleScaleMax,
  };
}

export function mergeGravityBallsState(
  target: MainGravityBallsState,
  source?: Partial<MainGravityBallsState> | null,
): MainGravityBallsState {
  if (!source) return cloneGravityBallsState(target);
  const num = (s: number | undefined, t: number): number =>
    typeof s === "number" && Number.isFinite(s) ? s : t;
  return {
    visible: typeof source.visible === "boolean" ? source.visible : target.visible,
    dotsPerInterval: num(source.dotsPerInterval, target.dotsPerInterval),
    physicsScale: num(source.physicsScale, target.physicsScale),
    maxGravityBoost: num(source.maxGravityBoost, target.maxGravityBoost),
    particleScaleMin: num(source.particleScaleMin, target.particleScaleMin),
    particleScaleMax: num(source.particleScaleMax, target.particleScaleMax),
  };
}

function createJetEngineStateFromConfig(): MainJetEngineState {
  const jc = OBJECT_CONFIG.jetEngine;
  const off = jc?.offset;
  const objectRotation = jc?.rotation;
  const objectScale = jc?.scale;
  const num = (v: unknown, fallback: number): number =>
    typeof v === "number" && Number.isFinite(v) ? v : fallback;
  return {
    position: {
      x: num(off?.x, 0),
      y: num(off?.y, 0),
      z: num(off?.z, 0),
    },
    rotation: {
      x: num(objectRotation?.x, 0),
      y: num(objectRotation?.y, 0),
      z: num(objectRotation?.z, 0),
    },
    scale: {
      x: num(objectScale?.x, 1),
      y: num(objectScale?.y, 1),
      z: num(objectScale?.z, 1),
    },
    visible: jc?.visible ?? true,
    intensity: num(jc?.intensity, 0.78),
    length: num(jc?.length, 2.4),
    nozzleRadius: num(jc?.nozzleRadius, 0.028),
    nozzleGap: num(jc?.nozzleGap, 2.2),
    noise: num(jc?.noise, 1),
    bloom: num(jc?.bloom, 1),
  };
}

export function cloneJetEngineState(
  state: MainJetEngineState,
): MainJetEngineState {
  return {
    position: cloneVec3(state.position),
    rotation: cloneVec3(state.rotation),
    scale: cloneVec3(state.scale),
    visible: state.visible,
    intensity: state.intensity,
    length: state.length,
    nozzleRadius: state.nozzleRadius,
    nozzleGap: state.nozzleGap,
    noise: state.noise,
    bloom: state.bloom,
  };
}

export function mergeJetEngineState(
  target: MainJetEngineState,
  source?: Partial<MainJetEngineState> | null,
): MainJetEngineState {
  if (!source) return cloneJetEngineState(target);
  const num = (s: number | undefined, t: number): number =>
    typeof s === "number" && Number.isFinite(s) ? s : t;
  const legacy = source as Partial<MainJetEngineState> & {
    baseLength?: number;
  };
  const lengthFromSource =
    typeof source.length === "number"
      ? source.length
      : typeof legacy.baseLength === "number"
        ? legacy.baseLength
        : undefined;
  return {
    position: mergeVec3(target.position, source.position),
    rotation: mergeVec3(target.rotation, source.rotation),
    scale: mergeVec3(target.scale, source.scale),
    visible:
      typeof source.visible === "boolean" ? source.visible : target.visible,
    intensity: num(source.intensity, target.intensity),
    length: num(lengthFromSource, target.length),
    nozzleRadius: num(source.nozzleRadius, target.nozzleRadius),
    nozzleGap: num(source.nozzleGap, target.nozzleGap),
    noise: num(source.noise, target.noise),
    bloom: num(source.bloom, target.bloom),
  };
}

