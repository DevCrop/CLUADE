    camera: {
      position: mergeVec3(target.camera.position, source.camera?.position),
      target: mergeVec3(target.camera.target, source.camera?.target),
      fov:
        typeof source.camera?.fov === "number"
          ? source.camera.fov
          : target.camera.fov,
    },
    rocket: mergeRocketState(target.rocket, source.rocket),
    jetEngine: mergeJetEngineState(target.jetEngine, source.jetEngine),
    gravityBalls: mergeGravityBallsState(target.gravityBalls, source.gravityBalls),
    ground: mergeTransformState(target.ground, source.ground),
    planet: mergeTransformState(target.planet, source.planet),
    earth: mergeTransformState(target.earth, source.earth),
    terrian: mergeTransformState(target.terrian, source.terrian),
    window: mergeTransformState(target.window, source.window),
    background: mergeBackgroundState(target.background, source.background),
    cloud: mergeCloudState(
      target.cloud,
      source.cloud,
    ),
    cloud2: mergeCloudState(
      target.cloud2,
      source.cloud2,
    ),
    cloud3: mergeCloudState(
      target.cloud3,
      source.cloud3,
    ),
    cloud4: mergeCloudState(
      target.cloud4,
      source.cloud4,
    ),
    cloud5: mergeCloudState(
      target.cloud5,
      source.cloud5,
    ),
    cloud6: mergeCloudState(
      target.cloud6,
      source.cloud6,
    ),
    postProcessing: mergePostProcessingState(
      target.postProcessing,
      source.postProcessing,
    ),
    sceneLights: mergeSceneLightsState(target.sceneLights, source.sceneLights),
    sceneShake: mergeSceneShakeState(target.sceneShake, source.sceneShake),
  };
}
