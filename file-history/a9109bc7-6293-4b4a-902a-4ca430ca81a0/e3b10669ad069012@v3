function cloneVec3(vector: SceneVec3): SceneVec3 {
  return { x: vector.x, y: vector.y, z: vector.z };
}

function cloneTransformState(state: MainTransformState): MainTransformState {
  return {
    position: cloneVec3(state.position),
    rotation: cloneVec3(state.rotation),
    scale: cloneVec3(state.scale),
    visible: state.visible,
  };
}

export function cloneRocketFlameState(
  state: MainRocketFlameState,
): MainRocketFlameState {
  return {
    visible: state.visible,
    offset: cloneVec3(state.offset),
    rotation: cloneVec3(state.rotation),
    scale: cloneVec3(state.scale),
    opacity: state.opacity,
    renderOrder: state.renderOrder,
    speed: state.speed,
    wave: state.wave,
  };
}

export function cloneRocketState(state: MainRocketState): MainRocketState {
