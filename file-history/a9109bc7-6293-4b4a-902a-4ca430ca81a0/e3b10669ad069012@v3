function mergeVec3(
  target: SceneVec3,
  source?: Partial<SceneVec3> | null,
): SceneVec3 {
  if (!source) return cloneVec3(target);
  return {
    x: typeof source.x === "number" ? source.x : target.x,
    y: typeof source.y === "number" ? source.y : target.y,
    z: typeof source.z === "number" ? source.z : target.z,
  };
}

function mergeTransformState(
  target: MainTransformState,
  source?: Partial<MainTransformState> | null,
): MainTransformState {
  if (!source) return cloneTransformState(target);
  return {
    position: mergeVec3(target.position, source.position),
    rotation: mergeVec3(target.rotation, source.rotation),
    scale: mergeVec3(target.scale, source.scale),
    visible:
      typeof source.visible === "boolean" ? source.visible : target.visible,
  };
}

