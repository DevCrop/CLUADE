function createContactInitialState(
  sceneState: ContactSceneState,
): ContactInitialState {
  return {
    camera: {
      position: { ...sceneState.camera.position },
      fov: sceneState.camera.fov,
    },
    cameraTarget: {
      position: { ...sceneState.camera.target },
    },
    aboutLights: {
      ...sceneState.light,
      rig: {
        position: { ...sceneState.light.rig.position },
        rotation: { ...sceneState.light.rig.rotation },
        scale: { ...sceneState.light.rig.scale },
        visible: sceneState.light.rig.visible,
      },
    },
    earth: {
      position: { ...sceneState.earth.position },
      rotation: { ...sceneState.earth.rotation },
      scale: { ...sceneState.earth.scale },
      visible: sceneState.earth.visible,
    },
    rocket: {
      position: { ...sceneState.rocket.position },
      rotation: { ...sceneState.rocket.rotation },
      scale: { ...sceneState.rocket.scale },
      visible: sceneState.rocket.visible,
      flame: { ...sceneState.rocket.flame },
    } as MainRocketState,
    terrian: {
      position: { ...sceneState.terrian.position },
      rotation: { ...sceneState.terrian.rotation },
      scale: { ...sceneState.terrian.scale },
      visible: sceneState.terrian.visible,
    },
  };
}

