## 9. MainSceneRig.ts — apply/read 추가

JetEngine 패턴 그대로:

```ts
private _applyGravityBalls(engine: Engine, state: MainGravityBallsState): void {
  const gb = engine.getSceneObjectById(gravityBalls) as SceneObject<GravityBallsTweenProps> | null;
  if (!gb || typeof gb.setTimelineVars !== "function") return;
  gb.setTimelineVars(state, "to");
}

private _readGravityBalls(engine: Engine): MainGravityBallsState {
  const defaults = DEFAULT_MAIN_SCENE_STATE.gravityBalls;
  const object = engine.getSceneObjectById(gravityBalls) as
    | { getRuntimeOptions?: () => Record<string, unknown> } | null;
  const runtime = object?.getRuntimeOptions?.() ?? {};
  return {
    visible: (runtime.visible as boolean) ?? defaults.visible,
    dotsPerInterval: this._toFinite(runtime.dotsPerInterval, defaults.dotsPerInterval),
    physicsScale: this._toFinite(runtime.physicsScale, defaults.physicsScale),
    maxGravityBoost: this._toFinite(runtime.maxGravityBoost, defaults.maxGravityBoost),
  };
}
```

