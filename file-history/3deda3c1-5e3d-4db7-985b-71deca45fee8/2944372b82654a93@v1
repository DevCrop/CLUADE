function createCloudLayer(
  label: string,
  position: { x: number; y: number; z: number },
  scale: { x: number; y: number; z: number },
  opacity: number,
) {
  return {
    label,
    visible: true,
    position,
    scale,
    plane: CLOUD_PLANE_OPTIONS,
    shader: {
      ...CLOUD_SHADER_BASE,
      opacity,
    },
  };
}

