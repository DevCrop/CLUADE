export function resolveAboutObjectTransformDefaults(
  id: keyof PageConfigObjectOptions,
  overrides?: Partial<AboutTransformState>,
): AboutTransformState {
  const options = OBJECT_CONFIG[id];
  return {
    position: {
      x: overrides?.position?.x ?? options?.position?.x ?? 0,
      y: overrides?.position?.y ?? options?.position?.y ?? 0,
      z: overrides?.position?.z ?? options?.position?.z ?? 0,
    },
    rotation: {
      x: overrides?.rotation?.x ?? options?.rotation?.x ?? 0,
      y: overrides?.rotation?.y ?? options?.rotation?.y ?? 0,
      z: overrides?.rotation?.z ?? options?.rotation?.z ?? 0,
    },
    scale: {
      x: overrides?.scale?.x ?? options?.scale?.x ?? 1,
      y: overrides?.scale?.y ?? options?.scale?.y ?? 1,
      z: overrides?.scale?.z ?? options?.scale?.z ?? 1,
    },
    visible: overrides?.visible ?? options?.visible ?? true,
  };
}

