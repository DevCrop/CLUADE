<script>
(() => {
    const syncWhoCardCopyHeight = () => {
        const section = document.querySelector('.no-sub-who[aria-labelledby="ch-who-heading"]');
        if (!section) return;
        const copies = Array.from(section.querySelectorAll('.no-sub-who-card__copy'));
        if (!copies.length) return;

        copies.forEach((el) => {
            el.style.minHeight = '0px';
        });

        const maxHeight = Math.max(...copies.map((el) => el.scrollHeight));
        copies.forEach((el) => {
            el.style.minHeight = `${maxHeight}px`;
        });
    };

    let rafId = null;
    const requestSync = () => {
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
            syncWhoCardCopyHeight();
            rafId = null;
        });
    };

    window.addEventListener('load', requestSync);
    window.addEventListener('resize', requestSync);
})();
</script>

