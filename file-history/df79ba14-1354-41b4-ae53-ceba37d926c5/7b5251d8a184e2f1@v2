const ICON_MAP: Record<string, string> = {
  threedotjs: siThreedotjs.svg,
  greensock: siGreensock.svg,
  gsap: siGsap.svg,
  typescript: siTypescript.svg,
  react: siReact.svg,
  php: siPhp.svg,
