export class WorksSceneDefinition {
  static createScenes(): WorksPageConfig["scenes"] {
    return {
      works: {},
    };
  }

  static createThreeConfig(
    canvasId: string,
  ): NonNullable<WorksPageConfig["three"]> {
    return {
      ...defaultThree,
      canvasId,
      camera: {
        ...defaultThree.camera,
        near: 0.1,
        far: 40000,
      },
      cameraTarget: { ...defaultThree.cameraTarget },
      renderer: { ...defaultThree.renderer, alpha: true },
      scene: {
        ...defaultThree.scene,
        background: null,
      },
      postProcessing: defaultThree.postProcessing,
    };
  }

  static createInitialState(
    state: SceneFromState,
  ): NonNullable<WorksPageConfig["initialState"]> {
    return {
      camera: state.camera
        ? {
            position: { ...state.camera.position },
            fov: state.camera.fov,
          }
        : undefined,
      cameraTarget: state.cameraTarget
        ? {
            position: { ...state.cameraTarget.position },
          }
        : undefined,
      ...WorksSceneDefinition.createInitialObjectOptions(state),
    };
  }

  static createIntroPageConfig(
    canvasId: string,
    initialState: WorksPageConfig["initialState"],
  ): WorksPageConfig {
    return {
      pageId: "works",
      scenes: WorksSceneDefinition.createScenes(),
      objects: {
        [sceneLights]: true,
        [planet]: true,
        [windowObj]: true,
      },
      three: WorksSceneDefinition.createThreeConfig(canvasId),
      initialState,
    };
  }

  static createBackgroundPageConfig(canvasId: string): WorksPageConfig {
    return {
      pageId: "works",
      scenes: WorksSceneDefinition.createScenes(),
      objects: {
        [mainBackground]: true,
      },
      three: WorksSceneDefinition.createThreeConfig(canvasId),
      objectOptions: {
        [mainBackground]: {
          position: { ...MAIN_BACKGROUND_OBJECT_DEFAULTS.position },
          rotation: { x: 0, y: 0, z: 0 },
          scale: { ...MAIN_BACKGROUND_OBJECT_DEFAULTS.scale },
          exposure: MAIN_BACKGROUND_OBJECT_DEFAULTS.exposure,
          look: { ...WORKS_BACKGROUND_LOOK },
        },
      },
    };
  }

  static createBackgroundRuntimeState(): {
    variant: "works";
    look: Required<BackgroundLookOptions>;
    exposure: number;
  } {
    return {
      variant: "works",
      look: { ...WORKS_BACKGROUND_LOOK },
      exposure: MAIN_BACKGROUND_OBJECT_DEFAULTS.exposure,
    };
  }

  static createInitialObjectOptions(
    state: SceneFromState,
  ): Record<string, Record<string, unknown> | undefined> {
    return {
      [windowObj]:
        state[windowObj] != null
          ? { ...(state[windowObj] as Record<string, unknown>) }
          : undefined,
      [sceneLights]:
        state[sceneLights] != null
          ? { ...(state[sceneLights] as Record<string, unknown>) }
          : undefined,
    };
  }
}
