export function createWorkProjectItem(
  item: WorkApiItem,
  index: number,
): WorkProjectItem {
  const preset =
    WORK_PROJECT_VISUALS[item.category] ?? WORK_PROJECT_VISUALS.default;
  const useLandscape = preset.w > preset.h || index % 7 === 0;
  return {
    ...item,
    bg: preset.bg,
    ac: preset.ac,
    w: useLandscape ? 6.8 : preset.w,
    h: useLandscape ? 4.4 : preset.h,
  };
}

export function formatWorkCategoryLabel(category: string): string {
  if (category.length === 0) return "";
  return WORK_CATEGORY_LABELS[category] ?? category;
}

