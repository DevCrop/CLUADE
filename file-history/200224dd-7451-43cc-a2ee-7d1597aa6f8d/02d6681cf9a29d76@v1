                        </p>
                            </div>
                        </div>
                    </div>
                    <div class="no-drawer__address-block">
                        <div class="no-drawer__reveal">
                            <div class="no-drawer__reveal-inner">
                        <strong class="no-drawer__address-title">Email</strong>
                        <p class="no-drawer__address-list">
                            <span class="no-drawer__address-item">
                                <a href="mailto:<?= e($contactEmail) ?>"
                                    class="no-drawer__address-link"><?= e($contactEmail) ?></a>
                            </span>
                        </p>
                            </div>
                        </div>
