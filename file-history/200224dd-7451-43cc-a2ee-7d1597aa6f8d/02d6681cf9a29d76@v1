<?php
/** @var \Menu\Menu|null $menu */
$menu = app()->get('menu');
$siteinfo = app()->get('siteinfo') ?? [];
$currentPath = parse_url($_SERVER['REQUEST_URI'] ?? '', PHP_URL_PATH) ?: '/';
if (!isset($worksCount)) {
    $rootPath = defined('ROOT_PATH') && is_string(ROOT_PATH) ? ROOT_PATH : dirname(__DIR__, 2);
    require_once rtrim($rootPath, '/') . '/api/works.php';
    $worksCount = function_exists('get_works_public_count') ? get_works_public_count() : 0;
}
// siteinfo / .env 가 비었을 때 드로어 표시용 기본값 (필요 시 수정)
$drawerDefaultAddressHq = '서울시 노원구 동일로191가길 48 2F';
$drawerDefaultAddressLab = '서울특별시 동대문구 무학로 49길 85, 3F';
$drawerDefaultEmail = 'cs@nineonelabs.co.kr';
$drawerDefaultPhone = '070 8739 7046';

$rawFooterAddress = trim((string) ($siteinfo['footer_address'] ?? ''));
$addressLabFromSub = trim((string) ($siteinfo['footer_address_sub'] ?? $siteinfo['footer_address2'] ?? ''));

if ($rawFooterAddress !== '' && $addressLabFromSub === '' && preg_match('/\R/u', $rawFooterAddress)) {
    $parts = preg_split('/\R/u', $rawFooterAddress, 2);
    $addressHq = trim((string) ($parts[0] ?? '')) ?: $drawerDefaultAddressHq;
    $addressLab = trim((string) ($parts[1] ?? '')) ?: $drawerDefaultAddressLab;
} elseif ($rawFooterAddress !== '') {
    $addressHq = $rawFooterAddress;
    $addressLab = $addressLabFromSub !== '' ? $addressLabFromSub : $drawerDefaultAddressLab;
} else {
    $addressHq = $drawerDefaultAddressHq;
    $addressLab = $addressLabFromSub !== '' ? $addressLabFromSub : $drawerDefaultAddressLab;
}

$contactEmail = trim((string) ($siteinfo['footer_email'] ?? ''));
if ($contactEmail === '' && defined('PROJECT_CONTACT_EMAIL')) {
    $contactEmail = trim((string) PROJECT_CONTACT_EMAIL);
}
if ($contactEmail === '') {
    $contactEmail = $drawerDefaultEmail;
}

$footerPhone = trim((string) ($siteinfo['footer_phone'] ?? $siteinfo['phone'] ?? ''));
if ($footerPhone === '') {
    $footerPhone = $drawerDefaultPhone;
}
$telHref = preg_replace('/[^0-9+]/', '', $footerPhone);
if ($telHref === '') {
    $telHref = '07087397046';
}
if (!function_exists('corner_bracket_html')) {
    require __DIR__ . '/button/button-corner-markup.php';
}
?>
