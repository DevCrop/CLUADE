                        <?php foreach ($menu->rootItems() as $root):
                                if (!$root->isVisible()) continue;
                                $href = $root->url();
                                $label = $root->label();
                                $target = $root->target();
                                $isActive = $href === '/'
                                    ? $currentPath === '/'
                                    : ($href !== '' && strpos($currentPath, $href) === 0);
                                $children = $root->children(true);
                                $hasSub = !empty($children);
                            ?>
                        <li class="no-drawer__gnb-item<?= $hasSub ? ' no-drawer__gnb-item--has-sub' : '' ?>">
                            <div class="no-drawer__reveal">
                                <div class="no-drawer__reveal-inner">
                            <?php if ($hasSub): ?>
