                                <a href="<?= e($href) ?>"
                                    class="no-drawer__gnb-link wavy-link f-display-0<?= $isActive ? ' is-active' : '' ?>"
                                    <?= !empty($target) ? ' target="' . e($target) . '"' : '' ?>>
                                    <span class="no-loop-filter-rect no-drawer__gnb-rect" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                                    <span class="no-drawer__gnb-label"><?= e($label) ?></span>
                                </a>
                                <ul class="no-drawer__gnb-sub" aria-label="<?= e($label) ?> 하위 메뉴">
                                    <?php foreach ($children as $child):
                                                    $chHref = $child->url();
                                                    $chActive = $chHref !== '' && ($currentPath === $chHref || strpos($currentPath, rtrim($chHref, '/') . '/') === 0);
                                                ?>
                                    <li class="no-drawer__gnb-sub-item">
                                        <a href="<?= e($chHref) ?>"
                                            class="no-drawer__gnb-sub-link<?= $chActive ? ' is-active' : '' ?>"><span
                                                class="no-drawer__gnb-sub-label"><?= e($child->label()) ?></span></a>
                                    </li>
                                    <?php endforeach; ?>
                                </ul>
                            </div>
                            <?php else: ?>
                            <a href="<?= e($href) ?>"
                                class="no-drawer__gnb-link wavy-link f-display-0<?= $isActive ? ' is-active' : '' ?>"
                                <?= !empty($target) ? ' target="' . e($target) . '"' : '' ?><?= ($target === '_blank') ? ' rel="noopener noreferrer"' : '' ?>>
                                <span class="no-loop-filter-rect no-drawer__gnb-rect" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                                <span class="no-drawer__gnb-label"><?= e($label) ?></span>
                            </a>
                            <?php if ($root->slug() === 'works'): ?>
                            <span class="no-drawer__badge" aria-label="작품 <?= (int) $worksCount ?>건">
                                <?= corner_bracket_html('no-drawer__badge-corner no-corner-bracket--shine') ?>
                                <span class="no-drawer__badge-inner">
                                    <span class="no-loop-filter-rect no-drawer__badge-rect" aria-hidden="true">
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                        <span></span>
                                    </span>
                                    <span class="no-drawer__badge-count f-display-2"><?= (int) $worksCount ?></span>
                                </span>
                            </span>
                            <?php endif; ?>
                            <?php endif; ?>
                                </div>
                            </div>
                        </li>
                        <?php endforeach; ?>
                    </ul>
                    <?php endif; ?>
                </nav>
                <div class="no-drawer__address">
                    <div class="no-drawer__address-block">
