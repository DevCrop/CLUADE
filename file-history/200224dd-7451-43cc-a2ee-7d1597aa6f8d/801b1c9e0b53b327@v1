if (!class_exists('ButtonRendererFactory')) {
    final class ButtonRendererFactory
    {
        private InteractiveTagBuilder $tagBuilder;

        public function __construct(InteractiveTagBuilder $tagBuilder)
        {
            $this->tagBuilder = $tagBuilder;
        }

        public function create(string $variant): ButtonVariantRenderer
        {
            switch ($variant) {
                case 'corner':
                    return new CornerButtonRenderer($this->tagBuilder);
                case 'prev-button':
                    return new PrevButtonRenderer($this->tagBuilder);
                case 'shiny':
                    return new ShinyButtonRenderer($this->tagBuilder);
                default:
                    return new DefaultButtonRenderer();
            }
        }
    }
}

if (!class_exists('ButtonComponent')) {
    final class ButtonComponent
    {
        private ButtonRendererFactory $factory;

        public function __construct(ButtonRendererFactory $factory)
        {
            $this->factory = $factory;
        }

        /** @param array<string, mixed> $props */
        public function render(array $props): void
        {
            $variant = ButtonInput::variant($props);
            $text = ButtonInput::text($props, $variant);
            $renderer = $this->factory->create($variant);
            $renderer->render($props, $text);
        }
    }
}

$buttonComponent = new ButtonComponent(
    new ButtonRendererFactory(
        new InteractiveTagBuilder()
    )
);

$buttonComponent->render(get_defined_vars());
unset($buttonComponent);
