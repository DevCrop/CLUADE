import type {
  BaseObjectOptions,
  ResponsiveNumberValue,
  Vector2Optional,
} from "./object-common.types.js";

export interface BackgroundEnvironmentOptions {
  topColor?: number;
  bottomColor?: number;
  exposure?: number;
}

export interface BackgroundPlaneOptions {
  size?: number;
  width?: number;
  height?: number;
  segments?: number;
  curveDepth?: number;
  curvePower?: number;
}

export interface BackgroundShaderTextureOptions {
  noiseTextureUrl?: string;
  starTextureUrl?: string;
}

export interface BackgroundShaderOptions {
  textures?: BackgroundShaderTextureOptions;
}

export interface BackgroundLookOptions {
  topColor?: number;
  bottomColor?: number;
  accentColor?: number;
  starIntensity?: number;
  starDensity?: number;
  nebulaStrength?: number;
  motionStrength?: number;
  legacyMix?: number;
}

