  textures?: CloudPlaneShaderTextureOptions;
  ratio?: number;
  size?: Vector2Optional;
  chapter?: number;
  transition?: number;
  opacity?: number;
}

export interface BackgroundObjectOptions extends BaseObjectOptions {
  plane?: BackgroundPlaneOptions;
  exposure?: number;
