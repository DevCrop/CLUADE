uniform float iTime;
uniform vec2 iResolution;
uniform float uOpacity;
uniform float uFlameSpeed;
uniform float uWaveStrength;

varying vec2 vUv;

const float FLAME_STRENGTH = 1.2;
const float FLAME_SPEED = 2.0;
const float FLAME_SCALE_X = 0.75;
const float FLAME_SCALE_Y = 0.75;
const float FLAME_CENTER_X = 0.5;
const float FLAME_CENTER_Y = 0.2;
const float FLAME_FADE_MULT = 1.35;
const float FLAME_FADE_POW = 2.5;
const float FLAME_HUE = 0.0;
const float FLAME_SATURATION = 1.1;
const float FLAME_TEMPERATURE = 1.1;
const float FLAME_BASE_WIDTH = 1.8;
const float FLAME_TAPER = 2.5;
const float FLAME_VERT_STRETCH = 0.75;
const float FLAME_NOISE_DISTORTION = 1.4;
const float FLAME_EDGE_SOFTNESS = 1.2;
const float FLICKER_STRENGTH = 0.25;
const float FLICKER_SPEED = 2.0;
const float ASYMMETRY_STRENGTH = 0.01;
const float ASYMMETRY_SPEED = 0.03;
const float TEMP_MOD_STRENGTH = 0.1;
const float TEMP_MOD_SPEED = 0.3;
const float TURBULENCE_MIX = 0.4;
const float SMOKE_HEIGHT = 1.2;
const float SMOKE_STRENGTH = 0.3;

vec3 hsv2rgb(vec3 c) {
  vec3 rgb = clamp(
    abs(mod(c.x * 6.0 + vec3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0,
    0.0,
    1.0
  );
  rgb = rgb * rgb * (3.0 - 2.0 * rgb);
  return c.z * mix(vec3(1.0), rgb, c.y);
}

vec2 hash(vec2 p) {
  p = vec2(
    dot(p, vec2(127.1, 311.7)),
    dot(p, vec2(269.5, 183.3))
  );
  return -1.0 + 2.0 * fract(sin(p) * 43758.5453123);
}

float noise(in vec2 p) {
  const float K1 = 0.366025404;
  const float K2 = 0.211324865;

  vec2 cell = floor(p + (p.x + p.y) * K1);
  vec2 a = p - cell + (cell.x + cell.y) * K2;
  vec2 offset = (a.x > a.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec2 b = a - offset + K2;
  vec2 c = a - 1.0 + 2.0 * K2;

  vec3 h = max(0.5 - vec3(dot(a, a), dot(b, b), dot(c, c)), 0.0);
  vec3 grad = vec3(
    dot(a, hash(cell + 0.0)),
    dot(b, hash(cell + offset)),
    dot(c, hash(cell + 1.0))
  );

  vec3 n = h * h * h * h * grad;
  return dot(n, vec3(70.0));
}

float fbm(vec2 uv) {
  float value;
  mat2 rotScale = mat2(1.6, 1.2, -1.2, 1.6);

  value = 0.5000 * noise(uv);
  uv = rotScale * uv;
  value += 0.2500 * noise(uv);
  uv = rotScale * uv;
  value += 0.1250 * noise(uv);
  uv = rotScale * uv;
  value += 0.0625 * noise(uv);

  return 0.5 + 0.5 * value;
}

vec2 toFlameUV(vec2 uv) {
  vec2 center = vec2(FLAME_CENTER_X, FLAME_CENTER_Y);
  vec2 scale = vec2(FLAME_SCALE_X, FLAME_SCALE_Y);
  return (uv - center) / scale;
}

float getFlameNoise(vec2 flameUV) {
  float strength = FLAME_STRENGTH * uWaveStrength;
  float timeOffset = max(3.0, 1.25 * strength) * iTime * (uFlameSpeed / 3.0);
  float largeScale = fbm(strength * flameUV - vec2(0.0, timeOffset));
  float smallScale = fbm(
    strength * 2.5 * flameUV - vec2(0.0, timeOffset * 1.5)
  );
  return mix(largeScale, smallScale, TURBULENCE_MIX);
}

float getFlameShape(vec2 flameUV, float noiseValue) {
  return 1.0 - 16.0 * pow(
    max(
      0.0,
      length(
        flameUV * vec2(
          FLAME_BASE_WIDTH + flameUV.y * FLAME_TAPER,
          FLAME_VERT_STRETCH
        )
      ) - noiseValue * FLAME_NOISE_DISTORTION * uWaveStrength * max(0.0, flameUV.y + 0.25)
    ),
    FLAME_EDGE_SOFTNESS
  );
}

vec3 getFlameColor(float intensity, float tempMod) {
  vec3 col = vec3(
    1.5 * intensity,
    1.5 * pow(intensity, 3.0),
    pow(intensity, 6.0)
  );

  float temp = FLAME_TEMPERATURE + tempMod;
  if (temp != 1.0) {
    col *= temp;
    col = mix(col, vec3(1.0), clamp(temp - 1.0, 0.0, 1.0));
  }

  if (FLAME_SATURATION != 1.0) {
    float gray = dot(col, vec3(0.299, 0.587, 0.114));
    col = mix(vec3(gray), col, FLAME_SATURATION);
  }

  if (FLAME_HUE != 0.0) {
    float maxc = max(col.r, max(col.g, col.b));
    float minc = min(col.r, min(col.g, col.b));
    float delta = maxc - minc;
    float h = 0.0;
    if (delta > 0.00001) {
      if (maxc == col.r) h = mod((col.g - col.b) / delta, 6.0);
      else if (maxc == col.g) h = (col.b - col.r) / delta + 2.0;
      else h = (col.r - col.g) / delta + 4.0;
      h /= 6.0;
    }
    float s = (maxc <= 0.0) ? 0.0 : delta / maxc;
    float v = maxc;
    h = fract(h + FLAME_HUE);
    col = hsv2rgb(vec3(h, s, v));
  }

  return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
  vec2 uv = fragCoord.xy / iResolution.xy;
  uv.y = 1.0 - uv.y;

  float sway = ASYMMETRY_STRENGTH * uWaveStrength *
    noise(vec2(iTime * ASYMMETRY_SPEED * uFlameSpeed, uv.y * 2.0));
  vec2 flameUV = toFlameUV(uv + vec2(sway, 0.0));
  float noiseValue = getFlameNoise(flameUV);
  float shapeMask = getFlameShape(flameUV, noiseValue);
  float flicker = 1.0 + FLICKER_STRENGTH * noise(vec2(iTime * FLICKER_SPEED, 0.0));
  float tempMod = TEMP_MOD_STRENGTH * noise(vec2(iTime * TEMP_MOD_SPEED, 5.0));
  float flameIntensity =
    noiseValue * shapeMask * (1.5 - pow(FLAME_FADE_MULT * uv.y, FLAME_FADE_POW));
  flameIntensity = clamp(flameIntensity * flicker, 0.0, 1.0);

  vec3 flameColor = getFlameColor(flameIntensity, tempMod);
  float alpha = shapeMask * (1.0 - pow(uv.y, 3.0));

  if (SMOKE_STRENGTH > 0.0) {
    float smokeMask = smoothstep(SMOKE_HEIGHT, SMOKE_HEIGHT + 0.2, uv.y);
    vec3 smokeColor = vec3(0.2);
    flameColor = mix(flameColor, smokeColor, smokeMask * SMOKE_STRENGTH);
    alpha = mix(alpha, 0.0, smokeMask * SMOKE_STRENGTH);
  }

  fragColor = vec4(flameColor, clamp(alpha * uOpacity, 0.0, 1.0));
}

void main() {
  vec4 color;
  vec2 fragCoord = vec2(vUv.x * iResolution.x, vUv.y * iResolution.y);
  mainImage(color, fragCoord);
  gl_FragColor = color;
}
