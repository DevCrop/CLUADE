  }

  &__sublist {
    margin-top: fluid(8, 10);
    margin-left: fluid(4, 8);
    padding-left: fluid(14, 18);
    list-style: disc;
    color: var(--clr-text-body);

    li p {
      margin: 0 0 fluid(4, 6);
    }

    li:last-child p {
      margin-bottom: 0;
    }
  }

  &__group {
    padding: fluid(18, 24) 0;
    border-bottom: 1px solid rgba(15, 58, 41, 0.12);

    &:last-child {
      padding-bottom: 0;
      border-bottom: 0;
    }

    &:has(+ .no-sub-pricing-card__group--kpi-flat),
