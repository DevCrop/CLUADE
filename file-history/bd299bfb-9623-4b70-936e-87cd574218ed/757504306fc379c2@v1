.no-sub-faq--legacy {
  background: #faf7f2;

  &__txt {
    text-align: center;

    span {
      display: block;
      margin-bottom: $section-txt-kicker-mb;
      color: var(--clr-primary-def);
    }

    h2 {
      color: var(--clr-text-title);
    }

    > p {
      margin-top: $section-txt-lead-mt;
    }
  }

  &__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: fluid(12, 16);
    // 행 높이는 해당 행에서 가장 큰 셀 기준. 열린 항목끼리는 아래에서 stretch로 맞춤.
    align-items: stretch;
    max-width: fluid(760, 920);
    margin-inline: auto;

    @include mq(md) {
      grid-template-columns: 1fr;
    }
  }

  &__item {
    border: 1px solid rgba(15, 58, 41, 0.08);
    border-radius: fluid(12, 16);
    background: #e8ebe6;
    padding: fluid(12, 16) fluid(16, 22);
    display: flex;
    transition: background-color var(--duration-fast) var(--ease-out);

    &:not(.is-open) {
      align-self: start;
      min-height: fluid(72, 86);
    }

    &.is-open {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      min-height: unset;
      background: #225e49;
    }
  }

  &__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: fluid(10, 14);
    width: 100%;
    border: none;
    background: transparent;
    cursor: pointer;
    text-align: left;
    padding: 0;
    color: inherit;

    .txt {
      flex: 1;
      min-width: 0;
      color: var(--clr-text-title);
      line-height: 1.35;
    }
  }

  &__item.is-open &__trigger .txt {
    color: var(--clr-text-title-invert);
  }

  &__ico {
    position: relative;
    flex-shrink: 0;
    width: fluid(30, 36);
    height: fluid(30, 36);
    border-radius: 50%;
    background: #225e49;
    color: var(--clr-text-title-invert);
  }

  &__ico-symbol {
    position: absolute;
    left: 50%;
    top: 50%;
    display: block;
    width: fluid(14, 16);
    height: fluid(14, 16);
    font-size: 0;
    line-height: 0;
    transition:
      opacity var(--duration-micro) var(--ease-out),
      transform var(--duration-base) var(--ease-standard);

    &::before,
    &::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      background: currentColor;
      transform: translate(-50%, -50%);
      border-radius: 999px;
    }

    // 가로 선
    &::before {
      width: 100%;
      height: 2px;
    }
  }

  &__ico-symbol--plus {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);

    // 세로 선 (플러스 전용)
    &::after {
      width: 2px;
      height: 100%;
    }
  }

  &__ico-symbol--minus {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);

    // 마이너스는 세로 선 없음
    &::after {
      display: none;
    }
  }

  &__item.is-open &__ico {
    background: #fff;
    color: var(--clr-primary-def);
  }

  &__item.is-open &__ico-symbol--plus {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  &__item.is-open &__ico-symbol--minus {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg);
  }

  &__panel {
    margin-top: fluid(10, 12);
    padding-top: fluid(10, 14);
    border-top: 1px solid rgba(255, 255, 255, 0.22);

    p {
      color: var(--clr-text-body);
      line-height: 1.72;
    }
  }

  &__item.is-open &__panel {
    flex: 1;
    min-height: 0;
  }

  &__item.is-open &__panel p {
    color: var(--clr-text-body-invert);
  }

  &__item:not(.is-open) &__panel {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }
}

