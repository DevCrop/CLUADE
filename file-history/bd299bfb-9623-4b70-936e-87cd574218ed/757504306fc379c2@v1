        transform: translate3d(0, fluid(-28, 48), 0);
        &.is-visible {
          transform: translate3d(0, 0, 0);
        }
      }

      &--bottom {
        transform: translate3d(0, fluid(28, 48), 0);
        &.is-visible {
          transform: translate3d(0, 0, 0);
        }
      }
    }
  }
}

.no-request-complete {
  height: calc(100vh - var(--header-height));
  margin-top: var(--header-height);
  background: #0f3a29;
  position: relative;
  overflow-x: clip;
  @include flex-center();

  &__grass {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    transform: translate3d(fluid(-48, -72), 0, 0);
    opacity: 0;
    transition:
      transform 0.72s var(--ease-standard),
      opacity 0.48s var(--ease-out);

    &.is-visible {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      transform: none;
      opacity: 1;
      transition: none;
    }

    img {
      height: 100%;
      object-fit: contain;
    }
  }

  &__card {
    position: relative;
    z-index: 2;
    max-width: fluid(640, 820);
    margin: 0 auto;
    padding: fluid(32, 52) fluid(24, 44);
    border: 1px solid rgba(34, 109, 82, 0.12);
    border-radius: fluid(14, 20);
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 fluid(18, 28) fluid(42, 56) rgba(15, 58, 41, 0.08);
    text-align: center;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  &__icon {
    @include flex-center();
    width: fluid(68, 84);
    height: fluid(68, 84);
    margin: 0 auto fluid(20, 24);
    border-radius: 999px;
    background: color-mix(in srgb, var(--clr-primary-100) 72%, #fff 28%);
    color: var(--clr-primary-700);

    i {
      font-size: fluid(28, 34);
    }
  }

  &__eyebrow {
    @include section-kicker();
    display: inline-block;
  }

  &__title {
    margin-top: fluid(12, 18);
    color: var(--clr-text-title);
  }

  &__desc {
    max-width: fluid(480, 620);
    margin: fluid(14, 20) auto 0;
    color: var(--clr-text-body);
  }

  &__note {
    margin-top: fluid(12, 16);
    color: var(--clr-text-desc);
  }

  &__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: fluid(10, 14);
    margin-top: fluid(24, 32);

    .no-button {
      min-width: fluid(180, 220);
      justify-content: center;
    }

    @include mq(sm) {
      flex-direction: column;

      .no-button {
        width: 100%;
      }
    }
  }
}
