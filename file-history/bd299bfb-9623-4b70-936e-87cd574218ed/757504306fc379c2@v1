        line-height: 1.68;
      }
    }

    .--checklist {
      margin-top: fluid(12, 16);
      color: var(--clr-text-body);

      li {
        align-items: flex-start;
        gap: fluid(6, 8);
      }

      i.fa-check {
        width: fluid(14, 16);
        height: fluid(14, 16);
        font-size: fluid(9, 10);
        margin-top: 0.3em;
      }

      p {
        line-height: 1.72;
      }
    }

    // 카드 내 최상위 섹션 제목: Core Modules / Target KPI 등 (f-heading-5)
    .no-sub-pricing-card__kpi-heading {
      color: var(--clr-primary-900);
    }

    &--kpi-flat,
    &--kpi-tiered {
      .no-sub-pricing-card--pricing & {
        display: flex;
        flex: 1;
        flex-direction: column;
        width: 100%;
        padding: fluid(18, 22);
        border: 1px solid rgba(29, 93, 68, 0.2);
