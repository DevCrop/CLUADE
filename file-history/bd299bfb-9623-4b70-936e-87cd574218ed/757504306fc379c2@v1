@use "../abstract" as *;

.no-sub-who__txt > span,
.no-sub-what__txt > span,
.no-sub-market__txt > span,
.no-sub-pricing__txt > span,
.no-sub-short__txt > span,
.no-sub-works__txt > span,
.no-sub-faq__txt > span,
.no-request-complete__eyebrow {
  @include section-kicker();
}

.no-sub-visual {
  height: fluid(360, 560);
  margin-top: var(--header-height);
  @include flex-center();
  overflow: hidden;
  position: relative;
  color: var(--clr-text-title-invert);

  &:not(.no-sub-visual--light) &__inner {
    h2 {
      color: var(--clr-text-title-invert);
    }

    p {
      color: var(--clr-text-body-invert);
    }
  }

  &__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    p {
      margin-top: fluid(16, 24);
    }
    a {
      margin-top: fluid(24, 40);
      @include font("f-body-2");
    }
  }
  &__img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;

    height: 100%;
    z-index: -1;
    img {
      width: 100%;
      height: 100%;
      display: block;
    }
  }

  &--light {
    height: auto;
    padding-top: calc(var(--header-height) + fluid(32, 56));
    padding-bottom: fluid(32, 56);
    background: #ebebeb;
    color: var(--clr-text-title);

    .no-sub-visual__inner {
      p {
        color: var(--clr-text-body);
        strong {
          font-weight: 600;
          color: var(--clr-text-title);
        }
      }
      a {
        margin-top: fluid(20, 32);
      }
    }
  }

  &--compact {
    min-height: 0;
    padding-top: fluid(64, 80);
    padding-bottom: fluid(64, 80);
    background: var(--clr-primary-50);

    .no-sub-visual__inner {
      align-items: center;
      text-align: center;
      margin: 0 auto;

      h2 {
        color: var(--clr-text-title);
      }

      p {
        margin-top: fluid(10, 14);
        color: var(--clr-text-body);
      }

      a {
        margin-top: fluid(16, 20);
      }
    }
  }
}

.no-sub-who {
  &__txt {
    text-align: center;
    span {
      display: block;
      margin-bottom: $section-txt-kicker-mb;
      color: var(--clr-primary-def);
    }
  }

  &__lead {
    margin-top: $section-txt-lead-mt;
  }

  &.no-sub-who--quad {
    &__txt,
    .no-sub-who__txt {
      span {
        color: var(--clr-secondary-900);
      }
    }

    .--cnt > ul {
      grid-template-columns: repeat(2, 1fr);

      @include mq(sm) {
        grid-template-columns: 1fr;
      }

      > li {
        background: color-mix(in srgb, var(--clr-secondary-def) 14%, #fff);

        .--arrow {
          background: var(--clr-secondary-800);
        }

        .--desc {
          background: var(--clr-secondary-def);
        }
      }
    }
  }

  .--cnt {
    margin-top: fluid(24, 40);
    > ul {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: fluid(16, 24);
      @include mq(md) {
        grid-template-columns: repeat(2, 1fr);
      }
      @include mq(sm) {
        grid-template-columns: 1fr;
      }

      > li {
        background: #d1dcd3;
        padding: fluid(24, 40) fluid(16, 24);
        @include flex-center();
        border-radius: fluid(8, 12);
        flex-direction: column;
        min-height: 100%;
        text-align: center;
        justify-content: flex-start;
        > * {
          text-align: center;
        }
        p {
          margin-top: fluid(8, 12);
        }
        .--arrow {
          @include flex-center();
          width: fluid(28, 36);
          height: fluid(28, 36);
          border-radius: 999px;
          background: #0f3a29;
          color: var(--clr-text-title-invert);
          margin-top: fluid(12, 18);
        }
        .--desc {
          margin-top: fluid(12, 18);
          background: #226d52;
          color: var(--clr-text-title-invert);
          padding: fluid(16, 32) fluid(8, 16);
          border-radius: fluid(8, 12);
          flex: 1;
          width: 100%;

          p {
            color: var(--clr-text-body-invert);
          }

          .no-sub-who__solution-note {
            display: block;
            margin-top: fluid(6, 10);
            color: var(--clr-text-body-invert);
          }
        }
      }

      // 사진 카드 전용 ul — 기존 li 스타일 초기화
      &.no-sub-who__cards > li {
        background: transparent;
        padding: 0;
        border-radius: 0;
        display: block;
        flex-direction: unset;
        align-items: unset;
        justify-content: unset;
        text-align: unset;
        min-height: 100%;
      }
    }
  }
  // Photo card — Who We Serve
  &__cards {
    align-items: stretch !important;
  }

  &-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: fluid(340, 480);
    background: #0f3a29;
    border-radius: fluid(12, 18);
    overflow: hidden;
    position: relative;

    &__media {
      position: absolute;
      inset: 0;
      overflow: hidden;
      background: #0f3a29;
      z-index: 0;

      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.34);
      }

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        filter: blur(2.6px);
        transform: scale(1.04);
      }
    }

    &__body {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      text-align: left;
      padding: 0;
      z-index: 1;

      &::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(
            to top,
            rgba(0, 0, 0, 0.86) 0%,
            rgba(0, 0, 0, 0.62) 38%,
            rgba(0, 0, 0, 0) 100%
          ),
          linear-gradient(
            to bottom,
            rgba(0, 0, 0, 0.36) 0%,
            rgba(0, 0, 0, 0) 42%
          );
      }
    }

    &__copy {
      position: relative;
      z-index: 1;
      width: 100%;
      min-height: 0;
      display: flex;
      flex-direction: column;
      gap: fluid(6, 10);
      justify-content: flex-start;
      padding: fluid(22, 32) fluid(18, 28);
      background: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.52) 0%,
        rgba(0, 0, 0, 0) 100%
      );
    }

    &__title {
      @include font("f-heading-5");
      font-weight: 700;
      color: var(--clr-text-title-invert);
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.35);
      margin: 0;
    }

    &__desc {
      @include font("f-body-3");
      font-weight: 400;
      color: var(--clr-text-body-invert);
      margin-top: 0;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.32);
      margin-bottom: 0;
    }

    @include mq(sm) {
      min-height: 320px;

      &__media img {
        filter: blur(2px);
      }
    }
  }

  .--info {
    margin-top: fluid(64, 128);
    text-align: center;

    > h4 {
      br {
        @include mq(md) {
          display: block;
        }
      }
    }

    ul {
      margin-top: fluid(32, 64);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      @include mq(md) {
        grid-template-columns: repeat(2, 1fr);
      }
      @include mq(sm) {
        grid-template-columns: 1fr;
      }
      li {
        @include flex-center();
        flex-direction: column;
        gap: fluid(16, 24);
        padding: 0 fluid(24, 64);
        border-right: 1px solid #d1dcd3;
        &:last-child {
          border-right: none;
        }
        @include mq(md) {
          border-right: none;
        }
      }
      .icon {
        width: fluid(56, 80);
        height: fluid(56, 80);
      }
      .txt {
        h4 {
        }
        p {
          margin-top: fluid(8, 12);
        }
      }
    }
  }
}

.no-sub-what {
  &__txt {
    text-align: center;

    span {
      display: block;
      margin-bottom: $section-txt-kicker-mb;
      color: var(--clr-primary-def);
    }
  }

  .--cnt {
    margin-top: fluid(24, 40);

    > ul {
      display: grid;
      gap: fluid(16, 24);
      // 모바일 퍼스트: 기본 1열 → (sm 초과) 2열 → (md 초과) 6열 지그재그
      // max-width만 쓰면 컴파일 순서에 따라 span 2가 나중에 나와 미디어쿼리를 덮을 수 있음
      grid-template-columns: 1fr;

      > li {
        grid-column: auto;
        min-height: fluid(220, 280);
        perspective: 1200px;
      }

      @include mq(545, min) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      @include mq(769, min) {
        grid-template-columns: repeat(6, minmax(0, 1fr));

        > li {
          grid-column: span 2;

          &:nth-child(1) {
            grid-column: 1 / span 2;
          }

          &:nth-child(2) {
            grid-column: 3 / span 2;
          }

          &:nth-child(3) {
            grid-column: 5 / span 2;
          }

          &:nth-child(4) {
            grid-column: 2 / span 2;
          }

          &:nth-child(5) {
            grid-column: 4 / span 2;
          }
        }
      }
    }
  }
}

.no-sub-what.no-sub-what--quad {
  .--cnt > ul {
    @include mq(769, min) {
      grid-template-columns: repeat(4, minmax(0, 1fr));

      > li {
        grid-column: auto;
        min-height: fluid(200, 260);
      }
    }
  }
}

.no-sub-what-card {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.45s var(--ease-standard);

  &__face {
    @include flex-center();
    position: absolute;
    inset: 0;
    flex-direction: column;
    gap: fluid(12, 18);
    padding: fluid(16, 24);
    border-radius: fluid(10, 14);
    backface-visibility: hidden;
    text-align: center;

    // base/_utils 전역 `br { display:none }`(md↓) 예외 — 카드 인용 줄바꿈 유지
    br {
      @include mq(md) {
        display: inline;
      }
    }

    h4 {
      color: var(--clr-text-title);
    }

    p {
      color: var(--clr-text-body);
    }
  }

  &__face--front {
    background: #ebe6d6;
  }

  &__face--back {
    background: #aa9663;
    transform: rotateY(180deg);

    p {
      color: var(--clr-text-title-invert);
    }
  }
}

.no-sub-what .--cnt > ul > li:hover .no-sub-what-card,
.no-sub-what .--cnt > ul > li:focus-within .no-sub-what-card {
  transform: rotateY(180deg);
}

.no-sub-market {
  overflow: hidden;
  &__txt {
    text-align: center;
    span {
      display: block;
      margin-bottom: $section-txt-kicker-mb;
      color: var(--clr-primary-def);
    }
    p {
      margin-top: $section-txt-lead-mt;
    }
  }
  .--cnt {
    margin-top: fluid(48, 72);
    display: grid;
    grid-template-columns: 1fr 26% 1fr;
    grid-template-rows: auto auto;
    column-gap: fluid(24, 48);
    row-gap: fluid(24, 36);

    > .circles {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
      pointer-events: none;
    }

    > .block:nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    > .block:nth-child(2) {
      grid-column: 3;
      grid-row: 1;
    }
    > .block:nth-child(4) {
      grid-column: 1;
      grid-row: 2;
    }
    > .block:nth-child(5) {
      grid-column: 3;
      grid-row: 2;
    }

    > .block:nth-child(1),
    > .block:nth-child(4) {
      padding-right: fluid(24, 40);
      text-align: right;

      .--bullet li {
        padding-left: 0;
        padding-right: fluid(7, 16);

        &::before {
          left: auto;
          right: 0;
        }
      }
    }

    > .block:nth-child(2),
    > .block:nth-child(5) {
      padding-left: fluid(24, 40);
    }

    > .block {
      background: transparent;
      border-radius: fluid(8, 12);

      > span {
        color: var(--clr-primary-def);
      }

      h4 {
        margin-top: fluid(2, 4);

        strong {
          color: var(--clr-primary-def);
          font-weight: 700;
        }
      }

      p {
        margin-top: fluid(8, 12);
      }

      .no-sub-market__block-copy {
        margin-top: fluid(8, 12);
      }

      .--bullet {
        margin-top: fluid(8, 10);

        strong {
          color: var(--clr-primary-def);
          font-weight: 700;
        }
      }
    }

    @include mq(lg) {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      row-gap: fluid(12, 16);

      > .circles {
        grid-column: 1;
        grid-row: auto;
        order: -1;
        width: 72%;
        margin-inline: auto;
        padding: fluid(40, 60) 0;
      }

      > .block:nth-child(1),
      > .block:nth-child(2),
      > .block:nth-child(4),
      > .block:nth-child(5) {
        grid-column: 1;
        grid-row: auto;
      }

      > .block:nth-child(1),
      > .block:nth-child(4) {
        text-align: left;

        .--bullet li {
          padding-left: fluid(7, 16);
          padding-right: 0;

          &::before {
            left: 0;
            right: auto;
          }
        }
      }

      > .block {
        background: #fff;
        padding: fluid(16, 24);
      }
    }
  }
  .--info {
    margin-top: 7.2rem;
    display: grid;
    grid-template-columns: 1fr 26% 1fr;
    column-gap: fluid(24, 48);
    row-gap: fluid(16, 24);
    align-items: start;

    @include mq(lg) {
      grid-template-columns: 1fr;
    }

    > h4 {
      margin: 0;
      grid-column: 1;
      color: var(--clr-primary-800);
    }

    > ul {
      grid-column: 2 / 4;
      margin-top: 0;
      display: flex;
      flex-direction: column;
      gap: fluid(16, 18);

      > li {
        display: flex;
        flex-direction: column;
        background: #c9d4ce;
        border-radius: fluid(10, 14);
        padding: fluid(18, 26) fluid(18, 24);

        &:first-child {
          background: #ece6d6;
        }

        &:nth-child(2) {
          background: #c9d4ce;
        }
      }

      h5 {
        @include font("f-heading-5");
        font-weight: 600;
        color: var(--clr-text-title);
      }

      p {
        margin-top: fluid(10, 14);
        color: var(--clr-text-body);
      }
    }
  }
}

.no-sub-market.no-sub-market--cp {
  .--info {
    > ul {
      @include mq(md) {
        margin-top: fluid(18, 26);
      }
    }
  }
}

.no-market-orbit {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  margin-inline: auto;

  &__ring {
    position: absolute;
    border-radius: 50%;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
  }

  &__ring--outer {
    width: 100%;
    height: 100%;
    border: 2px dashed rgba(15, 58, 41, 0.55);
    background: transparent;
  }

  &__ring--lv3 {
    width: 82%;
    height: 82%;
    background: #83bfab;
  }

  &__ring--lv2 {
    width: 64%;
    height: 64%;
    background: #4ba483;
  }

  &__ring--lv1 {
    width: 46%;
    height: 46%;
    background: #2b7e5b;
  }

  &__center {
    @include flex-center();
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 40%;
    height: 40%;
    color: var(--clr-text-title-invert);
    flex-direction: column;
    gap: fluid(8, 12);
    z-index: 2;
  }

  &__center-logo {
    position: relative;
    width: fluid(26, 38);
    height: fluid(36, 52);
    display: block;

    &::before,
    &::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 80% 15% 80% 15%;
      border: 3px solid #fff;
      transform: rotate(45deg);
    }

    &::after {
      transform: rotate(-135deg);
      opacity: 0.85;
    }
  }

  &__center-brand {
    font-size: fluid(22, 44);
    font-weight: 700;
  }

  &__center-logo-img {
    width: fluid(88, 120);
    height: auto;
    object-fit: contain;
    display: block;

    @include mq(lg) {
      width: 64px;
    }
  }

  &__satellites {
    position: absolute;
    inset: 0%;
    animation: no-orbit-spin 22s linear infinite;
    z-index: 3;
  }

  &__satellite {
    position: absolute;
    inset: 0;
    transform: rotate(var(--angle));
    transform-origin: center;
  }

  /* li의 rotate(var(--angle))로 궤도에 올려둔 만큼 아이콘은 역회전 → 화면 기준 정방향 유지 */
  &__satellite-icon {
    @include flex-center();
    position: absolute;
    left: 50%;
    top: calc(0% - fluid(14, 22));
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--angle, 0deg)));
    width: fluid(48, 80);
    height: fluid(48, 80);
    border-radius: 50%;
    padding: fluid(10, 14);
    background: #1f7555;
    color: var(--clr-text-title-invert);
    animation: no-orbit-spin-rev 22s linear infinite;

    i {
      font-size: fluid(24, 32);
    }
  }
}

@keyframes no-orbit-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes no-orbit-spin-rev {
  from {
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--angle, 0deg)));
  }
  to {
    transform: translate(-50%, -50%)
      rotate(calc(-1 * var(--angle, 0deg) - 360deg));
  }
}

@media (prefers-reduced-motion: reduce) {
  .no-market-orbit__satellites,
  .no-market-orbit__satellite-icon {
    animation: none;
  }
}

.no-sub-pricing {
  background: url("/resource/images/sub/sub-pricing-bg.jpg");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  &__txt {
    text-align: center;

    .no-sub-pricing__toggle-btn {
      color: var(--clr-text-title-invert);
    }

    > span:first-of-type {
      display: block;
      color: var(--clr-secondary-def);
      margin-bottom: $section-txt-kicker-mb;
    }

    h2 {
      color: var(--clr-text-title-invert);
    }

    p {
      max-width: fluid(560, 740);
      margin: $section-txt-lead-mt auto 0;
      color: var(--clr-text-body-invert);
    }
  }

  &__highlights {
    margin-top: fluid(26, 34);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: fluid(12, 18);

    @include mq(md) {
      grid-template-columns: 1fr;
    }

    > li {
      border: 1px solid rgba(152, 208, 184, 0.58);
      border-radius: fluid(10, 14);
      background: rgba(28, 106, 81, 0.55);
      padding: fluid(18, 24);
      min-height: fluid(120, 154);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);

      h4 {
        color: var(--clr-text-title-invert);
      }

      p {
        margin-top: fluid(8, 12);
        color: var(--clr-text-body-invert);
      }
    }
  }

  &__plans {
    margin-top: fluid(18, 32);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: fluid(20, 28);

    @include mq(md) {
      grid-template-columns: 1fr;
    }
  }

  // pricing 페이지 전용: 토글 + 오디언스 스택 (기존 highlights / plans 마크업 그대로)
  &[data-pricing-audience] {
    .no-sub-pricing__toggle {
      margin-top: fluid(18, 26);
      display: flex;
      justify-content: center;
    }

    .no-sub-pricing__toggle-track {
      position: relative;
      display: flex;
      width: 100%;
      max-width: fluid(480, 660);
      padding: fluid(4, 5);
      border: 1.5px solid rgba(29, 93, 68, 0.22);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      box-sizing: border-box;
    }

    .no-sub-pricing__toggle-thumb {
      position: absolute;
      top: fluid(4, 5);
      bottom: fluid(4, 5);
      left: fluid(4, 5);
      width: calc(50% - fluid(4, 5));
      border-radius: 999px;
      background: #1d5d44;
      transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      pointer-events: none;
      z-index: 0;
    }

    .no-sub-pricing__toggle-track[data-audience="retailer"]
      .no-sub-pricing__toggle-thumb {
      transform: translateX(100%);
    }

    .no-sub-pricing__toggle-btn {
      position: relative;
      z-index: 1;
      flex: 1;
      padding: fluid(11, 15) fluid(16, 24);
      border: none;
      border-radius: 999px;
      background: transparent;
      color: var(--clr-text-title);
      cursor: pointer;
      transition: color 0.2s ease;
      white-space: nowrap;
