      align-items: center;
      font-size: fluid(30, 44);
      font-weight: 700;
      letter-spacing: -0.03em;
      color: var(--clr-text-title);
      line-height: 1;
      display: inline-flex;
      align-items: center;
      gap: fluid(4, 6);
