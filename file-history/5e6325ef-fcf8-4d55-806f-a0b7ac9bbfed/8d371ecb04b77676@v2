@use "../abstract" as *;

.no-chip {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;

  &--tool {
    gap: fluid(4, 6);
    padding: fluid(4, 6) fluid(8, 12);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.44);
    font-family: var(--fm-ui);
    font-size: fluid(10, 12);
    letter-spacing: 0.06em;
    flex-shrink: 0;
  }
  &__label {
    font-family: var(--fm-ui);
  }

  &--category {
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    @include font("f-body-3");
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--clr-white-100);
  }

  &__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;

    svg {
      width: fluid(12, 14);
      height: fluid(12, 14);
      fill: currentColor;
      opacity: 0.5;
      display: block;
    }
  }
}
