import * as THREE from "three";
import { fetchWorksList } from "../../../api/getWork.js";
import type { WorkApiItem } from "../../../types/work.types.js";
import {
  type ProofRotationStrategy,
  ScrollAcceleratingRotation,
  DEFAULT_SCROLL_ACCELERATING_CONFIG,
} from "./ProofRotationStrategy.js";
import atmosphereVertexShader from "../../../../shaders/earth/vertex.glsl?raw";

const PLANET_ATMOSPHERE_FRAGMENT = `
varying vec3 vNormal;
varying vec3 eyeVector;
uniform float atmOpacity;
uniform float atmPowFactor;
uniform float atmMultiplier;
uniform vec3 atmColor;

void main() {
    float dotP = max(0.0, dot(vNormal, eyeVector));
    float factor = pow(dotP, atmPowFactor) * atmMultiplier;
    vec3 rimColor = mix(atmColor * 0.82, vec3(1.0), 0.28 + dotP * 0.18);
    gl_FragColor = vec4(rimColor, atmOpacity) * factor;
}
`;

const CARD_HEIGHT = 3.4;
const CARD_WIDTH = CARD_HEIGHT * (16 / 9);
const MAX_PROOF_IMAGES = 12;
const FALLBACK_COUNT = 8;
const PLANET_RADIUS = 6.5;
// Cylinder radius used for card bending — smaller than ring radius gives more visible curl
const CARD_CURVE_RADIUS = 6.0;
const FALLBACK_COLORS = [
  0x6644aa, 0x4488bb, 0x44aacc, 0x228866, 0x886622, 0xaa4466, 0x664488, 0x4466aa,
] as const;

function computeRadius(cardCount: number): number {
  const minArc = CARD_WIDTH * 1.15;
  return Math.max(10, (minArc * cardCount) / (2 * Math.PI));
}

/**
 * Creates a PlaneGeometry whose vertices are bent cylindrically around the Y-axis,
 * so the card's edges curve inward toward the planet (local -Z = radially inward).
 * Each vertex at local x=lx is moved to arc position on a cylinder of curveRadius:
 *   newX = curveRadius * sin(lx / curveRadius)
 *   newZ = -curveRadius * (1 - cos(lx / curveRadius))   ← negative = toward planet
 */
function createCurvedCardGeometry(
  width: number,
  height: number,
  curveRadius: number,
): THREE.BufferGeometry {
  const geo = new THREE.PlaneGeometry(width, height, 20, 1);
  const pos = geo.attributes.position as THREE.BufferAttribute;
  for (let i = 0; i < pos.count; i++) {
    const lx = pos.getX(i);
    const dAngle = lx / curveRadius;
    pos.setX(i, curveRadius * Math.sin(dAngle));
    pos.setZ(i, -curveRadius * (1.0 - Math.cos(dAngle)));
  }
  pos.needsUpdate = true;
  geo.computeVertexNormals();
  return geo;
}

function loadImageTexture(
  loader: THREE.TextureLoader,
  url: string,
): Promise<THREE.Texture | null> {
  return new Promise((resolve) => {
    loader.load(
      url,
      (texture) => {
        texture.minFilter = THREE.LinearFilter;
        texture.generateMipmaps = false;
        resolve(texture);
      },
      undefined,
      () => resolve(null),
    );
  });
}

function createCardMaterial(
  texture: THREE.Texture | null,
  color: number,
): THREE.MeshBasicMaterial {
  const mat = new THREE.MeshBasicMaterial({
    map: texture ?? null,
    color: texture ? 0xffffff : color,
    side: THREE.DoubleSide,
  });

  if (texture) {
    // Flip UV.x on back face so back-side texture is not mirrored
    mat.onBeforeCompile = (shader) => {
      shader.fragmentShader = shader.fragmentShader.replace(
        "vec4 sampledDiffuseColor = texture2D( map, vMapUv );",
        `vec2 _uv = gl_FrontFacing ? vMapUv : vec2(1.0 - vMapUv.x, vMapUv.y);
        vec4 sampledDiffuseColor = texture2D( map, _uv );`,
      );
    };
    mat.needsUpdate = true;
  }

  return mat;
}

function selectProofItems(items: WorkApiItem[], max: number): WorkApiItem[] {
  const awardedVideo = items.filter((i) => i.isAwarded && i.thumbnailVideo);
  const awardedImage = items.filter((i) => i.isAwarded && !i.thumbnailVideo && i.thumbnailImage);
  const otherVideo   = items.filter((i) => !i.isAwarded && i.thumbnailVideo);
  const otherImage   = items.filter((i) => !i.isAwarded && !i.thumbnailVideo && i.thumbnailImage);

  const result: WorkApiItem[] = [...awardedVideo];
  if (result.length < max) result.push(...awardedImage);
  if (result.length < max) result.push(...otherVideo);
  if (result.length < max) result.push(...otherImage);
  return result.slice(0, max);
}

export class AboutProofRenderer {
  private _renderer: THREE.WebGLRenderer | null = null;
  private _scene: THREE.Scene | null = null;
  private _camera: THREE.PerspectiveCamera | null = null;
  private _group: THREE.Group | null = null;
  private _planetGroup: THREE.Group | null = null;
  private _geometries: THREE.BufferGeometry[] = [];
  private _materials: THREE.Material[] = [];
  private _textures: THREE.Texture[] = [];
  private _videoElements: HTMLVideoElement[] = [];
  private _rafId: number | null = null;
  private _resizeObserver: ResizeObserver | null = null;
  private _intersectionObserver: IntersectionObserver | null = null;
  private _rendering = false;
  private _disposed = false;
  private _canvas: HTMLCanvasElement | null = null;
  private _scrollProgress = 0;
  private _rotationStrategy: ProofRotationStrategy;

  constructor(rotationStrategy?: ProofRotationStrategy) {
    this._rotationStrategy =
      rotationStrategy ?? new ScrollAcceleratingRotation(DEFAULT_SCROLL_ACCELERATING_CONFIG);
  }

  setScrollProgress(progress: number): void {
    const prev = this._scrollProgress;
    this._scrollProgress = Math.max(0, Math.min(1, progress));
    this._rotationStrategy.feed(this._scrollProgress, Math.abs(this._scrollProgress - prev));
  }

  async init(canvas: HTMLCanvasElement): Promise<void> {
    this._canvas = canvas;

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearAlpha(0);
    this._renderer = renderer;

    const scene = new THREE.Scene();
    this._scene = scene;

    const w = Math.max(canvas.clientWidth, 1);
    const h = Math.max(canvas.clientHeight, 1);
    const camera = new THREE.PerspectiveCamera(65, w / h, 0.1, 1000);
    camera.position.set(0, 3, 22);
    camera.lookAt(0, 0, 0);
    this._camera = camera;

    scene.add(new THREE.AmbientLight(0xffffff, 0.6));
    const dirLight = new THREE.DirectionalLight(0xdfe8ff, 1.4);
    dirLight.position.set(10, 12, 8);
    scene.add(dirLight);

    const group = new THREE.Group();
    this._group = group;
    scene.add(group);

    // Fetch works and planet textures in parallel
    const [worksResult, planetGroup] = await Promise.all([
      fetchWorksList(0, MAX_PROOF_IMAGES, null, undefined, true).catch(() => null),
      this._buildPlanet(),
    ]);

    if (this._disposed) return;

    if (planetGroup) {
      this._planetGroup = planetGroup;
      scene.add(planetGroup);
    }

    const items = worksResult ? selectProofItems(worksResult.items, MAX_PROOF_IMAGES) : [];

    if (items.length > 0) {
      const loader = new THREE.TextureLoader();
      const textures = await Promise.all(
        items.map((item) => this._loadItemMedia(loader, item)),
      );
      if (this._disposed) return;
      const radius = computeRadius(textures.length);
      textures.forEach((texture, i) => {
        if (texture) this._textures.push(texture);
        this._addCard(group, i, textures.length, texture, radius);
      });
    } else {
      const radius = computeRadius(FALLBACK_COUNT);
      for (let i = 0; i < FALLBACK_COUNT; i++) {
        this._addCard(group, i, FALLBACK_COUNT, null, radius);
      }
    }

    this._syncSize();
    this._observeResize();
    this._observeVisibility();
  }

  dispose(): void {
    this._disposed = true;
    this._stopRaf();

    this._resizeObserver?.disconnect();
    this._resizeObserver = null;

    this._intersectionObserver?.disconnect();
    this._intersectionObserver = null;

    this._geometries.forEach((g) => g.dispose());
    this._geometries = [];

    this._materials.forEach((m) => m.dispose());
    this._materials = [];

    this._textures.forEach((t) => t.dispose());
    this._textures = [];

    this._videoElements.forEach((v) => {
      v.pause();
      v.src = "";
      v.load();
    });
    this._videoElements = [];

    this._renderer?.dispose();
    this._renderer?.forceContextLoss();
    this._renderer = null;
    this._scene = null;
    this._camera = null;
    this._group = null;
    this._planetGroup = null;
    this._canvas = null;
  }

  private async _buildPlanet(): Promise<THREE.Group | null> {
    const loader = new THREE.TextureLoader();
    try {
      const [dayMap, bumpMap] = await Promise.all([
        new Promise<THREE.Texture>((res, rej) =>
          loader.load("/resource/images/texture/moon/moonmap4k.jpg", res, undefined, rej),
        ),
        new Promise<THREE.Texture>((res, rej) =>
          loader.load("/resource/images/texture/moon/moonbump4k.jpg", res, undefined, rej),
        ),
      ]);

      if (this._disposed) {
        dayMap.dispose();
        bumpMap.dispose();
        return null;
      }

      dayMap.colorSpace = THREE.SRGBColorSpace;
      this._textures.push(dayMap, bumpMap);

      const geo = new THREE.SphereGeometry(PLANET_RADIUS, 48, 32);
      const mat = new THREE.MeshStandardMaterial({
        map: dayMap,
        bumpMap,
        bumpScale: 0.018,
        roughness: 0.42,
        metalness: 0.05,
      });
      this._geometries.push(geo);
      this._materials.push(mat);
      const mesh = new THREE.Mesh(geo, mat);

      const atmGeo = new THREE.SphereGeometry(PLANET_RADIUS * 1.16, 48, 32);
      const atmMat = new THREE.ShaderMaterial({
        vertexShader: atmosphereVertexShader as string,
        fragmentShader: PLANET_ATMOSPHERE_FRAGMENT,
        uniforms: {
          atmOpacity: { value: 0.58 },
          atmPowFactor: { value: 4.3 },
          atmMultiplier: { value: 8.4 },
          atmColor: { value: new THREE.Color(0.92, 0.96, 1.0) },
        },
        blending: THREE.AdditiveBlending,
        side: THREE.BackSide,
        transparent: true,
        depthWrite: false,
      });
      this._geometries.push(atmGeo);
      this._materials.push(atmMat);
      const atmMesh = new THREE.Mesh(atmGeo, atmMat);

      const group = new THREE.Group();
      group.add(mesh);
      group.add(atmMesh);
      return group;
    } catch {
      return null;
    }
  }

  private _createVideoElement(url: string): HTMLVideoElement {
    const video = document.createElement("video");
    video.src = url;
    video.loop = true;
    video.muted = true;
    video.playsInline = true;
    video.crossOrigin = "anonymous";
    void video.play();
    this._videoElements.push(video);
    return video;
  }

  private _createVideoTexture(video: HTMLVideoElement): THREE.VideoTexture {
    const texture = new THREE.VideoTexture(video);
    texture.minFilter = THREE.LinearFilter;
    texture.magFilter = THREE.LinearFilter;
    texture.generateMipmaps = false;
    return texture;
  }

  private async _loadItemMedia(
    loader: THREE.TextureLoader,
    item: WorkApiItem,
  ): Promise<THREE.Texture | null> {
    if (item.thumbnailVideo) {
      const video = this._createVideoElement(item.thumbnailVideo);
      return this._createVideoTexture(video);
    }
    const imageUrl = item.thumbnailImage;
    if (imageUrl) {
      return loadImageTexture(loader, imageUrl);
    }
    return null;
  }

  private _addCard(
    group: THREE.Group,
    index: number,
    total: number,
    texture: THREE.Texture | null,
    radius: number,
  ): void {
    const angle = (index / total) * Math.PI * 2;
    const x = radius * Math.cos(angle);
    const z = radius * Math.sin(angle);

    const geo = createCurvedCardGeometry(CARD_WIDTH, CARD_HEIGHT, CARD_CURVE_RADIUS);
    this._geometries.push(geo);

    const mat = createCardMaterial(
      texture,
      FALLBACK_COLORS[index % FALLBACK_COLORS.length],
    );
    this._materials.push(mat);

    const mesh = new THREE.Mesh(geo, mat);
    mesh.position.set(x, 0, z);
    // rotation.y so the front face (+Z normal) points radially outward from center
    mesh.rotation.y = Math.PI / 2 - angle;
    group.add(mesh);
  }

  private readonly _tick = (): void => {
    if (this._disposed || !this._rendering) return;
    const p = this._scrollProgress;
    const speed = this._rotationStrategy.next();
    if (this._group) this._group.rotation.y += speed;
    // Planet counter-rotates slowly, independent of card ring
    if (this._planetGroup) this._planetGroup.rotation.y += 0.0003;
    if (this._camera) {
      this._camera.position.y = 3 - p * 3;
      this._camera.lookAt(0, 0, 0);
    }
    if (this._renderer && this._scene && this._camera) {
      this._renderer.render(this._scene, this._camera);
    }
    this._rafId = requestAnimationFrame(this._tick);
  };

  private _startRaf(): void {
    if (this._rafId !== null || this._disposed) return;
    this._rendering = true;
    this._rafId = requestAnimationFrame(this._tick);
  }

  private _stopRaf(): void {
    this._rendering = false;
    if (this._rafId !== null) {
      cancelAnimationFrame(this._rafId);
      this._rafId = null;
    }
  }

  private _syncSize(): void {
    const canvas = this._canvas;
    const renderer = this._renderer;
    const camera = this._camera;
    if (!canvas || !renderer || !camera) return;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    if (w <= 0 || h <= 0) return;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }

  private _observeResize(): void {
    if (!this._canvas) return;
    this._resizeObserver = new ResizeObserver(() => this._syncSize());
    this._resizeObserver.observe(this._canvas);
  }

  private _observeVisibility(): void {
    if (!this._canvas) return;
    this._intersectionObserver = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) {
          this._startRaf();
        } else {
          this._stopRaf();
        }
      },
      { threshold: 0 },
    );
    this._intersectionObserver.observe(this._canvas);
  }
}
