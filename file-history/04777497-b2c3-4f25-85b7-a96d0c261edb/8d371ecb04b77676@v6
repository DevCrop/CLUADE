@use "../abstract" as *;

.no-chip {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;

  &--tool {
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid transparent;
    background:
      rgba(255, 255, 255, 0.06) padding-box,
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0.25) 45%,
        rgba(255, 255, 255, 0.9) 100%
      ) border-box;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    @include font("f-body-3");
    font-weight: 500;
    gap: fluid(4, 6);
    letter-spacing: 0.04em;
    color: var(--clr-white-100);
  }
  &__label {
    font-family: var(--family-ui);
  }

  &--category {
    padding: 0.42rem 0.8rem;
    border-radius: 999px;
    border: 1.5px solid transparent;
    background:
      rgba(255, 255, 255, 0.06) padding-box,
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 1) 0%,
        rgba(255, 255, 255, 0.25) 45%,
        rgba(255, 255, 255, 0.9) 100%
      ) border-box;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    @include font("f-body-3");
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--clr-white-100);
  }

  &__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;

    svg {
      width: fluid(12, 14);
      height: fluid(12, 14);
      fill: currentColor;
      opacity: 0.5;
      display: block;
    }
  }
}
