@use "../abstract" as *;

// 캔버스 전용 고정 레이어 (뷰포트에 고정, 낮은 z-index)
.canvas-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;

  .no-marquee {
    height: 100vh;
    &__viewport {
      height: 100%;
      @include flex-center();
    }
  }

  #canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
}

// 스크롤 콘텐츠 레이어 (캔버스 위에서 스크롤)
.main-content {
  position: relative;
  z-index: 1;
}

.scene-shell {
  position: relative;
  height: var(--scene-shell-span);
}

@keyframes no-intro-title-glow {
  0% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}

@keyframes no-intro-countdown-orbit-pulse {
  0%,
  7%,
  100% {
    opacity: 0.02;
  }

  10%,
  14% {
    opacity: 1;
  }
}

// 메인 씬 스타일
.no-main {
  &-intro {
    width: 100%;
    &-1 {
      width: 50% !important;
      margin-right: auto;
      h2 {
        .line {
          background: linear-gradient(
            120deg,
            #fff 0%,
            rgba(180, 180, 180, 1) 25%,
            #fff 50%,
            rgba(100, 100, 100, 0.8) 75%,
            #fff 100%
          );
          background-size: 250% auto;
          -webkit-background-clip: text;
          background-clip: text;
          -webkit-text-fill-color: transparent;
          animation: no-intro-title-glow 5s ease-in-out infinite;
        }
      }
    }
    > div {
      height: 100vh;
    }
    &__inner {
      height: calc(100% - var(--header-height));
      margin-top: var(--header-height);
    }
    &__body {
      height: 100%;
      position: relative;
      padding: var(--gutter-2xl) var(--gutter-xl) var(--gutter-xl);
    }

    &__txt {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--gutter-2xl);
      &--hook {
        margin-left: auto;
        width: 30% !important;
        h3 {
          margin-bottom: fluid(8, 16);
        }
      }
      &--top {
        display: flex;
        flex-direction: column;
        gap: var(--gutter-md);
        align-items: flex-end;
      }
      &--bottom {
        position: relative;
        .masking-text__line,
        .line {
        }
      }
    }
    &__cta {
      position: absolute;
      left: 0;
      bottom: 0;
      min-width: fluid(144, 196);
      gap: fluid(8, 12);
      color: var(--clr-text-title);

      .no-corner-btn__text {
        display: inline-flex;
        align-items: center;
      }

      .no-loop-filter-rect {
        margin-right: fluid(2, 4);
      }
    }
    &__title {
      overflow: hidden;
      width: 100%;

      h2 {
        color: var(--clr-text-title);
      }

      .line {
        display: flex;
        flex-direction: column;
      }
      h2 {
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
    }

    p {
      color: var(--clr-text-body);
    }
  }
  &-intro-action {
    width: 100%;

    > div {
      height: 100vh;
    }

    &__inner {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }

    &__countdown {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      z-index: 2;
      margin: auto;
    }

    &__countdown-shell {
      width: fluid(152, 220);
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.06) 0%,
        rgba(255, 255, 255, 0.02) 100%
      );
      backdrop-filter: blur(12px);
      overflow: hidden;
    }

    &__countdown-orbit {
      position: absolute;
      inset: 0;

      span {
        --countdown-y: 0;
        --countdown-x: 0;
        --countdown-delay: 0s;
        position: absolute;
        top: calc(var(--countdown-y) * 100%);
        left: calc(var(--countdown-x) * 100%);
        width: calc(100% / 25 + 1px);
        height: fluid(8, 14);
        background: #fff;
        animation: no-intro-countdown-orbit-pulse 1.38s linear infinite;
        animation-delay: var(--countdown-delay);
      }

      span[data-side="0"] {
        transform: translate(0, -50%);
      }

      span[data-side="1"],
      span[data-side="3"] {
        width: fluid(8, 14);
        height: calc(100% / 25 + 1px);
      }

      span[data-side="1"] {
        transform: translate(-50%, 0);
      }

      span[data-side="2"] {
        transform: translate(-100%, -50%);
      }

      span[data-side="3"] {
        transform: translate(-50%, -100%);
      }
    }

    &__countdown-value {
      @include font("f-display-0");
      position: relative;
      z-index: 1;
      text-align: center;
      color: var(--clr-text-title);
    }

    &__skip {
      opacity: 0;
      pointer-events: none;
      min-width: fluid(116, 144);
      gap: fluid(8, 12);
      color: var(--clr-text-title);
      transition:
        opacity 0.28s ease,
        transform 0.28s ease,
        box-shadow 0.28s ease;

      .no-loop-filter-rect {
        margin-right: fluid(2, 4);
      }
    }

    &__skip-wrap {
      position: fixed;
      top: calc(var(--header-height) + var(--gutter-xl));
      left: 50%;
      transform: translateX(-50%);
      z-index: 6;
      display: flex;
      justify-content: center;
      pointer-events: none;
    }

    &__content {
      width: 100%;
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: var(--gutter-md);
      padding: 0 var(--gutter-md);
      &.content-1 {
        width: 44%;
      }
      &.content-2 {
        width: 44%;
        left: inherit;
        right: 0;
      }
    }
  }
  &-hero {
    width: 100%;

    &[data-handoff-visible="false"] {
      .no-main-hero__content {
        opacity: 0;
        visibility: hidden;
        transform: translate3d(0, 24px, 0);
      }
    }

    &[data-handoff-visible="true"] {
      .no-main-hero__content {
        opacity: 1;
        visibility: visible;
        transform: translate3d(0, 0, 0);
      }
    }

    &__content {
      transition:
        opacity var(--transition-default),
        transform var(--transition-default);

      &.slogan {
        height: 100vh;
        width: 100%;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        flex-direction: column;
      }
    }
    &__inner {
      width: 100%;
      height: 100%;
      margin-top: var(--header-height);
    }
    &__title {
      h2 {
        @include font("f-display-0");
        font-weight: 400;
      }
    }
    &__desc {
      p {
        margin-top: var(--gutter-lg);
        @include font("f-heading-5");
        font-weight: 500;
      }
    }
    &__action-gate {
      margin-top: var(--gutter-2xl);
    }

    &__reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
      will-change: auto;
    }
  }
  &-story {
    width: 100%;

    &__inner {
      width: 100%;
      height: 100%;
      margin-top: var(--header-height);
    }

    &__body {
      width: 100%;
    }

    &__content {
      @include flex-center();
      flex-direction: column;

      .block {
        width: 50%;
        padding-bottom: var(--gutter-4xl);

        &.left {
          margin-left: auto;
        }

        &.right {
          margin-right: auto;
          width: 72%;
          padding-bottom: var(--gutter-4xl);
          padding-top: var(--gutter-3xl);
          position: relative;
        }

        .title {
          h4 {
            margin-top: var(--gutter-xs);
          }
        }

        .body {
          margin-top: var(--gutter-lg);

          p {
            margin-top: var(--gutter-sm);
          }
        }
      }

      .etc {
        width: 45%;
        margin-left: auto;

        .--divider {
          margin-top: fluid(6, 14);
        }

        p {
          display: flex;
          gap: var(--gutter-2xs);
        }
      }
    }
  }
  &-who {
    width: 100%;
    position: relative;

    &__inner {
      min-height: var(--scene-shell-span);
      position: relative;
    }

    &__title {
      .line {
        text-align: center;
      }
    }

    &__body {
      position: sticky;
      top: var(--header-height);
      min-height: calc(100vh - var(--header-height));
      display: flex;
      align-items: center;
      justify-content: center;

      .line {
        text-align: center;
      }
    }

    &__desc {
      margin-top: var(--gutter-md);
    }

    &__action {
      @include flex-center();
      margin-top: var(--gutter-xl);
    }
  }

  &-feature-card-list {
    display: flex;
    flex-direction: column;
    gap: var(--gutter-lg);
  }

  &-feature-card {
    display: flex;
    gap: var(--gutter-md);
    padding: var(--gutter-md);
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);

    &__figure {
      position: relative;
      width: fluid(148, 288);
      aspect-ratio: 1 / 1;
      overflow: hidden;
      flex-shrink: 0;
    }

    &__canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    &__txt {
      display: flex;
      flex-direction: column;
      margin-top: var(--gutter-md);
    }

    &__title,
    &__desc,
    &__tags {
      width: 100%;
    }
    &__desc {
      margin-top: var(--gutter-sm);
    }

    &__tags {
      margin-top: var(--gutter-xs);
      display: flex;
      flex-wrap: wrap;
      gap: var(--gutter-2xs);

      span {
        @include font("f-body-3");
        padding: var(--gutter-3xs) var(--gutter-xs);
        border: 1px solid rgba(255, 255, 255, 0.14);
        color: var(--clr-text-desc);
      }
    }
  }

  &-why {
    width: 100%;

    &__wrap {
      min-height: var(--scene-shell-span);
      position: relative;
      overflow: visible;

      > .no-container-2xl {
        min-height: inherit;
      }
    }

    &__inner {
      position: sticky;
      top: 0;
      height: 100vh;
      min-height: 100vh;
      width: 100%;
    }

    &__body {
      position: absolute;
      z-index: 2;
      opacity: 0;
      transition:
        opacity var(--transition-default),
        transform var(--transition-default);
      will-change: transform, opacity;
      width: 100%;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    &__desc {
      margin-top: var(--gutter-md);
      .line {
        text-align: center;
      }
    }

    &__title {
      .line {
        text-align: center;
      }
    }

    &__visual {
      position: absolute;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transition:
        opacity var(--transition-default),
        transform var(--transition-default);
      will-change: transform, opacity;
      width: 100%;
      height: 100%;
      overflow: visible;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }

    &__stage {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: var(--header-height);
    }

    &__showcase {
      position: relative;
      width: min(100vw - 6rem, 96rem);
      height: min(88vh, 56rem);
    }

    &__ring {
      position: absolute;
      left: 50%;
      top: 50%;
      width: min(54vmin, 620px);
      aspect-ratio: 1;
      border-radius: 50%;
      border: 1px solid
        color-mix(in srgb, var(--clr-white-100) 16%, transparent);
      transform: translate3d(-50%, -50%, 0) scale(0.72);
      opacity: 0;
      will-change: transform, opacity;
    }

    &__title-layer {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      line-height: 0.86;
      letter-spacing: -0.05em;
      color: var(--clr-white-100);
      pointer-events: none;
      will-change: transform, opacity;
    }

    &__title-layer--back {
      z-index: 3;
    }

    &__title-layer--front {
      z-index: 10;
    }

    &__title-line {
      display: inline-flex;
      align-items: center;
      gap: fluid(18, 28);
    }

    &__title-line + &__title-line {
      margin-top: fluid(4, 10);
    }

    &__title-part {
      display: inline-block;
    }

    &__title-part--ghost {
      opacity: 0;
    }

    &__card-list {
      position: absolute;
      inset: 0;
      margin: 0;
      padding: 0;
      list-style: none;
      pointer-events: none;
    }

    &__card {
      --about-who-card-x: 0vmin;
      --about-who-card-y: 0vmin;
      --about-who-card-rotate: 0deg;
      --about-who-card-scale: 0.88;
      --about-who-card-opacity: 0;
      --about-who-card-z: 1;

      position: absolute;
      display: flex;
      left: 50%;
      top: 50%;
      width: min(26vmin, 280px);
      flex-direction: column;
      gap: fluid(10, 14);
      transform: translate3d(
          calc(-50% + var(--about-who-card-x)),
          calc(-50% + var(--about-who-card-y)),
          0
        )
        rotate(var(--about-who-card-rotate)) scale(var(--about-who-card-scale));
      transform-origin: center;
      opacity: var(--about-who-card-opacity);
      z-index: var(--about-who-card-z);
      will-change: transform, opacity;
    }

    &__card-media {
      position: relative;
      width: 100%;
      margin: 0;
      overflow: hidden;
      border: 1px solid
        color-mix(in srgb, var(--clr-white-100) 14%, transparent);
      background: color-mix(in srgb, var(--clr-black-100) 72%, transparent);
      box-shadow:
        0 20px 40px rgba(0, 0, 0, 0.32),
        0 0 0 1px rgba(255, 255, 255, 0.06);
    }

    &__card-image {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }

    @include mq(md) {
      &__wrap {
        min-height: var(--scene-shell-span);
      }

      &__body {
        max-width: none;
      }

      &__inner {
        position: relative;
        top: auto;
        height: auto;
        min-height: 100vh;
      }

      &__visual {
        min-height: 100vh;
      }

      &__showcase {
        width: min(100vw - 2rem, 32rem);
        height: min(70vh, 32rem);
      }

      &__title-line {
        gap: fluid(12, 18);
      }

      &__card {
        width: min(32vmin, 232px);
      }

      &__ring {
        width: min(66vmin, 420px);
      }
    }
  }
  &-services {
    $root: &;
    width: 100%;

    &__txt {
      display: grid;
      grid-template-columns: 2fr 10fr;
      gap: var(--gutter-sm);
    }
    &__body {
      width: 100%;
      background: rgba(0, 0, 0, 0.24);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }

    &__list {
      display: flex;
      flex-direction: column;
    }

    &__item {
      display: grid;
      grid-template-columns: 2fr 6fr 4fr;
      gap: var(--gutter-sm);
      align-items: center;
      padding: var(--gutter-2xl) 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);

      &:last-child {
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }
    }

    &__item-title {
    }

    p {
      color: var(--clr-text-body);
    }

    .no-services__num {
      color: rgba(255, 255, 255, 0.56);
      display: flex;
      align-items: center;
      min-height: fluid(16, 22);

      .no-loop-filter-rect {
        gap: 0;

        span {
          width: fluid(4, 6);
          height: fluid(4, 6);
        }
      }
    }
  }

  &-portfolio {
    $root: &;
    width: 100%;

    .no-container-2xl {
      position: relative;
    }

    &__head {
      min-height: 100vh;
      width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      padding: var(--gutter-3xl) var(--gutter-container);
      h2 {
      }
      .first-title {
      }
      .second-title {
      }
      .title-bottom {
        display: grid;
        grid-template-columns: 5fr 7fr;
        gap: var(--gutter-md);
        align-items: flex-end;
      }
      .desc {
        order: -1;
      }
      p {
      }
    }

    &__head[data-active="true"] {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    &__gallery {
      width: 100%;
    }

    &__list {
      width: 100%;
    }

    &__item {
      width: 48%;
      display: flex;
      flex-direction: column;

      &:nth-child(even) {
        margin-left: auto;
      }
      &:nth-child(odd) {
        margin-right: auto;
      }

      /* 이미지 껍데기: 인사이트 갤러리와 동일(.no-sub-gallery-item__img-wrap) 사용 */
      .no-sub-gallery-item__img-wrap {
        position: relative;
        padding: var(--gutter-xs);
        border: 1px solid
          color-mix(in srgb, var(--clr-white-100) 14%, transparent);
        background: linear-gradient(
          180deg,
          color-mix(in srgb, var(--clr-white-100) 6%, transparent),
          color-mix(in srgb, var(--clr-black-100) 18%, transparent)
        );
        overflow: hidden;
      }

      .no-sub-gallery-item__img-inner {
        overflow: hidden;
      }

      .no-sub-gallery__corner {
        color: color-mix(in srgb, var(--clr-white-100) 72%, transparent);
      }

      &__content {
        margin-top: var(--gutter-md);
      }

      &-category {
        margin-top: var(--gutter-sm);
      }

      &-category-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      &-category-chip {
        padding: 0.42rem 0.8rem;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(255, 255, 255, 0.06);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        @include font("f-body-3");
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--clr-white-100);
      }

      a {
        display: block;
        color: inherit;
        text-decoration: none;
      }
    }
  }

  &-portfolio-intro {
    width: 100%;
  }

  &-portfolio-gallery {
    width: 100%;
    .no-view-more {
      @include flex-center();
      margin-top: var(--gutter-2xl);
    }
  }
  &-portfolio__view-more {
    min-width: fluid(148, 188);
  }
  // 클라이언트 섹션: 리스트는 12칸 중 오른쪽 5칸, ul은 2열 그리드. 스크롤에 따라 list가 100%→-100% 이동
  &-clients {
    $root: &;
    > div {
      display: grid;
      grid-template-columns: 4fr 8fr;
      gap: var(--gutter-2xl);
      align-items: flex-start;
    }

    &__head-wrap {
      position: sticky;
      top: calc(var(--header-height) + var(--gutter-lg));
      align-self: start;
    }

    &__head {
      position: relative;
      height: fit-content;
      p {
        @include font("f-body-1");
        font-weight: 400;
        color: var(--clr-text-desc);
        margin-top: var(--gutter-md);
      }
    }

    &__list {
      position: relative;
    }

    &__items {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--gutter-md);
    }

    &__item {
      background: rgba(255, 255, 255, 0.04);
      padding: var(--gutter-md);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);

      &.is-block-reveal {
        transition-delay: 0s;
      }

      a {
        display: block;
      }
      img {
        display: block;
      }
    }

    @for $i from 1 through 22 {
      &__item:nth-child(#{$i}).is-block-reveal {
        transition-delay: #{($i - 1) * 45}ms;
      }
    }

    @include mq(md) {
      > div {
        grid-template-columns: 1fr;
      }

      &__head-wrap {
        position: relative;
        top: auto;
      }
    }
  }
  &-contact {
    $root: &;
    position: relative;

    .line {
      text-align: center;
    }

    .no-container-2xl {
      width: 100%;
      position: sticky;
      top: 0;
      z-index: 4;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: var(--gutter-lg);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      text-align: center;
      transition:
        opacity var(--transition-default),
        transform var(--transition-default);
      transform: translate3d(0, 24px, 0);
    }

    &[data-active="true"] {
      .no-container-2xl {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translate3d(0, 0, 0);
      }
    }

    &__head {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--gutter-md);

      h2 {
        color: var(--clr-text-title);
      }

      p {
        color: var(--clr-text-body);
        margin-top: var(--gutter-md);
      }
    }

    &__actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--gutter-sm);
      margin-top: var(--gutter-xl);
    }

    &__action {
      margin-top: 0;
    }

    @include mq(md) {
      .no-container-2xl {
        padding-left: var(--gutter-lg);
        padding-right: var(--gutter-lg);
      }

      &__actions {
        flex-direction: column;
        width: 100%;
      }

      &__action {
        width: 100%;
      }
    }
  }

  // 메인 푸터: 왼쪽 상단 로고 / 오른쪽 상단 메뉴(소메뉴) / 왼쪽 하단 정보 / 오른쪽 하단 Contact
  &-footer {
    color: var(--clr-text-title);
    border-top: 1px solid var(--clr-border-default);
    padding: fluid(48, 80) 0;
    transition: opacity var(--transition-default);
    display: flex;
    align-items: flex-end;
    * {
      color: inherit;
    }

    .no-container-2xl {
      padding-left: var(--gutter-lg);
      padding-right: var(--gutter-lg);
    }

    &__inner {
      width: 100%;
    }

    &__top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding-bottom: fluid(32, 48);
      border-bottom: 1px solid var(--clr-border-default);
      gap: var(--gutter-lg);
      @include mq(md) {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    &__logo {
      a {
        display: block;
        text-decoration: none;
      }
      img {
        width: fluid(120, 160);
        height: auto;
        object-fit: contain;
      }
    }

    &__nav {
      flex-shrink: 0;
    }

    &__menu {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gutter-xl) var(--gutter-2xl);
      @include mq(md) {
        flex-direction: column;
        gap: var(--gutter-md);
      }
    }

    &__menu-item {
      &--has-sub {
        display: flex;
        flex-direction: column;
        gap: var(--gutter-xs);
      }
    }

    &__menu-link {
      @include font("f-heading-4");
      font-weight: 600;
      color: var(--clr-text-title);
      text-decoration: none;
      transition: color var(--transition-default);
      &:hover {
        color: var(--clr-trigger-link);
      }
    }

    &__sub {
      display: flex;
      flex-direction: column;
      gap: var(--gutter-2xs);
    }

    &__sub-link {
      @include font("f-body-2");
      font-weight: 400;
      color: var(--clr-text-body);
      text-decoration: none;
      transition: color var(--transition-default);
      &:hover {
        color: var(--clr-text-title);
      }
    }

    &__bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--gutter-xl);
      padding-top: fluid(32, 48);
      @include mq(md) {
        flex-direction: column;
        align-items: flex-start;
        gap: var(--gutter-lg);
      }
    }

    &__info {
      display: flex;
      flex-wrap: wrap;
      gap: var(--gutter-lg) var(--gutter-2xl);
      @include mq(md) {
        flex-direction: column;
        gap: var(--gutter-md);
      }
    }

    &__info-block {
      display: flex;
      flex-direction: column;
      gap: var(--gutter-2xs);
    }

    &__info-title {
      @include font("f-body-2");
      font-weight: 600;
      color: var(--clr-text-desc);
      letter-spacing: 0.02em;
    }

    &__info-text {
      @include font("f-body-2");
      font-weight: 400;
      color: var(--clr-text-body);
      margin: 0;
    }

    &__info-link {
      color: inherit;
      text-decoration: none;
      transition: color var(--transition-default);
      &:hover {
        color: var(--clr-trigger-link);
      }
    }

    &__contact {
      flex-shrink: 0;
    }

    &__contact-link {
      @include font("f-heading-4");
      font-weight: 600;
      color: var(--clr-text-title);
      text-decoration: none;
      transition: color var(--transition-default);
      &:hover {
        color: var(--clr-trigger-link);
      }
    }
  }
}
