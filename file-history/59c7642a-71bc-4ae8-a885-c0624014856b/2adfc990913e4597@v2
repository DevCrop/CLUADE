<script>
const SELF_BASE = <?= json_encode($selfBaseJs) ?>;
const PEER_BASE = <?= json_encode($peerBase) ?>;

function getToken() { return document.getElementById('adminToken').value || localStorage.getItem('cors-test-admin-token') || ''; }
function saveToken() {
  const v = document.getElementById('adminToken').value;
  if (v) { localStorage.setItem('cors-test-admin-token', v); document.getElementById('tokenHint').textContent = '저장됨'; }
  else { localStorage.removeItem('cors-test-admin-token'); document.getElementById('tokenHint').textContent = '삭제됨'; }
}
window.addEventListener('load', () => {
  const saved = localStorage.getItem('cors-test-admin-token');
  if (saved) document.getElementById('adminToken').value = saved;
});

function appendRow(tableId, id, label, expected, actual, verdict, note) {
  const tbody = document.querySelector('#'+tableId+' tbody');
  const tr = document.createElement('tr');
  tr.innerHTML = `<td class="id">${id}</td><td>${label}</td>
    <td><pre>${pretty(expected)}</pre></td>
    <td><pre>${pretty(actual)}</pre></td>
    <td class="verdict ${verdict==='✅'?'ok':verdict==='❌'?'bad':'warn'}">${verdict||'?'}</td>
    <td>${note||''}</td>`;
  tbody.appendChild(tr);
}
function pretty(v) {
  if (v === undefined || v === null) return '—';
  if (typeof v === 'string') return escapeHtml(v);
  try { return escapeHtml(JSON.stringify(v, null, 2)); } catch(e) { return String(v); }
}
function escapeHtml(s) { return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'})[c]); }

// WAF 우회: JSON 페이로드를 base64로 감싸 form-encoded 전송
function runFetch(payload) {
  return fetch(SELF_BASE + '/api/run.php', {
    method: 'POST',
    headers: {'Content-Type':'application/x-www-form-urlencoded', 'X-Admin-Token': getToken()},
    body: 'd=' + encodeURIComponent(btoa(unescape(encodeURIComponent(JSON.stringify(payload)))))
  });
}

async function runOne(caseId, label, params = {}) {
  const tableId = label.startsWith('A') ? 'tblA' : label.startsWith('B') ? 'tblB' : label.startsWith('C') ? 'tblC' : 'tblD';
  try {
    const r = await runFetch({case: caseId, params});
    const j = await r.json();
    if (!r.ok) {
      appendRow(tableId, label, caseId, '200', `HTTP ${r.status} :: ${j.error||''}`, '❌', j.message||'');
      return;
    }
    const d = j.data || {};
    appendRow(tableId, label, caseId, d.expected, d.actual, d.verdict, (d.note||'') + ' (' + (d.timing_ms||0) + 'ms)');
  } catch (e) {
    appendRow(tableId, label, caseId, '?', String(e), '❌', 'fetch failed');
  }
}

async function runAll(group) {
  if (group === 'A') {
    await runOne('whoami_peer','A1');
    await runOne('ping_peer','A2');
    await runOne('ping_bad_ts','A3');
    await runOne('ping_bad_sig','A4');
    await runOne('ping_no_auth','A5');
    await runOne('options_peer','A6');
    await runOne('cors_probe_peer','A7');
  }
}

async function uploadSelected() {
  const f = document.getElementById('fileInput').files[0];
  if (!f) { alert('파일 선택'); return; }
  const push = document.getElementById('autoPush').checked;
  const fd = new FormData();
  fd.append('file', f);
  const url = SELF_BASE + '/api/upload.php' + (push ? '?push=1' : '');
  try {
    const r = await fetch(url, {method:'POST', headers:{'X-Admin-Token': getToken()}, body: fd});
    const j = await r.json();
    const expected = {status: 200, sha256:'(non-empty)'};
    const actual = {status: r.status, error: j.error||null, name: j.data?.name, sha256: j.data?.sha256, pushed: j.data?.pushed?.status};
    const v = (r.ok && j.ok) ? '✅' : '❌';
    appendRow('tblB', 'B-upload', f.name + ' (' + f.size + 'B)', expected, actual, v, j.message||'');
  } catch (e) {
    appendRow('tblB', 'B-upload', f.name, '200', String(e), '❌', 'fetch failed');
  }
}

async function loadStorageNames() {
  try {
    const r = await runFetch({case:'list_self', params:{tail:1}});
    const j = await r.json();
    const files = j.data?.response?.files || [];
    const names = files.map(f => f.name);
    document.getElementById('storageNames').textContent = '자기 storage: ' + (names.length ? names.join(', ') : '(비어있음)');
    if (names.length && !document.getElementById('targetName').value) {
      document.getElementById('targetName').value = names[0];
    }
  } catch (e) {
    document.getElementById('storageNames').textContent = 'list 실패: ' + e;
  }
}

async function issueAssetToken(name) {
  const r = await runFetch({case:'asset_token_issue', params:{name, ttl: 600}});
  return await r.json();
}

async function runImageMatrix() {
  const name = document.getElementById('targetName').value.trim();
  if (!name) { alert('파일명 입력 또는 storage 목록 로드 후 선택'); return; }
  document.querySelector('#tblC tbody').innerHTML = '';
  document.getElementById('imgGrid').innerHTML = '';

  // 자기 도메인 token 발급. peer.asset.php 도 같은 SYNC_SECRET 으로 검증 가능 — 이게 핵심.
  const tokRes = await issueAssetToken(name);
  const tok = tokRes.data?.actual?.token;
  if (!tok) { alert('token 발급 실패 — peer storage 에 같은 이름 파일이 있어야 함'); return; }
  const peerAssetUrl = PEER_BASE + '/api/asset.php?name=' + encodeURIComponent(name) + '&token=' + tok;
  const peerAssetUrlNoToken = PEER_BASE + '/api/asset.php?name=' + encodeURIComponent(name);
  const peerStorageDirect = PEER_BASE + '/storage/' + encodeURIComponent(name);
  const peerProbe = PEER_BASE + '/api/cors-probe.php';
  const peerAssetHttp = peerAssetUrl.replace(/^https:/, 'http:');

  // C1 — storage 직접 GET (HEAD 로 status 만)
  await testImg('C1', '<img src="…/storage/'+name+'">', 'load 실패', peerStorageDirect, false, '403 기대 (htaccess Deny)');
  // C2 — asset.php 토큰
  await testImg('C2', '<img src="…/asset.php?token=…">', '200 표시', peerAssetUrl, true, '분리 후 살아남는 이미지 패스');
  // C3 — token 없음
  await testImg('C3', '<img src="…/asset.php"> (token 누락)', 'load 실패', peerAssetUrlNoToken, false, '401 token_required 기대');
  // C4 — fetch asset.php
  await testFetch('C4', 'fetch(asset.php?token)', 'CORS 차단 또는 opaque 실패', peerAssetUrl);
  // C5 — fetch cors-probe
  await testFetch('C5', 'fetch(cors-probe.php)', 'CORS 차단', peerProbe);
  // C6 — CSS background-image
  await testCssBg('C6', 'CSS background-image(asset.php?token)', '표시', peerAssetUrl);
  // C7 — img crossorigin=anonymous
  await testImg('C7', '<img crossorigin="anonymous" src="…asset.php?token">', '깨짐 (CORS 헤더 부재)', peerAssetUrl, false, 'CORS-tagged img → 차단. 운영 코드에 crossorigin 사용 0건 (font CDN 제외) 으로 영향 없음', true);
  // C8 — Range 요청
  await testRange('C8', 'fetch Range bytes=0-99', '206 Partial', peerAssetUrl);
  // C9 — Hotlink Referer (이 페이지 자체가 다른 도메인이므로 Referer 자동으로 cross-origin)
  await testFetch('C9', 'fetch(asset.php) Referer cross-origin', '200 또는 403 (가비아 hotlink 룰 의존)', peerAssetUrl, true);
  // C10 — Mixed Content
  await testImg('C10', '<img src="http://…asset.php">', '브라우저 차단', peerAssetHttp, false, 'https 페이지에서 http 자원 → 차단');
}

function testImg(id, label, expected, url, expectLoad, note, isCrossorigin) {
  return new Promise(resolve => {
    const fig = document.createElement('figure');
    const img = document.createElement('img');
    if (isCrossorigin) img.crossOrigin = 'anonymous';
    let done = false;
    const finish = (ok, why) => {
      if (done) return; done = true;
      const verdict = (ok === expectLoad) ? '✅' : '❌';
      appendRow('tblC', id, label, expected, why, verdict, note||'');
      const cap = document.createElement('figcaption');
      cap.textContent = id + ': ' + why;
      fig.appendChild(cap);
      document.getElementById('imgGrid').appendChild(fig);
      resolve();
    };
    img.onload = () => finish(true, 'load OK ('+img.naturalWidth+'x'+img.naturalHeight+')');
    img.onerror = () => finish(false, 'load 실패');
    setTimeout(() => finish(false, 'timeout 5s'), 5000);
    img.src = url;
    fig.appendChild(img);
  });
}

async function testCssBg(id, label, expected, url) {
  // CSS bg는 load 이벤트가 안 떠서 새 Image() 로 우회 (단순 GET 동작)
  return new Promise(resolve => {
    const fig = document.createElement('figure');
    const div = document.createElement('div');
    div.className = 'bg-test';
    div.style.backgroundImage = 'url("' + url.replace(/"/g,'\\"') + '")';
    div.style.backgroundSize = 'contain';
    div.style.backgroundRepeat = 'no-repeat';
    div.style.backgroundPosition = 'center';
    fig.appendChild(div);
    const probe = new Image();
    let done = false;
    const finish = (ok, why) => {
      if (done) return; done = true;
      appendRow('tblC', id, label, expected, why, ok ? '✅' : '❌', 'CSS background — 단순 GET');
      const cap = document.createElement('figcaption');
      cap.textContent = id + ': ' + why;
      fig.appendChild(cap);
      document.getElementById('imgGrid').appendChild(fig);
      resolve();
    };
    probe.onload = () => finish(true, '표시');
    probe.onerror = () => finish(false, '실패');
    setTimeout(() => finish(false, 'timeout'), 5000);
    probe.src = url;
  });
}

async function testFetch(id, label, expected, url, allowOk) {
  let actual, verdict;
  try {
    const r = await fetch(url, {method:'GET', mode:'cors'});
    actual = 'status ' + r.status;
    verdict = allowOk ? '✅' : '❌';
  } catch (e) {
    actual = 'CORS 차단 또는 fetch 실패: ' + (e.message||e);
    verdict = '✅'; // 차단되는 게 정답
  }
  appendRow('tblC', id, label, expected, actual, verdict, '브라우저 fetch — preflight/CORS 헤더 부재로 차단되는 게 정답');
}

async function testRange(id, label, expected, url) {
  try {
    const r = await fetch(url, {method:'GET', headers:{'Range':'bytes=0-99'}, mode:'cors'});
    const buf = await r.arrayBuffer().catch(() => null);
    const actual = 'status ' + r.status + (buf ? ' / bytes=' + buf.byteLength : '');
    const verdict = r.status === 206 ? '✅' : (r.status === 200 ? '⚠' : '❌');
    appendRow('tblC', id, label, expected, actual, verdict, '※ Range 요청도 cross-origin → CORS 차단 가능');
  } catch (e) {
    appendRow('tblC', id, label, expected, 'fetch 실패: ' + e, '⚠', '브라우저 차단 — server→server 로 별도 검증 권장');
  }
}

async function purgeAll() {
  if (!confirm('storage/* 와 logs/audit-*.jsonl 모두 삭제. 진짜?')) return;
  try {
    const r = await fetch(SELF_BASE + '/api/purge.php', {
      method: 'POST',
      headers: {'Content-Type':'application/json','X-Admin-Token': getToken()},
      body: JSON.stringify({confirm:'YES'})
    });
    const j = await r.json();
    appendRow('tblD','D-purge','purge', {confirm:'YES'}, {status:r.status, removed_files:j.data?.removed_files, removed_logs:j.data?.removed_logs}, j.ok?'✅':'❌', j.message||'');
  } catch (e) {
    appendRow('tblD','D-purge','purge','200', String(e), '❌', '');
  }
}

async function loadAudit() {
  try {
    const r = await runFetch({case:'list_self', params:{tail:100}});
    const j = await r.json();
    const entries = j.data?.response?.entries || [];
    document.getElementById('auditOut').textContent = entries.length
      ? entries.map(e => e.iso + ' [' + e.event + '] ' + JSON.stringify(e.data)).join('\n')
      : '(비어있음)';
  } catch (e) {
    document.getElementById('auditOut').textContent = '실패: ' + e;
  }
}
</script>

