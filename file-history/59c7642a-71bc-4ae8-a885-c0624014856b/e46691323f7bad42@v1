<?php
/**
 * 인입 요청 일괄 검증.
 *
 * - HMAC 검증 (X-Cors-Test-Ts / X-Cors-Test-Sig)
 * - IP 화이트리스트 (ALLOWED_PEER_IPS 가 빈 배열이면 skip)
 * - 메서드/역할 가드는 호출측에서 별도 처리
 *
 * 실패 시 즉시 respondError 로 종료.
 *
 * 별도로 ADMIN 게이팅용 guardAdminToken() 도 제공 (X-Admin-Token 헤더 검증).
 * 세션은 절대 쓰지 않는다 — 운영 세션 충돌 방지.
 */

function guardHmacRequest(): void {
    $ip = clientIp();
    if (defined('ALLOWED_PEER_IPS') && is_array(ALLOWED_PEER_IPS) && count(ALLOWED_PEER_IPS) > 0) {
        if (!in_array($ip, ALLOWED_PEER_IPS, true)) {
            auditAppend('guard.ip_denied', ['ip' => $ip]);
            respondError(403, 'ip_not_allowed');
        }
    }

    $ts  = headerOrNull('X-Cors-Test-Ts');
    $sig = headerOrNull('X-Cors-Test-Sig');
    $body = readRawBody();
    $method = requestMethod();
    $path = requestPathWithQuery();

    $r = hmacVerify(SYNC_SECRET, $ts, $sig, $method, $path, $body);
    if (!$r['ok']) {
        auditAppend('guard.hmac_failed', ['err' => $r['error'], 'ip' => $ip, 'method' => $method, 'path' => $path]);
        respondError(401, $r['error']);
    }
}

/**
 * X-Admin-Token 헤더 검증. UI 자체 게이팅 + upload/purge/run 보호용.
 * 세션 절대 미사용.
 */
function guardAdminToken(): void {
    $tok = headerOrNull('X-Admin-Token');
    if ($tok === null || $tok === '' || !defined('ADMIN_TOKEN') || ADMIN_TOKEN === '') {
        auditAppend('guard.admin_missing', ['ip' => clientIp()]);
        respondError(401, 'admin_token_required');
    }
    if (!hash_equals(ADMIN_TOKEN, $tok)) {
        auditAppend('guard.admin_bad', ['ip' => clientIp()]);
        respondError(401, 'admin_token_invalid');
    }
}

/**
 * asset.php 용 시간제한 토큰. 짧은 TTL (기본 5분).
 * canonical: filename + "|" + exp (정수 epoch)
 * 결과: <hex_sig>.<exp>
 */
function assetTokenIssue(string $filename, int $ttlSec = 300): string {
    $exp = time() + max(10, $ttlSec);
    $canon = $filename . '|' . $exp;
    $sig = hash_hmac('sha256', $canon, SYNC_SECRET);
    return $sig . '.' . $exp;
}

function assetTokenVerify(string $filename, string $token): array {
    if (!preg_match('/^([a-f0-9]{64})\.(\d{1,12})$/', $token, $m)) {
        return ['ok' => false, 'error' => 'bad_token_format'];
    }
    $sig = $m[1];
    $exp = (int) $m[2];
    if (time() > $exp) return ['ok' => false, 'error' => 'token_expired'];
    $expected = hash_hmac('sha256', $filename . '|' . $exp, SYNC_SECRET);
    if (!hash_equals($expected, $sig)) {
        return ['ok' => false, 'error' => 'bad_token_signature'];
    }
    return ['ok' => true, 'exp' => $exp];
}
