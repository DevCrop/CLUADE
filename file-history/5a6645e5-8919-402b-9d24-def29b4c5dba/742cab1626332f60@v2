// 난수 생성
function getRndCode($len)
{
    $chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ023456789";
    $pass = '';
    while ($len--) {
        $pass .= $chars[random_int(0, strlen($chars) - 1)];
    }
    return $pass;
}

