/**
 * 노출 중인 팝업 목록 (nb_popups). popup_type은 var.php의 $popup_types 키와 동일.
 */
function getActivePopups(int $popupType, int $limit = 50): array
{
    $limit = max(1, min(500, (int) $limit));

    $sql = '
        SELECT id, title, popup_type, is_active, start_at, end_at, description,
               has_link, link_url, popup_image, sort_no, is_unlimited, is_target
        FROM nb_popups
        WHERE is_active = 1
          AND popup_type = :popup_type
          AND (
                is_unlimited = 1
                OR (
                    NULLIF(TRIM(start_at), \'\') IS NOT NULL
                    AND NULLIF(TRIM(end_at), \'\') IS NOT NULL
                    AND CURDATE() BETWEEN DATE(start_at) AND DATE(end_at)
                )
          )
        ORDER BY sort_no ASC, id DESC
        LIMIT :limit
    ';

    try {
        $db = DB::getInstance();
        $stmt = $db->prepare($sql);
        $stmt->bindValue(':popup_type', $popupType, PDO::PARAM_INT);
        $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
        $stmt->execute();

        return $stmt->fetchAll(PDO::FETCH_ASSOC) ?: [];
    } catch (Throwable $e) {
        return [];
    }
}

/** nb_clients: 프론트 로고/클라이언트 그리드용 */
function getVisibleClients(int $limit = 200): array
{
    $limit = max(1, min(500, (int) $limit));

    $sql = '
        SELECT id, title, thumb_image, link_url, sort_no
        FROM nb_clients
        WHERE is_visible = 1
        ORDER BY sort_no ASC, id DESC
        LIMIT :limit
    ';

    try {
        $db = DB::getInstance();
        $stmt = $db->prepare($sql);
        $stmt->bindValue(':limit', $limit, PDO::PARAM_INT);
        $stmt->execute();

        return $stmt->fetchAll(PDO::FETCH_ASSOC) ?: [];
    } catch (Throwable $e) {
        return [];
    }
}


