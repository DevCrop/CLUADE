$buildWorksHref = static function (array $overrides = []) use ($worksState): string {
    $params = [
        'view' => $worksState['view'] ?? 'scatter',
    ];

    if (!empty($worksState['category'])) {
        $params['category'] = $worksState['category'];
    }

    if (($worksState['page'] ?? 1) > 1) {
        $params['page'] = (int) $worksState['page'];
    }

    foreach ($overrides as $key => $value) {
        if ($value === null || $value === '' || ($key === 'page' && (int) $value <= 1)) {
            unset($params[$key]);
            continue;
        }
        $params[$key] = $value;
    }

    $query = http_build_query($params);
    return '/works' . ($query !== '' ? '?' . $query : '');
};
