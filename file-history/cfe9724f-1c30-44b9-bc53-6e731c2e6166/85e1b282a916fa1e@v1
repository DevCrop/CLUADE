$buildWorksReturnHref = static function (): string {
    $viewRaw = strtolower(trim((string) ($_GET['view'] ?? 'scatter')));
    $view = in_array($viewRaw, ['grid', 'scatter'], true) ? $viewRaw : 'scatter';
    $category = trim((string) ($_GET['category'] ?? ''));
    $pageValidated = filter_var($_GET['page'] ?? 1, FILTER_VALIDATE_INT);
    $page = $pageValidated === false ? 1 : max(1, (int) $pageValidated);

    $params = ['view' => $view];
    if ($category !== '') {
        $params['category'] = $category;
    }
    if ($page > 1) {
        $params['page'] = $page;
    }

    $query = http_build_query($params);
    return '/works' . ($query !== '' ? '?' . $query : '');
};

