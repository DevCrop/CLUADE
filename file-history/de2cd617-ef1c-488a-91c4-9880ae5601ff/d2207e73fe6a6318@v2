```typescript
private _initGnbRects(root: HTMLElement): void {
  const gsap = getGsap();
  if (!gsap) return;

  const links = Array.from(
    root.querySelectorAll<HTMLElement>(DOM_CONFIG.drawer.gnbLinkSelector),
  );

  for (const link of links) {
    const rectEl = link.querySelector<HTMLElement>(DRAWER_GNB_RECT.rectSelector);
    const labelEl = link.querySelector<HTMLElement>(DRAWER_GNB_RECT.labelSelector);
    if (!rectEl || !labelEl) continue;

    // GSAP이 transform 전체 소유 (yPercent로 수직 정렬)
    gsap.set(rectEl, {
      opacity: DRAWER_GNB_RECT.initOpacity,
      scale: DRAWER_GNB_RECT.initScale,
      transformOrigin: DRAWER_GNB_RECT.transformOrigin,
      yPercent: -50,
    });
    gsap.set(labelEl, { x: 0 });

    if (link.classList.contains(DRAWER_CLASSES.linkActive)) {
      const w = rectEl.getBoundingClientRect().width;
      const gap = this._readLinkGap(link);
      gsap.set(rectEl, { opacity: 1, scale: 1 });
      gsap.set(labelEl, { x: w + gap });
    }

    const onEnter = (): void => {
      const g = getGsap();
      if (!g) return;
      const w = rectEl.getBoundingClientRect().width;
      const gap = this._readLinkGap(link);
      g.to(rectEl, { opacity: 1, scale: 1, duration: DRAWER_GNB_RECT.enterDuration, ease: DRAWER_GNB_RECT.enterEase, overwrite: "auto" });
      g.to(labelEl, { x: w + gap, duration: DRAWER_GNB_RECT.enterDuration, ease: DRAWER_GNB_RECT.enterEase, overwrite: "auto" });
    };

    const onLeave = (): void => {
      if (link.classList.contains(DRAWER_CLASSES.linkActive)) return;
      const g = getGsap();
      if (!g) return;
      g.to(rectEl, { opacity: DRAWER_GNB_RECT.initOpacity, scale: DRAWER_GNB_RECT.initScale, duration: DRAWER_GNB_RECT.leaveDuration, ease: DRAWER_GNB_RECT.leaveEase, overwrite: "auto" });
      g.to(labelEl, { x: 0, duration: DRAWER_GNB_RECT.leaveDuration, ease: DRAWER_GNB_RECT.leaveEase, overwrite: "auto" });
    };

    link.addEventListener("mouseenter", onEnter);
    link.addEventListener("mouseleave", onLeave);

    this._gnbRectCleanups.push((): void => {
      link.removeEventListener("mouseenter", onEnter);
      link.removeEventListener("mouseleave", onLeave);
      const g = getGsap();
      if (g) {
        g.killTweensOf([rectEl, labelEl]);
        g.set(labelEl, { x: 0 });
        g.set(rectEl, { opacity: 0, scale: DRAWER_GNB_RECT.initScale, yPercent: -50 });
      }
    });
  }
}

private _readLinkGap(link: HTMLElement): number {
  const raw = window.getComputedStyle(link).columnGap;
  const parsed = parseFloat(raw);
  return Number.isFinite(parsed) ? parsed : 0;
}
```

