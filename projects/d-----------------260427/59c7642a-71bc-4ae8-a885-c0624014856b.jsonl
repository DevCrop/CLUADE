{"parentUuid":"2228b7d3-3324-4a9e-862b-607f4315dcb6","isSidechain":false,"promptId":"e3e6bcb6-2634-4c0f-af52-9a34670120d6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014AMh3mnnvP9TvN2YCYe2xt","type":"tool_result","content":"1\t<?php\n2\t/**\n3\t * 인입 요청 일괄 검증.\n4\t *\n5\t * - HMAC 검증 (X-Cors-Test-Ts / X-Cors-Test-Sig)\n6\t * - IP 화이트리스트 (ALLOWED_PEER_IPS 가 빈 배열이면 skip)\n7\t * - 메서드/역할 가드는 호출측에서 별도 처리\n8\t *\n9\t * 실패 시 즉시 respondError 로 종료.\n10\t *\n11\t * 별도로 ADMIN 게이팅용 guardAdminToken() 도 제공 (X-Admin-Token 헤더 검증).\n12\t * 세션은 절대 쓰지 않는다 — 운영 세션 충돌 방지.\n13\t */\n14\t\n15\tfunction guardHmacRequest(): void {\n16\t    $ip = clientIp();\n17\t    if (defined('ALLOWED_PEER_IPS') && is_array(ALLOWED_PEER_IPS) && count(ALLOWED_PEER_IPS) > 0) {\n18\t        if (!in_array($ip, ALLOWED_PEER_IPS, true)) {\n19\t            auditAppend('guard.ip_denied', ['ip' => $ip]);\n20\t            respondError(403, 'ip_not_allowed');\n21\t        }\n22\t    }\n23\t\n24\t    $ts  = headerOrNull('X-Cors-Test-Ts');\n25\t    $sig = headerOrNull('X-Cors-Test-Sig');\n26\t    $body = readRawBody();\n27\t    $method = requestMethod();\n28\t    $path = requestPathWithQuery();\n29\t\n30\t    $r = hmacVerify(SYNC_SECRET, $ts, $sig, $method, $path, $body);\n31\t    if (!$r['ok']) {\n32\t        auditAppend('guard.hmac_failed', ['err' => $r['error'], 'ip' => $ip, 'method' => $method, 'path' => $path]);\n33\t        respondError(401, $r['error']);\n34\t    }\n35\t}\n36\t\n37\t/**\n38\t * X-Admin-Token 헤더 검증. UI 자체 게이팅 + upload/purge/run 보호용.\n39\t * 세션 절대 미사용.\n40\t */\n41\tfunction guardAdminToken(): void {\n42\t    $tok = headerOrNull('X-Admin-Token');\n43\t    if ($tok === null || $tok === '' || !defined('ADMIN_TOKEN') || ADMIN_TOKEN === '') {\n44\t        auditAppend('guard.admin_missing', ['ip' => clientIp()]);\n45\t        respondError(401, 'admin_token_required');\n46\t    }\n47\t    if (!hash_equals(ADMIN_TOKEN, $tok)) {\n48\t        auditAppend('guard.admin_bad', ['ip' => clientIp()]);\n49\t        respondError(401, 'admin_token_invalid');\n50\t    }\n51\t}\n52\t\n53\t/**\n54\t * asset.php 용 시간제한 토큰. 짧은 TTL (기본 5분).\n55\t * canonical: filename + \"|\" + exp (정수 epoch)\n56\t * 결과: <hex_sig>.<exp>\n57\t */\n58\tfunction assetTokenIssue(string $filename, int $ttlSec = 300): string {\n59\t    $exp = time() + max(10, $ttlSec);\n60\t    $canon = $filename . '|' . $exp;\n61\t    $sig = hash_hmac('sha256', $canon, SYNC_SECRET);\n62\t    return $sig . '.' . $exp;\n63\t}\n64\t\n65\tfunction assetTokenVerify(string $filename, string $token): array {\n66\t    if (!preg_match('/^([a-f0-9]{64})\\.(\\d{1,12})$/', $token, $m)) {\n67\t        return ['ok' => false, 'error' => 'bad_token_format'];\n68\t    }\n69\t    $sig = $m[1];\n70\t    $exp = (int) $m[2];\n71\t    if (time() > $exp) return ['ok' => false, 'error' => 'token_expired'];\n72\t    $expected = hash_hmac('sha256', $filename . '|' . $exp, SYNC_SECRET);\n73\t    if (!hash_equals($expected, $sig)) {\n74\t        return ['ok' => false, 'error' => 'bad_token_signature'];\n75\t    }\n76\t    return ['ok' => true, 'exp' => $exp];\n77\t}\n78\t"}]},"uuid":"e856e635-d70d-4e2a-a392-d6d358ff4c28","timestamp":"2026-04-28T05:35:12.243Z","toolUseResult":{"type":"text","file":{"filePath":"d:\\최신프로젝트\\인터파크\\백업\\260427\\cors-test\\lib\\guard.php","content":"<?php\n/**\n * 인입 요청 일괄 검증.\n *\n * - HMAC 검증 (X-Cors-Test-Ts / X-Cors-Test-Sig)\n * - IP 화이트리스트 (ALLOWED_PEER_IPS 가 빈 배열이면 skip)\n * - 메서드/역할 가드는 호출측에서 별도 처리\n *\n * 실패 시 즉시 respondError 로 종료.\n *\n * 별도로 ADMIN 게이팅용 guardAdminToken() 도 제공 (X-Admin-Token 헤더 검증).\n * 세션은 절대 쓰지 않는다 — 운영 세션 충돌 방지.\n */\n\nfunction guardHmacRequest(): void {\n    $ip = clientIp();\n    if (defined('ALLOWED_PEER_IPS') && is_array(ALLOWED_PEER_IPS) && count(ALLOWED_PEER_IPS) > 0) {\n        if (!in_array($ip, ALLOWED_PEER_IPS, true)) {\n            auditAppend('guard.ip_denied', ['ip' => $ip]);\n            respondError(403, 'ip_not_allowed');\n        }\n    }\n\n    $ts  = headerOrNull('X-Cors-Test-Ts');\n    $sig = headerOrNull('X-Cors-Test-Sig');\n    $body = readRawBody();\n    $method = requestMethod();\n    $path = requestPathWithQuery();\n\n    $r = hmacVerify(SYNC_SECRET, $ts, $sig, $method, $path, $body);\n    if (!$r['ok']) {\n        auditAppend('guard.hmac_failed', ['err' => $r['error'], 'ip' => $ip, 'method' => $method, 'path' => $path]);\n        respondError(401, $r['error']);\n    }\n}\n\n/**\n * X-Admin-Token 헤더 검증. UI 자체 게이팅 + upload/purge/run 보호용.\n * 세션 절대 미사용.\n */\nfunction guardAdminToken(): void {\n    $tok = headerOrNull('X-Admin-Token');\n    if ($tok === null || $tok === '' || !defined('ADMIN_TOKEN') || ADMIN_TOKEN === '') {\n        auditAppend('guard.admin_missing', ['ip' => clientIp()]);\n        respondError(401, 'admin_token_required');\n    }\n    if (!hash_equals(ADMIN_TOKEN, $tok)) {\n        auditAppend('guard.admin_bad', ['ip' => clientIp()]);\n        respondError(401, 'admin_token_invalid');\n    }\n}\n\n/**\n * asset.php 용 시간제한 토큰. 짧은 TTL (기본 5분).\n * canonical: filename + \"|\" + exp (정수 epoch)\n * 결과: <hex_sig>.<exp>\n */\nfunction assetTokenIssue(string $filename, int $ttlSec = 300): string {\n    $exp = time() + max(10, $ttlSec);\n    $canon = $filename . '|' . $exp;\n    $sig = hash_hmac('sha256', $canon, SYNC_SECRET);\n    return $sig . '.' . $exp;\n}\n\nfunction assetTokenVerify(string $filename, string $token): array {\n    if (!preg_match('/^([a-f0-9]{64})\\.(\\d{1,12})$/', $token, $m)) {\n        return ['ok' => false, 'error' => 'bad_token_format'];\n    }\n    $sig = $m[1];\n    $exp = (int) $m[2];\n    if (time() > $exp) return ['ok' => false, 'error' => 'token_expired'];\n    $expected = hash_hmac('sha256', $filename . '|' . $exp, SYNC_SECRET);\n    if (!hash_equals($expected, $sig)) {\n        return ['ok' => false, 'error' => 'bad_token_signature'];\n    }\n    return ['ok' => true, 'exp' => $exp];\n}\n","numLines":78,"startLine":1,"totalLines":78}},"sourceToolAssistantUUI