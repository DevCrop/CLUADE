    default:\n            return [[\n                'expected' => null,\n                'actual'   => null,\n                'verdict'  => '❌',\n            ], \"unknown case: $case\"];\n    }\n}\n\n\n/**\n * peerCall 의 raw 변형 — 의도적으로 잘못된 ts/sig/headers 를 보내는 케이스용.\n * options:\n *   - 'ts_override'  => int   (timestamp 강제값)\n *   - 'sig_override' => string (signature 강제값)\n *   - 'skip_auth'    => bool   (ts/sig 헤더 자체 누락)\n */\nfunction peerCallRaw(string $method, string $relPath, array $body, array $options): array {\n    $method = strtoupper($method);\n    $base   = rtrim(PEER_BASE_URL, '/');\n    $url    = $base . '/' . ltrim($relPath, '/');\n    $u = parse_url($url);\n    if ($u === false || empty($u['host'])) {\n        return ['ok'=>false, 'status'=>0, 'json'=>null, 'raw'=>'',\n                'request'=>['url'=>$url, 'path'=>'', 'headers'=>[], 'body'=>''],\n                'timing_ms'=>0, 'error'=>'bad_peer_url'];\n    }\n    $path = ($u['path'] ?? '/') . (isset($u['query']) ? '?' . $u['query'] : '');\n    $bodyJson = ($method === 'GET' || $method === 'OPTIONS') ? '' : json_encode($body, JSON_UNESCAPED_SLASHES);\n    if ($bodyJson === false) $bodyJson = '';\n\n    $headers = [\n        'Content-Type: application/json; charset=utf-8',\n        'Accept: application/json',\n        'User-Agent: cors-test/1.0',\n        'X-Cors-Test-Host: ' . (defined('THIS_HOST') ? THIS_HOST : ''),\n    ];\n    $skipAuth = !empty($options['skip_auth']);\n    if (!$skipAuth) {\n        $ts  = isset($options['ts_override']) ? (string)$options['ts_override'] : (string)time();\n        $sig = isset($options['sig_override'])\n            ? (string)$options['sig_override']\n            : hmacSign(SYNC_SECRET, $ts, $method, $path, $bodyJson);\n        $headers[] = 'X-Cors-Test-Ts: '  . $ts;\n        $headers[] = 'X-Cors-Test-Sig: ' . $sig;\n    }\n\n    $ch = curl_init();\n    curl_setopt_array($ch, [\n        CURLOPT_URL            => $url,\n        CURLOPT_CUSTOMREQUEST  => $method,\n        CURLOPT_RETURNTRANSFER => true,\n        CURLOPT_HTTPHEADER     => $headers,\n        CURLOPT_TIMEOUT        => 30,\n        CURLOPT_CONNECTTIMEOUT => 10,\n        CURLOPT_FOLLOWLOCATION => false,\n        CURLOPT_SSL_VERIFYPEER => true,\n        CURLOPT_SSL_VERIFYHOST => 2,\n    ]);\n    if ($bodyJson !== '') {\n        curl_setopt($ch, CURLOPT_POSTFIELDS, $bodyJson);\n    }\n    $start = microtime(true);\n    $raw = curl_exec($ch);\n    $elapsed = (int) round((microtime(true) - $start) * 1000);\n    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);\n    $err = curl_error($ch) ?: null;\n    curl_close($ch);\n\n    $json = null;\n    if (is_string($raw) && $raw !== '') {\n        $d = json_decode($raw, true);\n        if (is_array($d)) $json = $d;\n    }\n    if (!is_string($raw)) $raw = '';\n\n    return [\n        'ok'        => $err === null && $status >= 200 && $status < 300,\n        'status'    => $status,\n        'json'      => $json,\n        'raw'       => $raw,\n        'request'   => [\n            'url'     => $url,\n            'path'    => $path,\n            'method'  => $method,\n            'headers' => $headers,\n            'body'    => $bodyJson === '' ? null : json_decode($bodyJson, true),\n            'options' => array_keys($options),\n        ],\n        'timing_ms' => $elapsed,\n        'error'     => $err,\n    ];\n}\n","numLines":372,"startLine":1,"totalLines":372}},"sourceToolAssistantUUID":"4fe6f7b6-9af2-4eee-a1a9-38d93eeaa32e","userType":"external","entrypoint":"claude-vscode","cwd":"d:\\최신프로젝트\\인터파크\\백업\\260427","sessionId":"59c7642a-71bc-4ae8-a885-c0624014856b","version":"2.1.121","gitBranch":"HEAD"}
