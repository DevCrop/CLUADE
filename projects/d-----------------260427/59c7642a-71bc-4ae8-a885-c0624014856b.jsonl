('Content-Type: application/json; charset=utf-8');\n54\t    header('X-Robots-Tag: noindex, nofollow');\n55\t    echo json_encode(['ok' => false, 'error' => 'maintenance', 'message' => 'service temporarily unavailable']);\n56\t    exit;\n57\t}\n58\t\n59\t// 5. storage/logs 보장 (없으면 생성, 권한 0750)\n60\tforeach ([STORAGE_DIR, LOGS_DIR] as $d) {\n61\t    if (!is_dir($d)) {\n62\t        @mkdir($d, 0750, true);\n63\t    }\n64\t}\n65\t\n66\t/**\n67\t * ROLE 가드. api/* 엔드포인트 첫 줄에서 호출.\n68\t *   $allowed = ['ADMIN','BOTH']  → admin 전용 엔드포인트\n69\t *   $allowed = ['USER','BOTH']   → user 전용 엔드포인트\n70\t *   $allowed = ['BOTH','ADMIN','USER'] → 양쪽 다 활성\n71\t */\n72\tfunction requireRole(array $allowed): void {\n73\t    $role = defined('ROLE') ? ROLE : 'BOTH';\n74\t    if (!in_array($role, $allowed, true)) {\n75\t        respondError(405, 'role_disabled', \"endpoint disabled for ROLE=$role\");\n76\t    }\n77\t}\n78\t"}]},"uuid":"441e2f78-fe2d-429f-a9f6-b84b2a66a73e","timestamp":"2026-04-28T05:13:42.164Z","toolUseResult":{"type":"text","file":{"filePath":"d:\\최신프로젝트\\인터파크\\백업\\260427\\cors-test\\lib\\bootstrap.php","content":"<?php\n/**\n * cors-test bootstrap. 모든 entry-point의 첫 줄에서 require.\n *\n * 책임:\n *   1. config 로드\n *   2. KILL_SWITCH 체크 (true면 즉시 503)\n *   3. ROLE 가드 (요청 엔드포인트가 현재 역할에서 활성인지)\n *   4. error/exception 핸들러 (외부 노출 최소화)\n *   5. lib helpers require\n *   6. storage/logs 디렉토리 보장\n */\n\nif (!defined('CORS_TEST_BOOTSTRAPPED')) {\n    define('CORS_TEST_BOOTSTRAPPED', true);\n}\n\n// 1. config\nrequire_once __DIR__ . '/../config.php';\n\n// 2. helpers (의존 순서)\nrequire_once __DIR__ . '/http.php';\nrequire_once __DIR__ . '/db.php';\nrequire_once __DIR__ . '/hmac.php';\nrequire_once __DIR__ . '/upload.php';\nrequire_once __DIR__ . '/audit.php';\nrequire_once __DIR__ . '/peer.php';\nrequire_once __DIR__ . '/guard.php';\n\n// 3. error/exception 핸들러 — 외부엔 generic, 상세는 logs/error.log\nini_set('display_errors', '0');\nini_set('log_errors', '1');\nini_set('error_log', LOGS_DIR . '/error.log');\nheader_remove('X-Powered-By');\n\nset_exception_handler(function ($e) {\n    error_log('[cors-test] uncaught: ' . $e->getMessage() . ' @ ' . $e->getFile() . ':' . $e->getLine());\n    if (!headers_sent()) {\n        respondError(500, 'internal_error');\n    }\n});\n\nset_error_handler(function ($severity, $message, $file, $line) {\n    if (!(error_reporting() & $severity)) return false;\n    error_log(\"[cors-test] $severity: $message @ $file:$line\");\n    return true;\n});\n\n// 4. KILL_SWITCH — 외부 dependency 0\nif (defined('KILL_SWITCH') && KILL_SWITCH === true) {\n    http_response_code(503);\n    header('Retry-After: 3600');\n    header('Content-Type: application/json; charset=utf-8');\n    header('X-Robots-Tag: noindex, nofollow');\n    echo json_encode(['ok' => false, 'error' => 'maintenance', 'message' => 'service temporarily unavailable']);\n    exit;\n}\n\n// 5. storage/logs 보장 (없으면 생성, 권한 0750)\nforeach ([STORAGE_DIR, LOGS_DIR] as $d) {\n    if (!is_dir($d)) {\n        @mkdir($d, 0750, true);\n    }\n}\n\n/**\n * ROLE 가드. api/* 엔드포인트 첫 줄에서 호출.\n *   $allowed = ['ADMIN','BOTH']  → admin 전용 엔드포인트\n *   $allowed = ['USER','BOTH']   → user 전용 엔드포인트\n *   $allowed = ['BOTH','ADMIN','USER'] → 양쪽 다 활성\n */\nfunction requireRole(array $allowed): void {\n    $role = defined('ROLE') ? ROLE : 'BOTH';\n    if (!in_array($role, $allowed, true)) {\n        respondError(405, 'role_disabled', \"endpoint disabled for ROLE=$role\");\n    }\n}\n","numLines":78,"startLine":1,"totalLines":78}},"sourceToolAssistantUUID":"5daf57f1-582d-4f5e-9b0a-2ca4d1739bdd","userType":"external","entrypoint":"claude-vscode","cwd":"D:\\최신프로젝트\\인터파크\\백업\\260427","sessionId":"59c7642a-71bc-4ae8-a885-c0624014856b","version":"2.1.121","gitBranch":"HEAD"}
