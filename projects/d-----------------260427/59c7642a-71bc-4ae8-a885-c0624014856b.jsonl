{"parentUuid":"81028223-b7fb-4b77-803d-7db849608689","isSidechain":false,"attachment":{"type":"file","filename":"d:\\최신프로젝트\\인터파크\\백업\\260427\\deploy-noltheater\\config.local.php","content":{"type":"text","file":{"filePath":"d:\\최신프로젝트\\인터파크\\백업\\260427\\deploy-noltheater\\config.local.php","content":"<?php\n/**\n * cors-test config.local.php — www.noltheater-daehakro.com\n * gitignore 대상. FTP 업로드 시 파일명을 config.local.php 로 바꿔서 올릴 것.\n */\n\n// === 자기 호스트 ===\ndefine('THIS_HOST',      'www.noltheater-daehakro.com');\n\n// === peer (반대편 호스팅) ===\ndefine('PEER_BASE_URL',  'https://bluesquare.kr/cors-test');\n\n// === 시크릿 (bluesquare 측과 반드시 동일) ===\ndefine('SYNC_SECRET',    '510cab4fa2e011135d277a089e9929652e1b6e51ad2d424c0b09d129d5aa4ce6');\n\n// === 관리자 토큰 (noltheater 전용 — bluesquare와 다른 값) ===\ndefine('ADMIN_TOKEN',    '050ba78d8997088152a5d0c3dba9f58b');\n\n// === peer IP 화이트리스트 ===\ndefine('ALLOWED_PEER_IPS', []);\n\n// === DB 자격증명 ===\ndefine('DB_HOST', 'db.usrdaehakro0605.gabia.io');\ndefine('DB_NAME', 'dbusrdaehakro0605');\ndefine('DB_USER', 'usrdaehakro0605');\ndefine('DB_PASS', 'dae@hak_0605!r9x');\n\n// === 역할 ===\ndefine('ROLE', 'BOTH');\n\n// === 비상 차단 스위치 ===\ndefine('KILL_SWITCH', false);\n","numLines":33,"startLine":1,"totalLines":33}},"displayPath":"deploy-noltheater\\config.local.php"},"type":"attachment","uuid":"b0d1f46e-3810-481e-978d-39c74ecd3316","timestamp":"2026-04-28T06:14:05.363Z","userType":"external","entrypoint":"claude-vscode","cwd":"d:\\최신프로젝트\\인터파크\\백업\\260427","sessionId":"59c7642a-71bc-4ae8-a885-c0624014856b","version":"2.1.121","gitBranch":"HEAD","slug":"reactive-tumbling-stonebraker"}
