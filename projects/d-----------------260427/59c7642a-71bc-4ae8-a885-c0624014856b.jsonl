oken' => $tok],\n246\t                'verdict'  => '✅',\n247\t            ], 'token issued (peer can verify because SYNC_SECRET shared)'];\n248\t        }\n249\t\n250\t        case 'peer_push': {\n251\t            // 이미 storage 에 있는 파일을 peer.receive 로 push\n252\t            $name = (string)($p['name'] ?? '');\n253\t            $base = safeBasename($name);\n254\t            $path = $base !== null ? STORAGE_DIR . '/' . $base : null;\n255\t            if ($base === null || !$path || !is_file($path)) {\n256\t                return [['expected'=>['ok'=>true],'actual'=>['error'=>'not_found'],'verdict'=>'❌'], 'storage file not found'];\n257\t            }\n258\t            $bytes = file_get_contents($path);\n259\t            $sha = hash('sha256', $bytes);\n260\t            $mime = detectMime($path);\n261\t            $r = peerCall('POST', '/api/receive.php', [\n262\t                'orig'   => $base,\n263\t                'name'   => $base,\n264\t                'size'   => strlen($bytes),\n265\t                'mime'   => $mime,\n266\t                'sha256' => $sha,\n267\t                'b64'    => base64_encode($bytes),\n268\t            ]);\n269\t            $verdict = $r['ok'] ? '✅' : '❌';\n270\t            return [[\n271\t                'expected' => ['status' => 200, 'sha256' => $sha],\n272\t                'actual'   => ['status' => $r['status'], 'sha256' => $r['json']['data']['sha256'] ?? null],\n273\t                'verdict'  => $verdict,\n274\t                'request'  => array_merge($r['request'], ['body_summary' => ['name'=>$base, 'size'=>strlen($bytes), 'mime'=>$mime]]),\n275\t                'response' => $r['json'],\n276\t            ], $r['error'] ?: 'peer push'];\n277\t        }\n278\t\n279\t        default:\n280\t            return [[\n281\t                'expected' => null,\n282\t                'actual'   => null,\n283\t                'verdict'  => '❌',\n284\t            ], \"unknown case: $case\"];\n285\t    }\n286\t}\n287\t\n288\t\n289\t/**\n290\t * peerCall 의 raw 변형 — 의도적으로 잘못된 ts/sig/headers 를 보내는 케이스용.\n291\t * options:\n292\t *   - 'ts_override'  => int   (timestamp 강제값)\n293\t *   - 'sig_override' => string (signature 강제값)\n294\t *   - 'skip_auth'    => bool   (ts/sig 헤더 자체 누락)\n295\t */\n296\tfunction peerCallRaw(string $method, string $relPath, array $body, array $options): array {\n297\t    $method = strtoupper($method);\n298\t    $base   = rtrim(PEER_BASE_URL, '/');\n299\t    $url    = $base . '/' . ltrim($relPath, '/');\n300\t    $u = parse_url($url);\n301\t    if ($u === false || empty($u['host'])) {\n302\t        return ['ok'=>false, 'status'=>0, 'json'=>null, 'raw'=>'',\n303\t                'request'=>['url'=>$url, 'path'=>'', 'headers'=>[], 'body'=>''],\n304\t                'timing_ms'=>0, 'error'=>'bad_peer_url'];\n305\t    }\n306\t    $path = ($u['path'] ?? '/') . (isset($u['query']) ? '?' . $u['query'] : '');\n307\t    $bodyJson = ($method === 'GET' || $method === 'OPTIONS') ? '' : json_encode($body, JSON_UNESCAPED_SLASHES);\n308\t    if ($bodyJson === false) $bodyJson = '';\n309\t\n310\t    $headers = [\n311\t        'Content-Type: application/json; charset=utf-8',\n312\t        'Accept: application/json',\n313\t        'User-Agent: cors-test/1.0',\n314\t        'X-Cors-Test-Host: ' . (defined('THIS_HOST') ? THIS_HOST : ''),\n315\t    ];\n316\t    $skipAuth = !empty($options['skip_auth']);\n317\t    if (!$skipAuth) {\n318\t        $ts  = isset($options['ts_override']) ? (string)$options['ts_override'] : (string)time();\n319\t        $sig = isset($options['sig_override'])\n320\t            ? (string)$options['sig_override']\n321\t            : hmacSign(SYNC_SECRET, $ts, $method, $path, $bodyJson);\n322\t        $headers[] = 'X-Cors-Test-Ts: '  . $ts;\n323\t        $headers[] = 'X-Cors-Test-Sig: ' . $sig;\n324\t    }\n325\t\n326\t    $ch = curl_init();\n327\t    curl_setopt_array($ch, [\n328\t        CURLOPT_URL            => $url,\n329\t        CURLOPT_CUSTOMREQUEST  => $method,\n330\t        CURLOPT_RETURNTRANSFER => true,\n331\t        CURLOPT_HTTPHEADER     => $headers,\n332\t        CURLOPT_TIMEOUT        => 30,\n333\t        CURLOPT_CONNECTTIMEOUT => 10,\n334\t        CURLOPT_FOLLOWLOCATION => false,\n335\t        CURLOPT_SSL_VERIFYPEER => true,\n336\t        CURLOPT_SSL_VERIFYHOST => 2,\n337\t    ]);\n338\t    if ($bodyJson !== '') {\n339\t        curl_setopt($ch, CURLOPT_POSTFIELDS, $bodyJson);\n340\t    }\n341\t    $start = microtime(true);\n342\t    $raw = curl_exec($ch);\n343\t    $elapsed = (int) round((microtime(true) - $start) * 1000);\n344\t    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);\n345\t    $err = curl_error($ch) ?: null;\n346\t    curl_close($ch);\n347\t\n348\t    $json = null;\n349\t    if (is_string($raw) && $raw !== '') {\n350\t        $d = json_decode($raw, true);\n351\t        if (is_array($d)) $json = $d;\n352\t    }\n353\t    if (!is_string($raw)) $raw = '';\n354\t\n355\t    return [\n356\t        'ok'        => $err === null && $status >= 200 && $status < 300,\n357\t        'status'    => $status,\n358\t        'json'      => $json,\n359\t        'raw'       => $raw,\n360\t        'request'   => [\n361\t            'url'     => $url,\n362\t            'path'    => $path,\n363\t            'method'  => $method,\n364\t            'headers' => $headers,\n365\t            'body'    => $bodyJson === '' ? null : json_decode($bodyJson, true),\n366\t            'options' => array_keys($options),\n367\t        ],\n368\t        'timing_ms' => $elapsed,\n369\t        'error'     => $err,\n370\t    ];\n371\t}\n372\t"}]},"uuid":"02680022-6b62-4db9-84a6-694774021b61","timestamp":"2026-04-28T05:34:31.205Z","toolUseResult":{"type":"text","file":{"filePath":"d:\\최신프로젝트\\인터파크\\백업\\260427\\cors-test\\api\\run.php","content":"<?php\n/**\n * POST /cors-test/api/run.php\n *\n * UI 의 thin proxy 디스패처. 시크릿을 브라우저에 노출하지 않으려고 모든\n * 서버측 매트릭스 케이스는 여기를 통해 실행한다.\n *\n * Body (JSON): { \"case\": \"<id>\", \"params\": { ... } }\n *\n * 인증: X-Admin-Token. 세션 미사용.\n *\n * 표준 응답 data 스키마:\n *   { case, expected, actual, verdict, request, response, timing_ms, headers, note }\n */\n\nrequire __DIR__ . '/../lib/bootstrap.php';\nrequireMethod('POST');\nrequireRole(['ADMIN', 'USER', 'BOTH']);\nguardAdminToken();\n\n$raw = readRawBody();\n$j   = json_decode($raw, true);\nif (!is_array($j) || empty($j['case'])) {\n    respondError(400, 'bad_case');\n}\n$case   = (string)$j['case'];\n$params = is_array($j['params'] ?? null) ? $j['params'] : [];\n\n$start = microtime(true);\n[$result, $note] = runCase($case, $params);\n$elapsed = (int) round((microtime(true) - $start) * 1000);\n\n$verdict = $result['verdict'] ?? null;\nauditAppend('run.case', [\n    'case'      => $case,\n    'verdict'   => $verdict,\n    'timing_ms' => $elapsed,\n]);\n\nrespondOk([\n    'case'      => $case,\n    'expected'  => $result['expected'] ?? null,\n    'actual'    => $result['actual']   ?? null,\n    'verdict'   => $verdict,\n    'request'   => $result['request']  ?? null,\n    'response'  => $result['response'] ?? null,\n    'headers'   => $result['headers']  ?? null,\n    'timing_ms' => $elapsed,\n    'note'      => $note,\n]);\n\n\n/**\n * case 핸들러 디스패처.\n * 반환: [ ['expected'=>..., 'actual'=>..., 'verdict'=>..., 'request'=>..., 'response'=>..., 'headers'=>...], note_string ]\n */\nfunction runCase(string $case, array $p): array {\n    switch ($case) {\n\n        case 'whoami_self': {\n            // 직접 인-프로세스로 self info를 만든다 (HTTP 라운드트립 회피).\n            $info = [\n                'host'        => THIS_HOST,\n                'role'        => ROLE,\n                'kill_switch' => (bool) KILL_SWITCH,\n                'fingerprint' => secretFingerprint(SYNC_SECRET),\n            ];\n            return [[\n                'expected' => ['ok' => true, 'fingerprint_set' => true],\n                'actual'   => ['ok' => true, 'data' => $info],\n                'verdict'  => '✅',\n            ], 'self info'];\n        }\n\n        case 'whoami_peer': {\n            $r = peerCall('GET', '/api/whoami.php', []);\n            $fp = $r['json']['data']['fingerprint'] ?? null;\n            $verdict = $r['ok'] && $fp === secretFingerprint(SYNC_SECRET) ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200, 'fingerprint' => secretFingerprint(SYNC_SECRET)],\n                'actual'   => ['status' => $r['status'], 'fingerprint' => $fp, 'host' => $r['json']['data']['host'] ?? null],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], $verdict === '✅' ? 'fingerprint match — secret in sync' : 'fingerprint mismatch — secret NOT in sync'];\n        }\n\n        case 'ping_peer': {\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCall('POST', '/api/ping.php', $body);\n            $verdict = $r['ok'] && ($r['json']['data']['pong'] ?? false) === true ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200, 'pong' => true],\n                'actual'   => ['status' => $r['status'], 'pong' => $r['json']['data']['pong'] ?? null, 'rtt_ms' => $r['timing_ms']],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], $r['error'] ?: 'normal HMAC roundtrip'];\n        }\n\n        case 'ping_bad_ts': {\n            // 11분 전 timestamp 로 강제 → stale_timestamp 401 기대\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCallRaw('POST', '/api/ping.php', $body, ['ts_override' => time() - 660]);\n            $err = $r['json']['error'] ?? null;\n            $verdict = $r['status'] === 401 && $err === 'stale_timestamp' ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 401, 'error' => 'stale_timestamp'],\n                'actual'   => ['status' => $r['status'], 'e