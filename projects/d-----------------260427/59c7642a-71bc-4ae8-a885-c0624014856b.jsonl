{"parentUuid":"f89f6182-8533-4258-a4a5-517aa5350c9b","isSidechain":false,"promptId":"1f6f9a3e-610a-4fef-8ce1-e139140c7ef0","type":"user","message":{"role":"user","content":[{"type":"text","text":"<ide_selection>The user selected the lines 1 to 379 from d:\\최신프로젝트\\인터파크\\백업\\260427\\deploy-bluesquare\\api\\run.php:\n<?php // v2\n/**\n * POST /cors-test/api/run.php\n *\n * UI 의 thin proxy 디스패처. 시크릿을 브라우저에 노출하지 않으려고 모든\n * 서버측 매트릭스 케이스는 여기를 통해 실행한다.\n *\n * Body (JSON): { \"case\": \"<id>\", \"params\": { ... } }\n *\n * 인증: X-Admin-Token. 세션 미사용.\n *\n * 표준 응답 data 스키마:\n *   { case, expected, actual, verdict, request, response, timing_ms, headers, note }\n */\n\nrequire __DIR__ . '/../lib/bootstrap.php';\nrequireMethod('POST');\nrequireRole(['ADMIN', 'USER', 'BOTH']);\nguardAdminToken();\n\n$raw = readRawBody();\n// form-encoded 래퍼 지원 (WAF 우회: d=<base64(json)>)\nif (isset($_POST['d'])) {\n    $raw = (string) base64_decode($_POST['d'], true);\n} elseif (str_starts_with($raw, 'd=')) {\n    parse_str($raw, $pv);\n    $raw = isset($pv['d']) ? (string) base64_decode($pv['d'], true) : $raw;\n}\n$j   = json_decode($raw, true);\nif (!is_array($j) || empty($j['case'])) {\n    respondError(400, 'bad_case');\n}\n$case   = (string)$j['case'];\n$params = is_array($j['params'] ?? null) ? $j['params'] : [];\n\n$start = microtime(true);\n[$result, $note] = runCase($case, $params);\n$elapsed = (int) round((microtime(true) - $start) * 1000);\n\n$verdict = $result['verdict'] ?? null;\nauditAppend('run.case', [\n    'case'      => $case,\n    'verdict'   => $verdict,\n    'timing_ms' => $elapsed,\n]);\n\nrespondOk([\n    'case'      => $case,\n    'expected'  => $result['expected'] ?? null,\n    'actual'    => $result['actual']   ?? null,\n    'verdict'   => $verdict,\n    'request'   => $result['request']  ?? null,\n    'response'  => $result['response'] ?? null,\n    'headers'   => $result['headers']  ?? null,\n    'timing_ms' => $elapsed,\n    'note'      => $note,\n]);\n\n\n/**\n * case 핸들러 디스패처.\n * 반환: [ ['expected'=>..., 'actual'=>..., 'verdict'=>..., 'request'=>..., 'response'=>..., 'headers'=>...], note_string ]\n */\nfunction runCase(string $case, array $p): array {\n    switch ($case) {\n\n        case 'whoami_self': {\n            // 직접 인-프로세스로 self info를 만든다 (HTTP 라운드트립 회피).\n            $info = [\n                'host'        => THIS_HOST,\n                'role'        => ROLE,\n                'kill_switch' => (bool) KILL_SWITCH,\n                'fingerprint' => secretFingerprint(SYNC_SECRET),\n            ];\n            return [[\n                'expected' => ['ok' => true, 'fingerprint_set' => true],\n                'actual'   => ['ok' => true, 'data' => $info],\n                'verdict'  => '✅',\n            ], 'self info'];\n        }\n\n        case 'whoami_peer': {\n            $r = peerCall('GET', '/api/whoami.php', []);\n            $fp = $r['json']['data']['fingerprint'] ?? null;\n            $verdict = $r['ok'] && $fp === secretFingerprint(SYNC_SECRET) ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200, 'fingerprint' => secretFingerprint(SYNC_SECRET)],\n                'actual'   => ['status' => $r['status'], 'fingerprint' => $fp, 'host' => $r['json']['data']['host'] ?? null],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], $verdict === '✅' ? 'fingerprint match — secret in sync' : 'fingerprint mismatch — secret NOT in sync'];\n        }\n\n        case 'ping_peer': {\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCall('POST', '/api/ping.php', $body);\n            $verdict = $r['ok'] && ($r['json']['data']['pong'] ?? false) === true ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200, 'pong' => true],\n                'actual'   => ['status' => $r['status'], 'pong' => $r['json']['data']['pong'] ?? null, 'rtt_ms' => $r['timing_ms']],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], $r['error'] ?: 'normal HMAC roundtrip'];\n        }\n\n        case 'ping_bad_ts': {\n            // 11분 전 timestamp 로 강제 → stale_timestamp 401 기대\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCallRaw('POST', '/api/ping.php', $body, ['ts_override' => time() - 660]);\n            $err = $r['json']['error'] ?? null;\n            $verdict = $r['status'] === 401 && $err === 'stale_timestamp' ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 401, 'error' => 'stale_timestamp'],\n                'actual'   => ['status' => $r['status'], 'error' => $err],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'intentional bad ts'];\n        }\n\n        case 'ping_bad_sig': {\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCallRaw('POST', '/api/ping.php', $body, ['sig_override' => str_repeat('0', 64)]);\n            $err = $r['json']['error'] ?? null;\n            $verdict = $r['status'] === 401 && $err === 'bad_signature' ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 401, 'error' => 'bad_signature'],\n                'actual'   => ['status' => $r['status'], 'error' => $err],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'intentional bad sig'];\n        }\n\n        case 'ping_no_auth': {\n            $body = ['nonce' => bin2hex(random_bytes(8)), 'client_ts' => time()];\n            $r = peerCallRaw('POST', '/api/ping.php', $body, ['skip_auth' => true]);\n            $err = $r['json']['error'] ?? null;\n            $verdict = $r['status'] === 401 && $err === 'missing_auth' ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 401, 'error' => 'missing_auth'],\n                'actual'   => ['status' => $r['status'], 'error' => $err],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'intentional missing auth headers'];\n        }\n\n        case 'options_peer': {\n            $r = peerCallRaw('OPTIONS', '/api/ping.php', [], ['skip_auth' => true]);\n            $verdict = $r['status'] === 405 ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 405],\n                'actual'   => ['status' => $r['status']],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'CORS preflight rejection by design'];\n        }\n\n        case 'cors_probe_peer': {\n            $r = peerCall('GET', '/api/cors-probe.php', []);\n            $verdict = $r['ok'] ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200],\n                'actual'   => ['status' => $r['status']],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'server-to-server probe (NOT brower); brower direct must be blocked — see UI direct cases'];\n        }\n\n        case 'list_peer': {\n            $verify = !empty($p['verify']);\n            $tail   = (int)($p['tail'] ?? 50);\n            $r = peerCall('GET', '/api/list.php?tail=' . $tail . ($verify ? '&verify=1' : ''), []);\n            $verdict = $r['ok'] ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200],\n                'actual'   => ['status' => $r['status'], 'files' => count($r['json']['data']['files'] ?? [])],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'peer ledger'];\n        }\n\n        case 'list_self': {\n            // 자기 list 를 직접 호출 (HMAC 안 거치고 in-process 로)\n            $entries = auditTail((int)($p['tail'] ?? 50));\n            $files = [];\n            $glob = glob(STORAGE_DIR . '/*') ?: [];\n            foreach ($glob as $f) {\n                if (!is_file($f)) continue;\n                $files[] = ['name' => basename($f), 'size' => filesize($f), 'mtime' => filemtime($f)];\n            }\n            return [[\n                'expected' => ['ok' => true],\n                'actual'   => ['files' => count($files), 'entries' => count($entries)],\n                'verdict'  => '✅',\n                'response' => ['files' => $files, 'entries' => array_slice($entries, -10)],\n            ], 'self ledger'];\n        }\n\n        case 'integrity': {\n            // 양쪽 list?verify=1 비교\n            $self = [];\n            $glob = glob(STORAGE_DIR . '/*') ?: [];\n            foreach ($glob as $f) {\n                if (!is_file($f)) continue;\n                $self[basename($f)] = sha256OfFile($f);\n            }\n            $r = peerCall('GET', '/api/list.php?verify=1&tail=1', []);\n            $peerFiles = $r['json']['data']['files'] ?? [];\n            $peer = [];\n            foreach ($peerFiles as $pf) {\n                if (isset($pf['name'], $pf['sha256'])) $peer[$pf['name']] = $pf['sha256'];\n            }\n            $names = array_unique(array_merge(array_keys($self), array_keys($peer)));\n            $rows = [];\n            $allMatch = true;\n            foreach ($names as $n) {\n                $a = $self[$n] ?? null;\n                $b = $peer[$n] ?? null;\n                $match = $a !== null && $b !== null && $a === $b;\n                if (!$match) $allMatch = false;\n                $rows[] = ['name' => $n, 'self' => $a, 'peer' => $b, 'match' => $match];\n            }\n            $verdict = $allMatch && count($rows) > 0 ? '✅' : (count($rows) === 0 ? '⚠' : '❌');\n            return [[\n                'expected' => ['all_match' => true],\n                'actual'   => ['files' => count($rows), 'all_match' => $allMatch, 'rows' => $rows],\n                'verdict'  => $verdict,\n                'response' => $r['json'],\n            ], 'sha256 cross-host integrity'];\n        }\n\n        case 'asset_token_issue': {\n            $name = (string)($p['name'] ?? '');\n            $base = safeBasename($name);\n            if ($base === null) {\n                return [['expected'=>['ok'=>true],'actual'=>['error'=>'bad_name'],'verdict'=>'❌'], 'bad name'];\n            }\n            $ttl = max(10, min(3600, (int)($p['ttl'] ?? 300)));\n            $tok = assetTokenIssue($base, $ttl);\n            // self URL과 peer URL 둘 다 만들어 UI 가 cross-origin <img> 테스트하게\n            $selfUrl = '/cors-test/api/asset.php?name=' . rawurlencode($base) . '&token=' . $tok;\n            $peerUrl = rtrim(PEER_BASE_URL, '/') . '/api/asset.php?name=' . rawurlencode($base) . '&token=' . $tok;\n            return [[\n                'expected' => ['ok' => true],\n                'actual'   => ['name' => $base, 'ttl' => $ttl, 'self_url' => $selfUrl, 'peer_url' => $peerUrl, 'token' => $tok],\n                'verdict'  => '✅',\n            ], 'token issued (peer can verify because SYNC_SECRET shared)'];\n        }\n\n        case 'peer_push': {\n            // 이미 storage 에 있는 파일을 peer.receive 로 push\n            $name = (string)($p['name'] ?? '');\n            $base = safeBasename($name);\n            $path = $base !== null ? STORAGE_DIR . '/' . $base : null;\n            if ($base === null || !$path || !is_file($path)) {\n                return [['expected'=>['ok'=>true],'actual'=>['error'=>'not_found'],'verdict'=>'❌'], 'storage file not found'];\n            }\n            $bytes = file_get_contents($path);\n            $sha = hash('sha256', $bytes);\n            $mime = detectMime($path);\n            $r = peerCall('POST', '/api/receive.php', [\n                'orig'   => $base,\n                'name'   => $base,\n                'size'   => strlen($bytes),\n                'mime'   => $mime,\n                'sha256' => $sha,\n                'b64'    => base64_encode($bytes),\n            ]);\n            $verdict = $r['ok'] ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200, 'sha256' => $sha],\n                'actual'   => ['status' => $r['status'], 'sha256' => $r['json']['data']['sha256'] ?? null],\n                'verdict'  => $verdict,\n                'request'  => array_merge($r['request'], ['body_summary' => ['name'=>$base, 'size'=>strlen($bytes), 'mime'=>$mime]]),\n                'response' => $r['json'],\n            ], $r['error'] ?: 'peer push'];\n        }\n\n        default:\n            return [[\n                'expected' => null,\n                'actual'   => null,\n                'verdict'  => '❌',\n            ], \"unknown case: $case\"];\n    }\n}\n\n\n/**\n * peerCall 의 raw 변형 — 의도적으로 잘못된 ts/sig/headers 를 보내는 케이스용.\n * options:\n *   - 'ts_override'  => int   (timestamp 강제값)\n *   - 'sig_override' => string (signature 강제값)\n *   - 'skip_auth'    => bool   (ts/sig 헤더 자체 누락)\n */\nfunction peerCallRaw(string $method, string $relPath, array $body, array $options): array {\n    $method = strtoupper($method);\n    $base   = rtrim(PEER_BASE_URL, '/');\n    $url    = $base . '/' . ltrim($relPath, '/');\n    $u = parse_url($url);\n    if ($u === false || empty($u['host'])) {\n        return ['ok'=>false, 'status'=>0, 'json'=>null, 'raw'=>'',\n                'request'=>['url'=>$url, 'path'=>'', 'headers'=>[], 'body'=>''],\n                'timing_ms'=>0, 'error'=>'bad_peer_url'];\n    }\n    $path = ($u['path'] ?? '/') . (isset($u['query']) ? '?' . $u['query'] : '');\n    $bodyJson = ($method === 'GET' || $method === 'OPTIONS') ? '' : json_encode($body, JSON_UNESCAPED_SLASHES);\n    if ($bodyJson === false) $bodyJson = '';\n\n    $headers = [\n        'Content-Type: application/json; charset=utf-8',\n        'Accept: application/json',\n        'User-Agent: PHP/7.4',\n        'X-Sync-Host: ' . (defined('THIS_HOST') ? THIS_HOST : ''),\n    ];\n    $skipAuth = !empty($options['skip_auth']);\n    if (!$skipAuth) {\n        $ts  = isset($options['ts_override']) ? (string)$options['ts_override'] : (string)time();\n        $sig = isset($options['sig_override'])\n            ? (string)$options['sig_override']\n            : hmacSign(SYNC_SECRET, $ts, $method, $path, $bodyJson);\n        $headers[] = 'X-Sync-Ts: '  . $ts;\n        $headers[] = 'X-Sync-Sig: ' . $sig;\n    }\n\n    $ch = curl_init();\n    curl_setopt_array($ch, [\n        CURLOPT_URL            => $url,\n        CURLOPT_CUSTOMREQUEST  => $method,\n        CURLOPT_RETURNTRANSFER => true,\n        CURLOPT_HTTPHEADER     => $headers,\n        CURLOPT_TIMEOUT        => 30,\n        CURLOPT_CONNECTTIMEOUT => 10,\n        CURLOPT_FOLLOWLOCATION => false,\n        CURLOPT_SSL_VERIFYPEER => true,\n        CURLOPT_SSL_VERIFYHOST => 2,\n    ]);\n    if ($bodyJson !== '') {\n        curl_setopt($ch, CURLOPT_POSTFIELDS, $bodyJson);\n    }\n    $start = microtime(true);\n    $raw = curl_exec($ch);\n    $elapsed = (int) round((microtime(true) - $start) * 1000);\n    $status = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);\n    $err = curl_error($ch) ?: null;\n    curl_close($ch);\n\n    $json = null;\n    if (is_string($raw) && $raw !== '') {\n        $d = json_decode($raw, true);\n        if (is_array($d)) $json = $d;\n    }\n    if (!is_string($raw)) $raw = '';\n\n    return [\n        'ok'        => $err === null && $status >= 200 && $status < 300,\n        'status'    => $status,\n        'json'      => $json,\n        'raw'       => $raw,\n        'request'   => [\n            'url'     => $url,\n            'path'    => $path,\n            'method'  => $method,\n            'headers' => $headers,\n            'body'    => $bodyJson === '' ? null