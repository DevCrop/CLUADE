2e1b6e51ad2d424c0b09d129d5aa4ce6');\n\n// === 관리자 토큰 (bluesquare 전용 — noltheater와 다른 값) ===\n// 생성: openssl rand -hex 16\ndefine('ADMIN_TOKEN',    '33f2a17510d5429db2562e9536735d8f');\n\n// === peer IP 화이트리스트 ===\n// 빈 배열 = IP 검증 skip (처음엔 빈 배열로 시작)\ndefine('ALLOWED_PEER_IPS', []);\n\n// === DB 자격증명 ===\ndefine('DB_HOST', '211.47.74.49');\ndefine('DB_NAME', 'dbusrbluesq0211');\ndefine('DB_USER', 'usrbluesq0211');\ndefine('DB_PASS', 'sqrblue#1100^ble');\n\n// === 역할 ===\ndefine('ROLE', 'BOTH');\n\n// === 비상 차단 스위치 ===\n// 최초 배포 시 반드시 true — whoami.php 503 확인 후 false로 토글\ndefine('KILL_SWITCH', true);\n","numLines":37,"startLine":1,"totalLines":37}},"sourceToolAssistantUUID":"6abaa33c-2164-411c-8684-57b60af48a62","userType":"external","entrypoint":"claude-vscode","cwd":"D:\\최신프로젝트\\인터파크\\백업\\260427","sessionId":"59c7642a-71bc-4ae8-a885-c0624014856b","version":"2.1.121","gitBranch":"HEAD"}
