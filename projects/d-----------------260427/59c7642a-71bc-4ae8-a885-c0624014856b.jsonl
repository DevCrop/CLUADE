r['request'],\n                'response' => $r['json'],\n            ], 'CORS preflight rejection by design'];\n        }\n\n        case 'cors_probe_peer': {\n            $r = peerCall('GET', '/api/cors-probe.php', []);\n            $verdict = $r['ok'] ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200],\n                'actual'   => ['status' => $r['status']],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'server-to-server probe (NOT brower); brower direct must be blocked — see UI direct cases'];\n        }\n\n        case 'list_peer': {\n            $verify = !empty($p['verify']);\n            $tail   = (int)($p['tail'] ?? 50);\n            $r = peerCall('GET', '/api/list.php?tail=' . $tail . ($verify ? '&verify=1' : ''), []);\n            $verdict = $r['ok'] ? '✅' : '❌';\n            return [[\n                'expected' => ['status' => 200],\n                'actual'   => ['status' => $r['status'], 'files' => count($r['json']['data']['files'] ?? [])],\n                'verdict'  => $verdict,\n                'request'  => $r['request'],\n                'response' => $r['json'],\n            ], 'peer ledger'];\n        }\n\n        case 'list_self': {\n            // 자기 list 를 직접 호출 (HMAC 안 거치고 in-process 로)\n            $entries = auditTail((int)($p['tail'] ?? 50));\n            $files = [];\n            $glob = glob(STORAGE_DIR . '/*') ?: [];\n            foreach ($glob as $f) {\n                if (!is_file($f)) continue;\n                $files[] = ['name' => basename($f), 'size' => filesize($f), 'mtime' => filemtime($f)];\n            }\n            return [[\n                'expected' => ['ok' => true],\n                'actual'   => ['files' => count($files), 'entries' => count($entries)],\n                'verdict'  => '✅',\n                'response' => ['files' => $files, 'entries' => array_slice($entries, -10)],\n            ], 'self ledger'];\n        }\n\n        case 'integrity': {\n            // 양쪽 list?verify=1 비교\n            $self = [];\n            $glob = glob(STORAGE_DIR . '/*') ?: [];\n            foreach ($glob as $f) {\n                if (!is_file($f)) continue;\n                $self[basename($f)] = sha256OfFile($f);\n            }\n            $r = peerCall('GET', '/api/list.php?verify=1&tail=1', []);\n            $peerFiles = $r['json']['data']['files'] ?? [];\n            $peer = [];\n            foreach ($peerFiles as $pf) {\n                if (isset($pf['name'], $pf['sha256'])) $peer[$pf['name']] = $pf['sha256'];\n            }\n            $names = array_unique(array_merge(array_keys($self), array_keys($peer)));\n            $rows = [];\n            $allMatch = true;\n            foreach ($names as $n) {\n                $a = $self[$n] ?? null;\n                $b = $peer[$n] ?? null;\n                $match = $a !== null && $b !== null && $a === $b;\n                if (!$match) $allMatch = false;\n                $rows[] = ['name' => $n, 'self' => $a, 'peer' => $b, 'match' => $match];\n            }\n            $verdict = $allMatch && count($rows) > 0 ? '✅' : (count($rows) === 0 ? '⚠' : '❌');\n            return [[\n                'expected' => ['all_match' => true],\n                'actual'   => ['files' => count($rows), 'all_match' => $allMatch, 'rows' => $rows],\n                'verdict'  => $verdict,\n                'response' => $r['json'],\n            ], 'sha256 cross-host integrity'];\n        }\n\n        case 'asset_token_issue': {\n            $name = (string)($p['name'] ?? '');\n            $base = safeBasename($name);\n            if ($base === null) {\n                return [['expected'=>['ok'=>true],'actual'=>['error'=>'bad_name'],'verdict'=>'❌'], 'bad name'];\n            }\n            $ttl = max(10, min(3600, (int)($p['ttl'] ?? 300)));\n            $tok = assetTokenIssue($base, $ttl);\n            // self URL과 peer URL 둘 다 만들어 UI