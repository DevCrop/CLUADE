tml(v);\n  try { return escapeHtml(JSON.stringify(v, null, 2)); } catch(e) { return String(v); }\n}\nfunction escapeHtml(s) { return String(s).replace(/[&<>\"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'})[c]); }\n\nasync function runOne(caseId, label, params = {}) {\n  const tableId = label.startsWith('A') ? 'tblA' : label.startsWith('B') ? 'tblB' : label.startsWith('C') ? 'tblC' : 'tblD';\n  try {\n    const r = await fetch(SELF_BASE + '/api/run.php', {\n      method: 'POST',\n      headers: {'Content-Type':'application/json', 'X-Admin-Token': getToken()},\n      body: JSON.stringify({case: caseId, params})\n    });\n    const j = await r.json();\n    if (!r.ok) {\n      appendRow(tableId, label, caseId, '200', `HTTP ${r.status} :: ${j.error||''}`, '❌', j.message||'');\n      return;\n    }\n    const d = j.data || {};\n    appendRow(tableId, label, caseId, d.expected, d.actual, d.verdict, (d.note||'') + ' (' + (d.timing_ms||0) + 'ms)');\n  } catch (e) {\n    appendRow(tableId, label, caseId, '?', String(e), '❌', 'fetch failed');\n  }\n}\n\nasync function runAll(group) {\n  if (group === 'A') {\n    await runOne('whoami_peer','A1');\n    await runOne('ping_peer','A2');","numLines":30,"startLine":140,"totalLines":376}},"sourceToolAssistantUUID":"8e5a29f8-fc4f-4967-9ebf-a1594c3292de","userType":"external","entrypoint":"claude-vscode","cwd":"d:\\최신프로젝트\\인터파크\\백업\\260427","sessionId":"59c7642a-71bc-4ae8-a885-c0624014856b","version":"2.1.121","gitBranch":"HEAD"}
