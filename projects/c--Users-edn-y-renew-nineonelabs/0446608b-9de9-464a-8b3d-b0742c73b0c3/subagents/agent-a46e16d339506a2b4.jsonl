dden=\"false\">\n434\t                <div class=\"no-container\">\n435\t                    <div id=\"main-portfolio-hook\" class=\"no-main-portfolio__gallery\">\n436\t                        <ul class=\"no-main-portfolio__list\">\n437\t                            <?php foreach ($homeWorks as $work): ?>\n438\t                            <?php\n439\t                            $workTitle = trim((string) ($work['title'] ?? ''));\n440\t                            $workClient = trim((string) ($work['client'] ?? ''));\n441\t                            $workLabel = $workTitle !== '' ? $workTitle : $workClient;\n442\t                            if ($workLabel === '') {\n443\t                                $workLabel = 'WORK';\n444\t                            }\n445\t\n446\t                            $workTags = is_array($work['tagLabels'] ?? null) ? $work['tagLabels'] : [];\n447\t                            if ($workTags === []) {\n448\t                                $fallbackCategory = trim((string) ($work['categoryLabel'] ?? ''));\n449\t                                if ($fallbackCategory !== '') {\n450\t                                    $workTags[] = $fallbackCategory;\n451\t                                }\n452\t                            }\n453\t                            ?>\n454\t                            <li class=\"no-main-portfolio__item\">\n455\t                                <a href=\"<?= e((string) ($work['detailPath'] ?? '/works')) ?>\">\n456\t                                    <div class=\"no-sub-gallery-item__img-wrap\">\n457\t                                        <?= include_view('components.button.corner-markup', ['class' => 'no-sub-gallery__corner']) ?>\n458\t                                        <div class=\"no-sub-gallery-item__img-inner\">\n459\t                                            <figure class=\"no-sub-gallery-item__img\">\n460\t                                                <img src=\"<?= e((string) ($work['thumbnailImage'